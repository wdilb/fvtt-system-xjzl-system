{
  "name": "xjzl-system-build",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "build": "node --experimental-vm-modules scripts/build-release.mjs",
