[
    {
        "name": "《绝壑功》",
        "type": "neigong",
        "img": "systems/xjzl-system/assets/icons/neigong/江湖1.png",
        "system": {
            "tier": 2,
            "element": "yang",
            "sect": "jianghushili",
            "description": "<p>从亡命掠杀中凝出的戾气相合之法，南疆群寇曾以此功对抗朝廷甲士，擅截杀搏命。内劲附掌可摧劲破脉，拍裂石崖，在流寇之间广为流传。</p><p><strong>属性：</strong>阳刚 <strong>悟性：</strong>5</p>",
            "requirement": "悟性5",
            "automationNote": "困难地形需手动处理。圆满特效的AOE流失气血已自动化：每次出招后自动检测周围1米内的敌人并造成流失伤害。",
            "config": {
                "stage1": {
                    "stats": {
                        "liliang": 14,
                        "shenfa": 8,
                        "tipo": 12,
                        "neixi": 8,
                        "qigan": 4,
                        "shencai": 2
                    },
                    "description": "",
                    "xpCostRatio": 1,
                    "scripts": []
                },
                "stage2": {
                    "stats": {
                        "liliang": 28,
                        "shenfa": 16,
                        "tipo": 24,
                        "neixi": 16,
                        "qigan": 8,
                        "shencai": 4
                    },
                    "description": "<p>小成运功特效：你每次出招后，周围 1 米范围内的地块碎裂变为“困难地形”，持续到战斗脱离。</p>",
                    "xpCostRatio": 1,
                    "scripts": []
                },
                "stage3": {
                    "stats": {
                        "liliang": 42,
                        "shenfa": 24,
                        "tipo": 36,
                        "neixi": 24,
                        "qigan": 10,
                        "shencai": 8
                    },
                    "description": "<p>修满[永久]：气血+40，内力+20，格挡值+5。<br>圆满运功特效：你每次出招后，周围 1 米范围内敌人流失 10 点气血且他们脚下地块碎裂变为“困难地形”，持续到战斗脱离。</p>",
                    "xpCostRatio": 1,
                    "scripts": [
                        {
                            "label": "绝壑震荡",
                            "trigger": "hit_once",
                            "script": "// 获取范围内的敌人 (1米约等于1格，给点容错设为1.5)\nconst range = 1.5;\nconst origin = actor.token?.object || actor.getActiveTokens()[0];\nif (!origin) return;\n\nconst targets = canvas.tokens.placeables.filter(t => {\n    if (t === origin) return false;\n    const dist = canvas.grid.measurePath([origin.center, t.center]).distance;\n    return dist <= range && t.document.disposition !== origin.document.disposition;\n});\n\nif (targets.length > 0) {\n    let logHtml = \"\";\n    for (const t of targets) {\n        const tActor = t.actor;\n        if (tActor) {\n            // 应用流失伤害\n            await tActor.applyDamage({ amount: 10, type: \"liushi\", attacker: actor });\n            logHtml += `<li><b>${t.name}</b>: 流失 10 气血</li>`;\n        }\n    }\n\n    // 发送汇总卡片\n    const content = `\n    <div class=\"xjzl-chat-card\">\n        <div class=\"card-content-wrapper\" style=\"padding-left: 5px;\">\n            <div style=\"font-weight:bold; color:#8b0000; margin-bottom:5px;\">\n                <i class=\"fas fa-mountain\"></i> 绝壑功 - 地裂\n            </div>\n            <div style=\"font-size:0.9em; color:#555;\">\n                周围地面碎裂，敌人受到波及：\n            </div>\n            <ul style=\"margin:5px 0; padding-left:20px; font-size:0.9em;\">\n                ${logHtml}\n            </ul>\n            <div style=\"font-size:0.85em; color:#999; margin-top:5px;\">\n                *请手动将相关区域标记为困难地形。\n            </div>\n        </div>\n    </div>`;\n\n    ChatMessage.create({\n        content: content,\n        speaker: ChatMessage.getSpeaker({actor: actor})\n    });\n}",
                            "active": true
                        }
                    ]
                }
            },
            "masteryEffect": "",
            "masteryChanges": [
                {
                    "key": "resources.hp.bonus",
                    "value": 40
                },
                {
                    "key": "resources.mp.bonus",
                    "value": 20
                },
                {
                    "key": "combat.block",
                    "value": 5
                }
            ],
            "xpInvested": 0,
            "active": false,
            "sourceBreakdown": {
                "general": 0,
                "specific": 0
            }
        },
        "effects": []
