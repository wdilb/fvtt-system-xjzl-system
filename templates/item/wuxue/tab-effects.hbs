<section class="tab xjzl-body xjzl-body-scroll {{#if (eq tabs.primary 'effects')}}active{{/if}}" data-tab="effects"
    data-group="primary" data-application-part="effects">

    <header class="martial-effect-heading">
        <div>
            <span class="panel-kicker">{{localize "XJZL.Wuxue.EffectPageKicker"}}</span>
            <h2>{{localize "XJZL.Wuxue.EffectPageTitle"}}</h2>
            <p>{{localize "XJZL.Wuxue.EffectPageHint"}}</p>
        </div>
        <button type="button" data-action="createEffect" class="xjzl-btn-seal">
            <i class="fas fa-plus"></i> {{localize "XJZL.UI.CreateEffect"}}
        </button>
    </header>

    {{#if effects.length}}
    <div class="effect-list">
        {{#each effects as |effect|}}
        <div class="xjzl-item-card {{#if effect.disabled}}disabled{{else}}enabled{{/if}}">
            <div class="status-bar"></div>
            <div class="info martial-effect-info">
                <img src="{{effect.img}}" width="36" height="36" class="icon"
                    style="border: 1px solid var(--c-ink-light); border-radius: 4px;">
                <div>
                    <h4>{{effect.name}}</h4>
                    <div class="tags">
                        {{#if effect.disabled}}<i class="fas fa-ban"></i> {{localize "XJZL.UI.StatusPaused"}}{{else}}<i
                            class="fas fa-check"></i>
                        {{localize "XJZL.UI.StatusActive"}}{{/if}}
                    </div>
                </div>
            </div>
            <div class="controls martial-effect-controls">
                <a data-action="toggleEffect" data-id="{{effect.id}}" class="control-btn"
                    aria-label="{{#if effect.disabled}}{{localize 'XJZL.UI.Enable'}}{{else}}{{localize 'XJZL.UI.Disable'}}{{/if}}"><i
                        class="fas {{#if effect.disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}"></i></a>
                <a data-action="editEffect" data-id="{{effect.id}}" class="control-btn"
                    aria-label="{{localize 'XJZL.UI.Edit'}}"><i class="fas fa-edit"></i></a>
                <a data-action="deleteEffect" data-id="{{effect.id}}" class="control-btn"
                    aria-label="{{localize 'XJZL.UI.Delete'}}"><i
                        class="fas fa-trash"></i></a>
            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <div class="empty-state">
        <div class="watermark">{{localize "XJZL.UI.WatermarkNone"}}</div>
        <p>{{localize "XJZL.Wuxue.NoEffects"}}</p>
        <span>{{localize "XJZL.UI.AddEffectHint"}}</span>
    </div>
    {{/if}}
</section>
