<header class="martial-sheet-head wuxue-sheet-head" data-application-part="header">
    <button type="button" class="martial-cover" data-action="editImage"
        data-tooltip="{{localize 'XJZL.UI.EditImage'}}">
        <img src="{{document.img}}" alt="">
        <span class="cover-edit"><i class="fas fa-camera" aria-hidden="true"></i></span>
    </button>

    <div class="martial-identity">
        <input type="text" name="name" value="{{document.name}}" class="martial-title"
            placeholder="{{localize 'XJZL.Wuxue.NamePlaceholder'}}">
        <div class="martial-meta-row">
            <label class="martial-compact-field"><span>{{localize "XJZL.Wuxue.Category"}}</span>
                <select name="system.category">{{selectOptions choices.categories selected=system.category}}</select></label>
            <label class="martial-compact-field"><span>{{localize "XJZL.Wuxue.Tier"}}</span>
                <select name="system.tier">{{selectOptions choices.tiers selected=system.tier}}</select></label>
            <label class="martial-compact-field"><span>{{localize "XJZL.Wuxue.Sect"}}</span>
                <select name="system.sect">{{selectOptions choices.sects selected=system.sect localize=true}}</select></label>
            {{#if isJianghuShiLi}}
            <label class="martial-compact-field"><span>{{localize "XJZL.Wuxue.SubSect"}}</span>
                <select name="system.subSect">{{selectOptions choices.subSects selected=system.subSect localize=true}}</select></label>
            {{/if}}
            <label class="martial-official-toggle">
                <input type="checkbox" name="system.isOfficial" {{checked system.isOfficial}}>
                <span>{{localize "XJZL.Item.IsOfficial"}}</span>
            </label>
        </div>
    </div>
</header>
