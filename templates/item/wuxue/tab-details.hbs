<section class="tab martial-workspace {{#if (eq tabs.primary 'details')}}active{{/if}}"
    data-tab="details" data-group="primary" data-application-part="details">
    <div class="wuxue-editor-layout">
        <aside class="wuxue-directory" aria-label="{{localize 'XJZL.Wuxue.MoveDirectory'}}">
            <div class="directory-heading">
                <div><span>{{localize "XJZL.Wuxue.MoveDirectory"}}</span><small>{{system.moves.length}}</small></div>
                <button type="button" data-action="addMove" aria-label="{{localize 'XJZL.Wuxue.Moves.AddMove'}}"><i class="fas fa-plus" aria-hidden="true"></i></button>
            </div>
            <label class="directory-search"><i class="fas fa-search" aria-hidden="true"></i>
                <input type="search" data-move-search value="{{moveSearchQuery}}" placeholder="{{localize 'XJZL.Wuxue.MoveSearchPlaceholder'}}"></label>
            <div class="directory-list">
                <button type="button" class="directory-entry book-entry {{#if bookOverviewSelected}}is-selected{{/if}}"
                    data-action="selectMove" data-move-id="__book__" aria-pressed="{{bookOverviewSelected}}">
                    <span class="entry-icon"><i class="fas fa-book-open" aria-hidden="true"></i></span>
                    <span><strong>{{localize "XJZL.Wuxue.BookOverview"}}</strong><small>{{localize "XJZL.Wuxue.BookOverviewHint"}}</small></span>
                </button>
                {{#each system.moves as |move i|}}
                <button type="button" class="directory-entry wuxue-move-entry {{move._uiClass}} {{#if move.isUltimate}}is-ultimate{{/if}} {{#if move._uiSelected}}is-selected{{/if}}"
                    data-action="selectMove" data-move-id="{{move.id}}" aria-pressed="{{move._uiSelected}}">
                    <span class="entry-icon {{move._uiClass}}"><i class="fas {{move._uiIcon}}" aria-hidden="true"></i></span>
                    <span class="move-entry-copy"><strong>{{move.name}}</strong><small>{{lookup @root.choices.moveTypes move.type}}{{#if move.isUltimate}} <em class="ultimate-badge">{{localize "XJZL.Wuxue.Moves.UltimateBadge"}}</em>{{/if}}</small></span>
                    <span class="entry-tier">{{#if move._uiTier}}{{move._uiTier}}{{else}}·{{/if}}</span>
                </button>
                {{else}}
                <p class="directory-empty">{{localize "XJZL.Wuxue.EmptyMovesHint"}}</p>
                {{/each}}
            </div>
        </aside>

        <main class="wuxue-editor-main">
            <section class="wuxue-book-panel {{#if bookOverviewSelected}}is-selected{{else}}is-collapsed{{/if}}" data-move-id="__book__">
                <header class="panel-heading"><div><span class="panel-kicker">{{localize "XJZL.Wuxue.BookKicker"}}</span><h2>{{localize "XJZL.Wuxue.BookOverview"}}</h2></div>
                    <div class="panel-heading-side"><p>{{localize "XJZL.Wuxue.BookDescription"}}</p>
                        <small class="panel-save-hint"><i class="fas fa-circle-info" aria-hidden="true"></i>{{localize "XJZL.UI.RichTextSaveHint"}}</small></div></header>
                <div class="book-overview-grid">
                    <div class="field-block book-requirements"><span><i class="fas fa-circle-exclamation" aria-hidden="true"></i> {{localize "XJZL.Wuxue.Requirements"}}</span>
                        <div class="martial-rich-editor">
                            <div class="martial-rich-preview">{{{enrichedRequirements}}}</div>
                            <prose-mirror name="system.requirements" data-document-u-u-i-d="{{document.uuid}}"
                                value="{{system.requirements}}" toggled="false" button="true"></prose-mirror>
                        </div>
                    </div>
                    <div class="field-block book-description"><span>{{localize "XJZL.Info.Description"}}</span>
                        <div class="martial-rich-editor"><div class="martial-rich-preview">{{{enrichedDescription}}}</div><prose-mirror name="system.description" data-document-u-u-i-d="{{document.uuid}}"
                            value="{{system.description}}" toggled="false" button="true"></prose-mirror></div></div>
                </div>
            </section>

            <nav class="move-section-tabs {{#if bookOverviewSelected}}is-hidden{{/if}}" aria-label="{{localize 'XJZL.Wuxue.MoveEditorSections'}}">
                <button type="button" class="{{#if (eq selectedMoveSection 'overview')}}is-selected{{/if}}" data-action="selectMoveSection" data-section="overview"><i class="fas fa-feather" aria-hidden="true"></i>{{localize "XJZL.Wuxue.MoveOverview"}}</button>
                <button type="button" class="{{#if (eq selectedMoveSection 'growth')}}is-selected{{/if}}" data-action="selectMoveSection" data-section="growth"><i class="fas fa-chart-line" aria-hidden="true"></i>{{localize "XJZL.Wuxue.MoveGrowth"}}</button>
                <button type="button" class="{{#if (eq selectedMoveSection 'automation')}}is-selected{{/if}}" data-action="selectMoveSection" data-section="automation"><i class="fas fa-code" aria-hidden="true"></i>{{localize "XJZL.Wuxue.MoveAutomation"}}</button>
            </nav>

            <div class="wuxue-move-stack {{#if bookOverviewSelected}}is-hidden{{/if}}">
                {{#each system.moves as |move i|}}
                <article class="move-editor-card {{move._uiClass}} {{#if move.isUltimate}}is-ultimate{{/if}} {{#if move._uiSelected}}is-selected{{else}}is-collapsed{{/if}}"
                    data-move-index="{{i}}" data-move-id="{{move.id}}">
                    <input type="hidden" name="system.moves.{{i}}.id" value="{{move.id}}">
                    <input type="hidden" name="system.moves.{{i}}.xpInvested" value="{{move.xpInvested}}">
                    <input type="hidden" name="system.moves.{{i}}.level" value="{{move.level}}">
                    <input type="hidden" name="system.moves.{{i}}.sourceBreakdown.general" value="{{move.sourceBreakdown.general}}">
                    <input type="hidden" name="system.moves.{{i}}.sourceBreakdown.specific" value="{{move.sourceBreakdown.specific}}">
                    <input type="hidden" name="system.moves.{{i}}.img" value="{{move.img}}">

                    <header class="move-editor-head">
                        <span class="move-icon-button {{move._uiClass}}" aria-hidden="true"><i class="fas {{move._uiIcon}}"></i></span>
                        <div class="move-title-group">
                            <input type="text" name="system.moves.{{i}}.name" value="{{move.name}}" class="move-title-input" placeholder="{{localize 'XJZL.Wuxue.Moves.Name'}}">
                            <div class="move-title-meta">
                                <select name="system.moves.{{i}}.type">{{selectOptions @root.choices.moveTypes selected=move.type}}</select>
                                {{#if (eq move.type "qi")}}<select name="system.moves.{{i}}.actionType">{{selectOptions @root.choices.actionTypes selected=move.actionType}}</select>{{/if}}
                                <label class="ultimate-toggle"><input type="checkbox" name="system.moves.{{i}}.isUltimate" {{checked move.isUltimate}}><span>{{localize "XJZL.Wuxue.Moves.IsUltimate"}}</span></label>
                            </div>
                        </div>
                        <button type="button" class="icon-button danger delete-move" data-action="deleteMove" data-id="{{move.id}}" aria-label="{{localize 'XJZL.UI.Delete'}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
                    </header>

                    <section class="move-section-panel {{#if (eq move._uiSection 'overview')}}is-selected{{else}}is-collapsed{{/if}}" data-move-section-panel="overview">
                        <div class="move-field-grid">
                            <label class="compact-field"><span>{{localize "XJZL.Wuxue.Moves.WeaponType"}}</span><select name="system.moves.{{i}}.weaponType">{{selectOptions @root.choices.weaponTypes selected=move.weaponType}}</select></label>
                            <label class="compact-field"><span>{{localize "XJZL.Wuxue.Moves.WeaponSubtypeLabel"}}</span><input type="text" name="system.moves.{{i}}.weaponSubtype" value="{{move.weaponSubtype}}" placeholder="{{localize 'XJZL.Wuxue.Moves.SubtypePlaceholder'}}"></label>
                            <label class="compact-field"><span>{{localize "XJZL.Wuxue.Moves.TargetInfo"}}</span><input type="text" name="system.moves.{{i}}.targetInfo" value="{{move.targetInfo}}" placeholder="{{localize 'XJZL.Wuxue.Moves.TargetInfoPlaceholder'}}"></label>
                            <label class="compact-field"><span>{{localize "XJZL.Wuxue.Moves.DamageType"}}</span><select name="system.moves.{{i}}.damageType">{{selectOptions @root.choices.damageTypes selected=move.damageType}}</select></label>
                            <label class="compact-field"><span>{{localize "XJZL.Wuxue.Moves.ElementLabel"}}</span><select name="system.moves.{{i}}.element">{{selectOptions @root.choices.elements selected=move.element}}</select></label>
                            <label class="compact-field"><span>{{localize "XJZL.Wuxue.Tier"}}</span><select name="system.moves.{{i}}.tier">{{selectOptions @root.choices.moveTiers selected=move.uiTierSelected}}</select></label>
                            <label class="compact-field"><span>{{localize "XJZL.Wuxue.Moves.Range"}}</span><input type="text" name="system.moves.{{i}}.range" value="{{move.range}}"></label>
                            <label class="compact-field"><span>{{localize "XJZL.Wuxue.Moves.ActionCost"}}</span><input type="text" name="system.moves.{{i}}.actionCost" value="{{move.actionCost}}"></label>
                        </div>
                        {{#if (eq move.type "feint")}}
                        <div class="double-feint-row">
                            <div class="double-feint-copy"><label><input type="checkbox" name="system.moves.{{i}}.doubleFeint" {{checked move.doubleFeint}}> <strong>{{localize "XJZL.Wuxue.Moves.DoubleFeint"}}</strong></label>
                                <small>{{localize "XJZL.Wuxue.Moves.DoubleFeintHint"}}</small></div>
                            {{#if move.doubleFeint}}<label class="double-feint-mode"><span>{{localize "XJZL.Wuxue.Moves.DoubleFeintMode"}}</span><select name="system.moves.{{i}}.doubleFeintMode">{{selectOptions @root.choices.doubleFeintModes selected=move.doubleFeintMode}}</select></label>{{/if}}
                        </div>
                        {{/if}}
                        <div class="field-block move-requirements"><span><i class="fas fa-circle-exclamation" aria-hidden="true"></i> {{localize "XJZL.Wuxue.Moves.Requirements"}}</span><div class="martial-rich-editor"><div class="martial-rich-preview">{{{move.enrichedRequirements}}}</div><prose-mirror name="system.moves.{{i}}.requirements" data-document-u-u-i-d="{{../document.uuid}}" value="{{move.requirements}}" toggled="false" button="true"></prose-mirror></div></div>
                        <div class="field-block move-description"><span>{{localize "XJZL.Info.Description"}}</span><div class="martial-rich-editor"><div class="martial-rich-preview">{{{move.enrichedDescription}}}</div><prose-mirror name="system.moves.{{i}}.description" data-document-u-u-i-d="{{../document.uuid}}" value="{{move.description}}" toggled="false" button="true"></prose-mirror></div></div>
                    </section>

                    <section class="move-section-panel {{#if (eq move._uiSection 'growth')}}is-selected{{else}}is-collapsed{{/if}}" data-move-section-panel="growth">
                        <div class="growth-rule-strip">
                            <label class="training-ratio-card">
                                <span class="growth-rule-mark" aria-hidden="true">修</span>
                                <span class="growth-rule-copy"><strong>{{localize "XJZL.Wuxue.Moves.XPCostRatio"}}</strong><small>{{localize "XJZL.Wuxue.Moves.XPCostRatioHint"}}</small></span>
                                <span class="ratio-input-wrap"><input type="number" name="system.moves.{{i}}.xpCostRatio" value="{{move.xpCostRatio}}" min="0.1" step="0.01"><em>{{localize "XJZL.ArtBook.RatioStandardHint"}}</em></span>
                            </label>
                            <section class="progression-card">
                                <header><strong>{{localize "XJZL.Wuxue.Progression.Title"}}</strong><small>{{localize "XJZL.Wuxue.Progression.Hint"}}</small></header>
                                <div class="progression-control-grid">
                                    <label><span>{{localize "XJZL.Wuxue.Progression.Mode"}}</span><select name="system.moves.{{i}}.progression.mode">{{selectOptions @root.choices.progressionModes selected=move.progression.mode}}</select><small class="control-hint">{{localize "XJZL.Wuxue.Progression.ModeHint"}}</small></label>
                                    <label><span>{{localize "XJZL.Wuxue.Progression.MappedStage"}}</span><select name="system.moves.{{i}}.progression.mappedStage">{{selectOptions @root.choices.mappedStages selected=move.progression.mappedStage}}</select><small class="control-hint">{{localize "XJZL.Wuxue.Progression.MappedStageHint"}}</small></label>
                                </div>
                                {{#if (eq move.progression.mode "custom")}}
                                <label class="threshold-field"><span>{{localize "XJZL.Wuxue.Progression.Thresholds"}}</span><input type="text" name="temp.thresholds.{{i}}" value="{{move.progression.customThresholds}}" placeholder="1000, 3000"><small>{{localize "XJZL.Wuxue.Progression.ThresholdsHint"}}</small></label>
                                {{/if}}
                            </section>
                        </div>
                        <div class="growth-workbench">
                            <section class="growth-section cost-section">
                                <header><div><span class="panel-kicker">01 · COST</span><h3>{{localize "XJZL.Wuxue.Cost.Label"}}</h3><small>{{localize "XJZL.Wuxue.Cost.Hint"}}</small></div></header>
                                <div class="cost-table" style="grid-template-columns: 62px repeat({{move._ui.costLevels.length}}, minmax(46px, 1fr));">
                                    <span></span>{{#each move._ui.costLabels as |label|}}<strong>{{label}}</strong>{{/each}}
                                    <strong>{{localize "XJZL.Wuxue.Cost.MP"}}</strong>{{#each move._ui.costLevels as |lvlIdx|}}<input type="number" name="system.moves.{{i}}.costs.mp.{{lvlIdx}}" value="{{lookup move.costs.mp lvlIdx}}">{{/each}}
                                    <strong>{{localize "XJZL.Wuxue.Cost.Rage"}}</strong>{{#each move._ui.costLevels as |lvlIdx|}}<input type="number" name="system.moves.{{i}}.costs.rage.{{lvlIdx}}" value="{{lookup move.costs.rage lvlIdx}}">{{/each}}
                                    <strong>{{localize "XJZL.Wuxue.Cost.HP"}}</strong>{{#each move._ui.costLevels as |lvlIdx|}}<input type="number" name="system.moves.{{i}}.costs.hp.{{lvlIdx}}" value="{{lookup move.costs.hp lvlIdx}}">{{/each}}
                                </div>
                            </section>
                            <section class="growth-section scaling-section">
                                <header><div><span class="panel-kicker">02 · FORMULA</span><h3>{{localize "XJZL.Wuxue.Calc.Label"}}</h3><small>{{localize "XJZL.Wuxue.Calc.FormulaHint"}}</small></div><button type="button" data-action="addScaling"><i class="fas fa-plus" aria-hidden="true"></i>{{localize "XJZL.UI.Add"}}</button></header>
                                <div class="calculation-layout">
                                    <div class="calculation-base-row">
                                        <label><span>{{localize "XJZL.Wuxue.Calc.Base"}}</span><input type="number" name="system.moves.{{i}}.calculation.base" value="{{move.calculation.base}}"></label>
                                        <label><span>{{localize "XJZL.Wuxue.Calc.Growth"}}</span><input type="number" name="system.moves.{{i}}.calculation.growth" value="{{move.calculation.growth}}"></label>
                                        <label class="fixed-mode-card"><span class="fixed-mode-toggle"><input type="checkbox" name="system.moves.{{i}}.calculation.isFixed" {{checked move.calculation.isFixed}}> <strong>{{localize "XJZL.Wuxue.Calc.IsFixed"}}</strong></span><small>{{localize "XJZL.Wuxue.Calc.IsFixedDesc"}}</small></label>
                                    </div>
                                    <div class="scaling-list">
                                        {{#each move.calculation.scalings as |scale idx|}}
                                        <div class="scaling-row"><label><span>{{localize "XJZL.Wuxue.Calc.Prop"}}</span><select name="system.moves.{{i}}.calculation.scalings.{{idx}}.prop">{{selectOptions @root.choices.attributes selected=scale.prop}}</select></label><span class="scaling-operator">×</span><label><span>{{localize "XJZL.Wuxue.Calc.Ratio"}}</span><input type="number" name="system.moves.{{i}}.calculation.scalings.{{idx}}.ratio" value="{{scale.ratio}}" step="0.1"></label><button type="button" class="icon-button danger" data-action="deleteScaling" data-idx="{{idx}}" aria-label="{{localize 'XJZL.UI.Delete'}}"><i class="fas fa-times" aria-hidden="true"></i></button></div>
                                        {{else}}<p class="scaling-empty">{{localize "XJZL.Wuxue.Calc.EmptyHint"}}</p>{{/each}}
                                    </div>
                                </div>
                            </section>
                        </div>
                    </section>

                    <section class="move-section-panel {{#if (eq move._uiSection 'automation')}}is-selected{{else}}is-collapsed{{/if}}" data-move-section-panel="automation">
                        <div class="automation-workbench">
                            <section class="automation-brief">
                                <header><span class="panel-kicker">{{localize "XJZL.Wuxue.AutomationWorkspaceKicker"}}</span><h3>{{localize "XJZL.Wuxue.AutomationWorkspaceTitle"}}</h3><p>{{localize "XJZL.Wuxue.AutomationWorkspaceHint"}}</p></header>
                                <div class="automation-flow" aria-hidden="true"><span>{{localize "XJZL.Wuxue.AutomationFlowTrigger"}}</span><b>→</b><span>{{localize "XJZL.Wuxue.AutomationFlowScript"}}</span><b>→</b><span>{{localize "XJZL.Wuxue.AutomationFlowResult"}}</span></div>
                                <label class="field-block automation-note"><span>{{localize "XJZL.AutomationNote"}}</span><textarea name="system.moves.{{i}}.automationNote" rows="6" placeholder="{{localize 'XJZL.Wuxue.AutomationNotePlaceholder'}}">{{move.automationNote}}</textarea></label>
                            </section>
                            <section class="automation-scripts"><header><div><span class="panel-kicker">{{localize "XJZL.Wuxue.AutomationKicker"}}</span><h3>{{localize "XJZL.Script.ScriptList"}}</h3><small>{{localize "XJZL.Wuxue.AutomationScriptsHint"}}</small></div><button type="button" data-action="addMoveScript"><i class="fas fa-plus" aria-hidden="true"></i>{{localize "XJZL.Wuxue.Moves.ScriptAdd"}}</button></header>
                                <div class="script-list">
                                    {{#each move.scripts as |script sIdx|}}
                                    <details class="script-card" data-script-key="{{move.id}}:{{sIdx}}" {{#if (lookup move._uiOpenScripts sIdx)}}open{{/if}}><summary><i class="fas fa-code" aria-hidden="true"></i><strong>{{#if script.label}}{{script.label}}{{else}}{{localize "XJZL.Script.NamePlaceholder"}}{{/if}}</strong><span>{{lookup @root.scriptTriggerChoices script.trigger}}</span><span class="script-state {{#if script.active}}is-active{{/if}}">{{#if script.active}}{{localize "XJZL.UI.Enable"}}{{else}}{{localize "XJZL.UI.StatusDisabled"}}{{/if}}</span></summary><div class="script-card-body"><div class="script-meta-row"><input type="text" name="system.moves.{{i}}.scripts.{{sIdx}}.label" value="{{script.label}}"><select name="system.moves.{{i}}.scripts.{{sIdx}}.trigger">{{selectOptions @root.scriptTriggerChoices selected=script.trigger localize=false}}</select><label class="inline-check"><input type="checkbox" name="system.moves.{{i}}.scripts.{{sIdx}}.active" {{checked script.active}}> {{localize "XJZL.UI.Enable"}}</label><button type="button" class="icon-button danger" data-action="deleteMoveScript" data-idx="{{sIdx}}"><i class="fas fa-trash" aria-hidden="true"></i></button></div><textarea name="system.moves.{{i}}.scripts.{{sIdx}}.script" class="script-code">{{script.script}}</textarea></div></details>
                                    {{else}}<div class="automation-empty"><strong>{{localize "XJZL.Wuxue.Moves.NoScript"}}</strong><span>{{localize "XJZL.Wuxue.Moves.NoScriptHint"}}</span></div>{{/each}}
                                </div>
                            </section>
                        </div>
                    </section>
                </article>
                {{/each}}
            </div>
        </main>
    </div>
</section>
