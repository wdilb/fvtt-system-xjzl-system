<nav class="martial-sheet-tabs tabs" data-application-part="tabs"
    aria-label="{{localize 'XJZL.Wuxue.TabNavigation'}}">
    <button type="button" class="tab-button {{#if (eq tabs.primary 'details')}}active{{/if}}"
        data-action="tab" data-group="primary" data-tab="details">
        <i class="fas fa-scroll" aria-hidden="true"></i><span>{{localize "XJZL.Wuxue.TabMoves"}}</span>
    </button>
    <button type="button" class="tab-button {{#if (eq tabs.primary 'effects')}}active{{/if}}"
        data-action="tab" data-group="primary" data-tab="effects">
        <i class="fas fa-sliders" aria-hidden="true"></i><span>{{localize "XJZL.Wuxue.TabEffectsShort"}}</span>
    </button>
</nav>
