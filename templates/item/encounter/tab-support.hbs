<section class="tab encounter-page {{#if (eq tabs.primary 'support')}}active{{/if}}" data-tab="support" data-group="primary" data-application-part="support">
  <div class="encounter-toolbar">
    <div>
      <span>{{localize "XJZL.Encounter.Reinforcements"}}</span>
      <h2>{{localize "XJZL.Encounter.SupportGroups"}}</h2>
      <p>{{localize "XJZL.Encounter.SupportGroupsHint"}}</p>
    </div>
    <button type="button" class="encounter-primary-action" data-action="addGroup"><i class="fas fa-plus"></i>{{localize "XJZL.Encounter.AddSupportGroup"}}</button>
  </div>

  <div class="support-group-stack">
    {{#each system.support.groups as |group|}}
    <article class="support-group-card {{#unless group.enabled}}is-disabled{{/unless}} {{#if group.collapsed}}is-collapsed{{/if}}" data-collapse-entry>
      <header class="support-group-command">
        <span class="encounter-order">{{group.displayOrder}}</span>
        <div><span>{{localize "XJZL.Encounter.SupportGroup"}}</span><h3>{{group.displayName}}</h3></div>
        <label class="encounter-switch"><input type="checkbox" name="system.support.groups.{{group.groupIndex}}.enabled" {{checked group.enabled}}><span>{{localize "XJZL.Encounter.Enabled"}}</span></label>
        <div class="entry-actions">
          <button type="button" class="entry-collapse-toggle" data-action="toggleEntry" data-collapse-key="{{group.collapseKey}}" aria-expanded="{{#if group.collapsed}}false{{else}}true{{/if}}" title="{{#if group.collapsed}}{{localize 'XJZL.Encounter.ExpandEntry'}}{{else}}{{localize 'XJZL.Encounter.CollapseEntry'}}{{/if}}"><i class="fas {{#if group.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i></button>
          <button type="button" data-action="moveGroup" data-group-index="{{group.groupIndex}}" data-direction="-1" title="{{localize 'XJZL.Encounter.MoveUp'}}"><i class="fas fa-chevron-up"></i></button>
          <button type="button" data-action="moveGroup" data-group-index="{{group.groupIndex}}" data-direction="1" title="{{localize 'XJZL.Encounter.MoveDown'}}"><i class="fas fa-chevron-down"></i></button>
          <button type="button" data-action="copyGroup" data-group-index="{{group.groupIndex}}" title="{{localize 'XJZL.Encounter.Copy'}}"><i class="fas fa-copy"></i></button>
          <button type="button" class="danger" data-action="deleteGroup" data-group-index="{{group.groupIndex}}" title="{{localize 'XJZL.UI.Delete'}}"><i class="fas fa-trash"></i></button>
        </div>
      </header>

      <div class="encounter-collapse-body" data-collapse-body {{#if group.collapsed}}hidden{{/if}}>
      <input type="hidden" name="system.support.groups.{{group.groupIndex}}.id" value="{{group.id}}">
      <section class="support-policy">
        <div class="policy-heading"><i class="fas fa-diagram-project"></i><div><b>{{localize "XJZL.Encounter.GroupProtocol"}}</b><small>{{localize "XJZL.Encounter.GroupProtocolHint"}}</small></div></div>
        <div class="group-identity-grid">
          <label class="encounter-field"><span>{{localize "XJZL.Encounter.GroupName"}}</span><input type="text" name="system.support.groups.{{group.groupIndex}}.name" value="{{group.name}}" placeholder="{{group.displayName}}"><small>{{localize "XJZL.Encounter.GroupNameHint"}}</small></label>
          <label class="encounter-field"><span>{{localize "XJZL.Encounter.GroupDescription"}}</span><input type="text" name="system.support.groups.{{group.groupIndex}}.description" value="{{group.description}}"><small>{{localize "XJZL.Encounter.GroupDescriptionHint"}}</small></label>
        </div>
        <div class="encounter-grid four">
          <label class="encounter-field"><span>{{localize "XJZL.Encounter.Permission"}}</span><select name="system.support.groups.{{group.groupIndex}}.permission">{{selectOptions @root.choices.supportPermissions selected=group.permission}}</select><small>{{localize "XJZL.Encounter.GroupPermissionHint"}}</small></label>
          <label class="encounter-field"><span>{{localize "XJZL.Encounter.EncounterLimit"}}</span><input type="number" min="0" step="1" name="system.support.groups.{{group.groupIndex}}.encounterLimit" value="{{group.encounterLimit}}"><small>{{localize "XJZL.Encounter.GroupEncounterLimitHint"}}</small></label>
          <label class="encounter-field"><span>{{localize "XJZL.Encounter.RoundLimit"}}</span><input type="number" min="0" step="1" name="system.support.groups.{{group.groupIndex}}.roundLimit" value="{{group.roundLimit}}"><small>{{localize "XJZL.Encounter.GroupRoundLimitHint"}}</small></label>
          <label class="encounter-check"><input type="checkbox" name="system.support.groups.{{group.groupIndex}}.oncePerNpcPerRound" {{checked group.oncePerNpcPerRound}}><span><b>{{localize "XJZL.Encounter.OncePerNpcPerRound"}}</b><small>{{localize "XJZL.Encounter.OncePerNpcHint"}}</small></span></label>
        </div>
      </section>

      <div class="group-roster-heading">
        <div><span>{{localize "XJZL.Encounter.GroupRoster"}}</span><b>{{localize "XJZL.Encounter.SupportNpcs"}} · {{group.npcs.length}}</b></div>
        <button type="button" data-action="addNpc" data-group-index="{{group.groupIndex}}"><i class="fas fa-plus"></i>{{localize "XJZL.Encounter.AddNpc"}}</button>
      </div>

      <div class="encounter-stack group-npc-stack">
        {{#each group.npcs as |npc|}}
        <article class="encounter-entry support-npc {{#unless npc.enabled}}is-disabled{{/unless}} {{#if npc.collapsed}}is-collapsed{{/if}}" data-collapse-entry>
          <header class="entry-command npc-command">
            {{#if npc.actorImg}}<img src="{{npc.actorImg}}" alt="">{{else}}<span class="npc-sigil" aria-hidden="true"><i class="fas fa-user"></i></span>{{/if}}
            <div class="npc-heading"><span>{{#if npc.actorName}}{{localize "XJZL.Encounter.LinkedActor"}}{{else}}{{localize "XJZL.Encounter.UnlinkedActor"}}{{/if}}</span><strong>{{#if npc.actorName}}{{npc.actorName}}{{else}}{{npc.manualName}}{{/if}}</strong>{{#if npc.actorMissing}}<small class="warning"><i class="fas fa-triangle-exclamation"></i>{{localize "XJZL.Encounter.ActorMissing"}}</small>{{/if}}</div>
            <label class="encounter-switch"><input type="checkbox" name="system.support.groups.{{group.groupIndex}}.npcs.{{npc.npcIndex}}.enabled" {{checked npc.enabled}}><span>{{localize "XJZL.Encounter.Enabled"}}</span></label>
            <div class="entry-actions">
              <button type="button" class="entry-collapse-toggle" data-action="toggleEntry" data-collapse-key="{{npc.collapseKey}}" aria-expanded="{{#if npc.collapsed}}false{{else}}true{{/if}}" title="{{#if npc.collapsed}}{{localize 'XJZL.Encounter.ExpandEntry'}}{{else}}{{localize 'XJZL.Encounter.CollapseEntry'}}{{/if}}"><i class="fas {{#if npc.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i></button>
              <button type="button" data-action="moveNpc" data-group-index="{{group.groupIndex}}" data-npc-index="{{npc.npcIndex}}" data-direction="-1" title="{{localize 'XJZL.Encounter.MoveUp'}}"><i class="fas fa-chevron-up"></i></button>
              <button type="button" data-action="moveNpc" data-group-index="{{group.groupIndex}}" data-npc-index="{{npc.npcIndex}}" data-direction="1" title="{{localize 'XJZL.Encounter.MoveDown'}}"><i class="fas fa-chevron-down"></i></button>
              <button type="button" data-action="copyNpc" data-group-index="{{group.groupIndex}}" data-npc-index="{{npc.npcIndex}}" title="{{localize 'XJZL.Encounter.Copy'}}"><i class="fas fa-copy"></i></button>
              <button type="button" class="danger" data-action="deleteNpc" data-group-index="{{group.groupIndex}}" data-npc-index="{{npc.npcIndex}}" title="{{localize 'XJZL.UI.Delete'}}"><i class="fas fa-trash"></i></button>
            </div>
          </header>

          <div class="encounter-collapse-body" data-collapse-body {{#if npc.collapsed}}hidden{{/if}}>
          <input type="hidden" name="system.support.groups.{{group.groupIndex}}.npcs.{{npc.npcIndex}}.id" value="{{npc.id}}">
          <input type="hidden" name="system.support.groups.{{group.groupIndex}}.npcs.{{npc.npcIndex}}.sourceActorUuid" value="{{npc.sourceActorUuid}}">
          <div class="npc-identity-grid">
            <section class="identity-link"><span class="section-eyebrow">{{localize "XJZL.Encounter.ActorIdentity"}}</span><div class="npc-controls"><button type="button" data-action="chooseActor" data-group-index="{{group.groupIndex}}" data-npc-index="{{npc.npcIndex}}"><i class="fas fa-link"></i>{{localize "XJZL.Encounter.ChooseActor"}}</button>{{#if npc.sourceActorUuid}}<button type="button" data-action="clearActor" data-group-index="{{group.groupIndex}}" data-npc-index="{{npc.npcIndex}}"><i class="fas fa-link-slash"></i>{{localize "XJZL.Encounter.ClearActor"}}</button>{{/if}}</div><small>{{localize "XJZL.Encounter.ActorLinkHint"}}</small></section>
            <label class="encounter-field"><span>{{localize "XJZL.Encounter.ManualNameFallback"}}</span><input type="text" name="system.support.groups.{{group.groupIndex}}.npcs.{{npc.npcIndex}}.manualName" value="{{npc.manualName}}" placeholder="{{localize 'XJZL.Encounter.ManualName'}}"><small>{{localize "XJZL.Encounter.ManualNameHint"}}</small></label>
            <label class="encounter-field"><span>{{localize "XJZL.Encounter.NpcLimit"}}</span><input type="number" min="0" step="1" name="system.support.groups.{{group.groupIndex}}.npcs.{{npc.npcIndex}}.encounterLimit" value="{{npc.encounterLimit}}"><small>{{localize "XJZL.Encounter.NpcLimitHint"}}</small></label>
          </div>
          <label class="encounter-field encounter-description"><span>{{localize "XJZL.Encounter.Description"}}</span><textarea name="system.support.groups.{{group.groupIndex}}.npcs.{{npc.npcIndex}}.description">{{npc.description}}</textarea><small>{{localize "XJZL.Encounter.NpcDescriptionHint"}}</small></label>

          <div class="action-heading"><div><span>{{localize "XJZL.Encounter.ActionProtocol"}}</span><b>{{localize "XJZL.Encounter.SupportActions"}}</b></div><button type="button" data-action="addAction" data-group-index="{{group.groupIndex}}" data-npc-index="{{npc.npcIndex}}"><i class="fas fa-plus"></i>{{localize "XJZL.Encounter.AddAction"}}</button></div>
          <div class="support-action-stack">
            {{#each npc.actions as |action|}}
            <section class="support-action {{#unless action.enabled}}is-disabled{{/unless}} {{#if action.collapsed}}is-collapsed{{/if}}" data-encounter-entry data-collapse-entry>
              <div class="action-title">
                <span class="action-order">{{action.displayOrder}}</span>
                <input type="hidden" name="system.support.groups.{{group.groupIndex}}.npcs.{{npc.npcIndex}}.actions.{{action.actionIndex}}.id" value="{{action.id}}">
                <input type="text" name="system.support.groups.{{group.groupIndex}}.npcs.{{npc.npcIndex}}.actions.{{action.actionIndex}}.name" value="{{action.name}}" aria-label="{{localize 'XJZL.Encounter.Name'}}">
                <label class="encounter-switch"><input type="checkbox" name="system.support.groups.{{group.groupIndex}}.npcs.{{npc.npcIndex}}.actions.{{action.actionIndex}}.enabled" {{checked action.enabled}}><span>{{localize "XJZL.Encounter.Enabled"}}</span></label>
                <div class="entry-actions">
                  <button type="button" class="entry-collapse-toggle" data-action="toggleEntry" data-collapse-key="{{action.collapseKey}}" aria-expanded="{{#if action.collapsed}}false{{else}}true{{/if}}" title="{{#if action.collapsed}}{{localize 'XJZL.Encounter.ExpandEntry'}}{{else}}{{localize 'XJZL.Encounter.CollapseEntry'}}{{/if}}"><i class="fas {{#if action.collapsed}}fa-chevron-right{{else}}fa-chevron-down{{/if}}"></i></button>
                  <button type="button" data-action="moveAction" data-group-index="{{group.groupIndex}}" data-npc-index="{{npc.npcIndex}}" data-action-index="{{action.actionIndex}}" data-direction="-1" title="{{localize 'XJZL.Encounter.MoveUp'}}"><i class="fas fa-chevron-up"></i></button>
                  <button type="button" data-action="moveAction" data-group-index="{{group.groupIndex}}" data-npc-index="{{npc.npcIndex}}" data-action-index="{{action.actionIndex}}" data-direction="1" title="{{localize 'XJZL.Encounter.MoveDown'}}"><i class="fas fa-chevron-down"></i></button>
                  <button type="button" data-action="copyAction" data-group-index="{{group.groupIndex}}" data-npc-index="{{npc.npcIndex}}" data-action-index="{{action.actionIndex}}" title="{{localize 'XJZL.Encounter.Copy'}}"><i class="fas fa-copy"></i></button>
                  <button type="button" class="danger" data-action="deleteAction" data-group-index="{{group.groupIndex}}" data-npc-index="{{npc.npcIndex}}" data-action-index="{{action.actionIndex}}" title="{{localize 'XJZL.UI.Delete'}}"><i class="fas fa-trash"></i></button>
                </div>
              </div>
              <div class="encounter-collapse-body" data-collapse-body {{#if action.collapsed}}hidden{{/if}}>
              <div class="action-rule-grid">
                <label class="encounter-field"><span>{{localize "XJZL.Encounter.TargetMode"}}</span><select data-target-control name="system.support.groups.{{group.groupIndex}}.npcs.{{npc.npcIndex}}.actions.{{action.actionIndex}}.targetMode">{{selectOptions @root.choices.actionTargets selected=action.targetMode}}</select><small>{{localize "XJZL.Encounter.ActionTargetHint"}}</small></label>
                <label class="encounter-field" data-show-target="selected" {{#unless action.showMaxTargets}}hidden{{/unless}}><span>{{localize "XJZL.Encounter.MaxTargets"}}</span><input type="number" min="0" step="1" name="system.support.groups.{{group.groupIndex}}.npcs.{{npc.npcIndex}}.actions.{{action.actionIndex}}.maxTargets" value="{{action.maxTargets}}"><small>{{localize "XJZL.Encounter.MaxTargetsHint"}}</small></label>
                <label class="encounter-field"><span>{{localize "XJZL.Encounter.AutomationType"}}</span><select data-automation-control name="system.support.groups.{{group.groupIndex}}.npcs.{{npc.npcIndex}}.actions.{{action.actionIndex}}.automationType">{{selectOptions @root.choices.automationTypes selected=action.automationType}}</select><small>{{localize "XJZL.Encounter.AutomationTypeHint"}}</small></label>
                <label class="encounter-field" data-show-automation="damage healing rage" {{#unless action.showAmount}}hidden{{/unless}}><span>{{localize "XJZL.Encounter.AmountFormula"}}</span><input data-encounter-formula type="text" name="system.support.groups.{{group.groupIndex}}.npcs.{{npc.npcIndex}}.actions.{{action.actionIndex}}.amountFormula" value="{{action.amountFormula}}" class="{{#if action.formulaError}}is-invalid{{/if}}"><small>{{#if action.formulaError}}{{action.formulaError}}{{else}}{{localize "XJZL.Encounter.FormulaHint"}}{{/if}}</small></label>
                <label class="encounter-field" data-show-automation="damage" {{#unless action.showDamageType}}hidden{{/unless}}><span>{{localize "XJZL.Encounter.DamageType"}}</span><select name="system.support.groups.{{group.groupIndex}}.npcs.{{npc.npcIndex}}.actions.{{action.actionIndex}}.damageType">{{selectOptions @root.choices.damageTypes selected=action.damageType}}</select><small>{{localize "XJZL.Encounter.DamageTypeHint"}}</small></label>
              </div>
              <label class="encounter-field encounter-description compact"><span>{{localize "XJZL.Encounter.Description"}}</span><textarea name="system.support.groups.{{group.groupIndex}}.npcs.{{npc.npcIndex}}.actions.{{action.actionIndex}}.description">{{action.description}}</textarea><small>{{localize "XJZL.Encounter.ActionDescriptionHint"}}</small></label>
              </div>
            </section>
            {{else}}<div class="action-empty">{{localize "XJZL.Encounter.NoActions"}}</div>{{/each}}
          </div>
          </div>
        </article>
        {{else}}<div class="group-empty"><i class="fas fa-user-plus"></i><b>{{localize "XJZL.Encounter.NoGroupNpcs"}}</b><span>{{localize "XJZL.Encounter.NoGroupNpcsHint"}}</span></div>{{/each}}
      </div>
      </div>
    </article>
    {{else}}
    <div class="encounter-empty"><i class="fas fa-layer-group"></i><b>{{localize "XJZL.Encounter.NoSupportGroups"}}</b><span>{{localize "XJZL.Encounter.NoSupportGroupsHint"}}</span><button type="button" data-action="addGroup"><i class="fas fa-plus"></i>{{localize "XJZL.Encounter.AddSupportGroup"}}</button></div>
    {{/each}}
  </div>
</section>
