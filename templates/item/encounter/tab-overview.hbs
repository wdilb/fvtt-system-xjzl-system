<section class="tab encounter-page overview-page {{#if (eq tabs.primary 'overview')}}active{{/if}}" data-tab="overview" data-group="primary" data-application-part="overview">
  <div class="encounter-page-heading">
    <span>{{localize "XJZL.Encounter.CommandBrief"}}</span>
    <h2>{{localize "XJZL.Encounter.OverviewTitle"}}</h2>
    <p>{{localize "XJZL.Encounter.OverviewHint"}}</p>
  </div>

  <div class="battle-overview-grid">
    <label class="battle-summary-editor">
      <span><i class="fas fa-align-left"></i>{{localize "XJZL.Encounter.BattleSummary"}}</span>
      <textarea name="system.description" maxlength="320" placeholder="{{localize 'XJZL.Encounter.BattleSummaryPlaceholder'}}">{{system.description}}</textarea>
      <small>{{localize "XJZL.Encounter.BattleSummaryHint"}}</small>
    </label>

    <section class="battle-readiness">
      <header><span>{{localize "XJZL.Encounter.ConfigurationReadiness"}}</span><b>{{localize "XJZL.Encounter.ReadyForLink"}}</b></header>
      <div class="readiness-metrics">
        <article><i class="fas fa-wave-square"></i><span>{{localize "XJZL.Encounter.EnabledFieldEffects"}}</span><b>{{summary.enabledFieldCount}} / {{summary.fieldCount}}</b></article>
        <article><i class="fas fa-layer-group"></i><span>{{localize "XJZL.Encounter.SupportGroups"}}</span><b>{{summary.groupCount}}</b></article>
        <article><i class="fas fa-user-group"></i><span>{{localize "XJZL.Encounter.SupportNpcs"}}</span><b>{{summary.npcCount}}</b></article>
        <article><i class="fas fa-bolt"></i><span>{{localize "XJZL.Encounter.SupportActions"}}</span><b>{{summary.actionCount}}</b></article>
      </div>
    </section>
  </div>

  <section class="battle-flow-map">
    <header><span>{{localize "XJZL.Encounter.RuntimeFlow"}}</span><p>{{localize "XJZL.Encounter.RuntimeFlowHint"}}</p></header>
    <div>
      <article><i class="fas fa-link"></i><b>{{localize "XJZL.Encounter.FlowLink"}}</b><small>{{localize "XJZL.Encounter.FlowLinkHint"}}</small></article>
      <i class="fas fa-chevron-right" aria-hidden="true"></i>
      <article><i class="fas fa-camera"></i><b>{{localize "XJZL.Encounter.FlowSnapshot"}}</b><small>{{localize "XJZL.Encounter.FlowSnapshotHint"}}</small></article>
      <i class="fas fa-chevron-right" aria-hidden="true"></i>
      <article><i class="fas fa-crosshairs"></i><b>{{localize "XJZL.Encounter.FlowResolve"}}</b><small>{{localize "XJZL.Encounter.FlowResolveHint"}}</small></article>
      <i class="fas fa-chevron-right" aria-hidden="true"></i>
      <article><i class="fas fa-display"></i><b>{{localize "XJZL.Encounter.FlowHud"}}</b><small>{{localize "XJZL.Encounter.FlowHudHint"}}</small></article>
    </div>
  </section>

  <aside class="encounter-note"><i class="fas fa-circle-info"></i><div><b>{{localize "XJZL.Encounter.SnapshotTitle"}}</b><p>{{localize "XJZL.Encounter.SnapshotHint"}}</p></div></aside>
</section>
