<header class="encounter-masthead" data-application-part="header">
  <div class="encounter-seal" aria-hidden="true">局</div>
  <div class="encounter-title-block">
    <span class="encounter-kicker">{{localize "TYPES.Item.encounter"}}</span>
    <input type="text" name="name" value="{{document.name}}" placeholder="{{localize 'XJZL.Encounter.NamePlaceholder'}}">
    <p>{{localize "XJZL.Encounter.HeaderHint"}}</p>
  </div>
  <div class="encounter-counts">
    <span><b>{{summary.fieldCount}}</b>{{localize "XJZL.Encounter.FieldEffects"}}</span>
    <span><b>{{summary.groupCount}}</b>{{localize "XJZL.Encounter.SupportGroups"}}</span>
    <span><b>{{summary.npcCount}}</b>{{localize "XJZL.Encounter.SupportNpcs"}}</span>
  </div>
</header>
