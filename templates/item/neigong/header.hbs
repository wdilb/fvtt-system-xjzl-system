<header class="martial-sheet-head neigong-sheet-head" data-application-part="header">
    <button type="button" class="martial-cover {{tierClass}}" data-action="editImage"
        data-tooltip="{{localize 'XJZL.UI.EditImage'}}">
        <img src="{{document.img}}" alt="">
        <span class="cover-edit"><i class="fas fa-camera" aria-hidden="true"></i></span>
    </button>

    <div class="martial-identity">
        <input type="text" name="name" value="{{document.name}}" class="martial-title"
            placeholder="{{localize 'XJZL.Neigong.NamePlaceholder'}}">
        <div class="martial-meta-row">
            <label class="martial-compact-field"><span>{{localize "XJZL.Neigong.Tier"}}</span>
                <select name="system.tier">{{selectOptions tierChoices selected=system.tier}}</select></label>
            <label class="martial-compact-field"><span>{{localize "XJZL.Neigong.Sect"}}</span>
                <select name="system.sect">{{selectOptions sects selected=system.sect localize=true blank=""}}</select></label>
            {{#if isJianghuShiLi}}
            <label class="martial-compact-field"><span>{{localize "XJZL.Wuxue.SubSect"}}</span>
                <select name="system.subSect">{{selectOptions subSects selected=system.subSect localize=true}}</select></label>
            {{/if}}
            <label class="martial-compact-field"><span>{{localize "XJZL.Neigong.Element"}}</span>
                <select name="system.element">{{selectOptions elementChoices selected=system.element localize=true}}</select></label>
            <label class="martial-official-toggle">
                <input type="checkbox" name="system.isOfficial" {{checked system.isOfficial}}>
                <span>{{localize "XJZL.Item.IsOfficial"}}</span>
            </label>
        </div>
    </div>

    <input type="hidden" name="system.xpInvested" value="{{system.xpInvested}}">
    <input type="hidden" name="system.sourceBreakdown.general" value="{{system.sourceBreakdown.general}}">
    <input type="hidden" name="system.sourceBreakdown.specific" value="{{system.sourceBreakdown.specific}}">
    <input type="hidden" name="system.active" value="{{system.active}}">
</header>
