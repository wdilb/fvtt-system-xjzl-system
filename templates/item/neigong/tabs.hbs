{{!-- 用 <a> 而非 <button>：button 属于表单控件，只读 sheet（如玩家浏览合集包）会被 Foundry 整体禁用导致无法切页 --}}
<nav class="martial-sheet-tabs tabs" data-application-part="tabs"
    aria-label="{{localize 'XJZL.Neigong.TabNavigation'}}">
    <a class="tab-button {{#if (eq tabs.primary 'config')}}active{{/if}}"
        data-action="tab" data-group="primary" data-tab="config">
        <i class="fas fa-layer-group" aria-hidden="true"></i><span>{{localize "XJZL.Neigong.TabRealm"}}</span>
    </a>
    <a class="tab-button {{#if (eq tabs.primary 'effects')}}active{{/if}}"
        data-action="tab" data-group="primary" data-tab="effects">
        <i class="fas fa-sliders" aria-hidden="true"></i><span>{{localize "XJZL.Neigong.TabEffectsShort"}}</span>
    </a>
</nav>
