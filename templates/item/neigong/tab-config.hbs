<section class="tab martial-workspace {{#if (eq tabs.primary 'config')}}active{{/if}} {{elementClass}}"
    data-tab="config" data-group="primary" data-application-part="config">
    <div class="neigong-editor-layout">
        <aside class="neigong-realm-list" aria-label="{{localize 'XJZL.Neigong.RealmList'}}">
            <div class="realm-list-heading">
                <span>{{localize "XJZL.Neigong.RealmList"}}</span>
                <small>{{localize "XJZL.Neigong.RealmListHint"}}</small>
            </div>
            {{!-- 境界导航是纯 UI 切换，用 <a> 避免被只读 sheet 的表单禁用逻辑波及（玩家浏览合集包场景） --}}
            <a class="realm-entry {{#if neigongOverviewSelected}}is-selected{{/if}}"
                data-action="selectStage" data-stage="overview" aria-pressed="{{neigongOverviewSelected}}">
                <span class="realm-index"><i class="fas fa-book-open" aria-hidden="true"></i></span>
                <span><strong>{{localize "XJZL.Neigong.Overview"}}</strong><small>{{localize "XJZL.Neigong.OverviewHint"}}</small></span>
            </a>
            {{#each stages as |stage|}}
            <a class="realm-entry {{#if stage.isSelected}}is-selected{{/if}}"
                data-action="selectStage" data-stage="{{stage.key}}" aria-pressed="{{stage.isSelected}}">
                <span class="realm-index">{{stage.id}}</span>
                <span><strong>{{localize stage.label}}</strong><small>{{localize "XJZL.Neigong.StageEditHint"}}</small></span>
            </a>
            {{/each}}
        </aside>

        <div class="neigong-panel-stack">
            <section class="neigong-panel neigong-overview-panel {{#if neigongOverviewSelected}}is-selected{{else}}is-collapsed{{/if}}"
                data-stage-key="overview">
                <header class="panel-heading">
                    <div><span class="panel-kicker">{{localize "XJZL.Neigong.OverviewKicker"}}</span>
                        <h2>{{localize "XJZL.Neigong.Overview"}}</h2></div>
                    <div class="panel-heading-side"><p>{{localize "XJZL.Neigong.OverviewDescription"}}</p>
                        <small class="panel-save-hint"><i class="fas fa-circle-info" aria-hidden="true"></i>{{localize "XJZL.UI.RichTextSaveHint"}}</small></div>
                </header>
                <div class="overview-form-grid">
                    <div class="field-block requirement-field">
                        <span><i class="fas fa-circle-exclamation" aria-hidden="true"></i> {{localize "XJZL.Neigong.Requirement"}}</span>
                        <div class="martial-rich-editor">
                            <div class="martial-rich-preview">{{{enrichedRequirement}}}</div>
                            <prose-mirror name="system.requirement" data-document-u-u-i-d="{{document.uuid}}"
                                value="{{system.requirement}}" toggled="false" button="true"></prose-mirror>
                        </div>
                    </div>
                    <label class="field-block automation-field">
                        <span><i class="fas fa-gears" aria-hidden="true"></i> {{localize "XJZL.AutomationNote"}}</span>
                        <textarea name="system.automationNote" rows="3"
                            placeholder="{{localize 'XJZL.Neigong.AutomationPlaceholder'}}">{{system.automationNote}}</textarea>
                    </label>
                    <div class="field-block description-field">
                        <span>{{localize "XJZL.Info.Description"}}</span>
                        <div class="martial-rich-editor">
                            <div class="martial-rich-preview">{{{enrichedDescription}}}</div>
                            <prose-mirror name="system.description" data-document-u-u-i-d="{{document.uuid}}"
                                value="{{system.description}}" toggled="false" button="true"></prose-mirror>
                        </div>
                    </div>
                </div>
                <section class="overview-stage-roadmap">
                    <header>
                        <div><span class="panel-kicker">{{localize "XJZL.Neigong.StageRailTitle"}}</span>
                            <h3>{{localize "XJZL.Neigong.OverviewRoadmapTitle"}}</h3></div>
                        <p>{{localize "XJZL.Neigong.OverviewRoadmapHint"}}</p>
                    </header>
                    <div class="stage-roadmap-list">
                        {{#each stages as |stage|}}
                        <a class="stage-roadmap-entry" data-action="selectStage" data-stage="{{stage.key}}">
                            <span class="stage-roadmap-index">{{stage.id}}</span>
                            <span><strong>{{localize stage.label}}</strong><small>{{localize "XJZL.Neigong.StageSelectHint"}}</small></span>
                            <span class="stage-roadmap-arrow" aria-hidden="true">→</span>
                        </a>
                        {{/each}}
                    </div>
                </section>
            </section>

            {{#each stages as |stage|}}
            <section class="neigong-panel realm-panel {{#if stage.isSelected}}is-selected{{else}}is-collapsed{{/if}}"
                data-stage-key="{{stage.key}}">
                <header class="panel-heading realm-panel-heading">
                    <div><span class="panel-kicker">{{localize "XJZL.Neigong.RealmKicker"}} {{stage.id}}</span>
                        <h2>{{localize stage.label}}</h2></div>
                    <span class="realm-seal" aria-hidden="true">{{stage.id}}</span>
                </header>

                <div class="field-block realm-description">
                    <span>{{localize "XJZL.Neigong.StageDescription"}}</span>
                    <div class="martial-rich-editor">
                        <div class="martial-rich-preview">{{{stage.enrichedDescription}}}</div>
                        <prose-mirror name="system.config.{{stage.key}}.description" data-document-u-u-i-d="{{@root.document.uuid}}"
                            value="{{lookup (lookup ../system.config stage.key) 'description'}}" toggled="false" button="true"></prose-mirror>
                    </div>
                </div>

                <div class="realm-stat-grid" aria-label="{{localize 'XJZL.Neigong.StatsConfig'}}">
                    <label><span>{{localize "XJZL.Stats.Liliang"}}</span><input type="number"
                        name="system.config.{{stage.key}}.stats.liliang" value="{{lookup (lookup (lookup ../system.config stage.key) 'stats') 'liliang'}}"></label>
                    <label><span>{{localize "XJZL.Stats.Shenfa"}}</span><input type="number"
                        name="system.config.{{stage.key}}.stats.shenfa" value="{{lookup (lookup (lookup ../system.config stage.key) 'stats') 'shenfa'}}"></label>
                    <label><span>{{localize "XJZL.Stats.Tipo"}}</span><input type="number"
                        name="system.config.{{stage.key}}.stats.tipo" value="{{lookup (lookup (lookup ../system.config stage.key) 'stats') 'tipo'}}"></label>
                    <label><span>{{localize "XJZL.Stats.Neixi"}}</span><input type="number"
                        name="system.config.{{stage.key}}.stats.neixi" value="{{lookup (lookup (lookup ../system.config stage.key) 'stats') 'neixi'}}"></label>
                    <label><span>{{localize "XJZL.Stats.Qigan"}}</span><input type="number"
                        name="system.config.{{stage.key}}.stats.qigan" value="{{lookup (lookup (lookup ../system.config stage.key) 'stats') 'qigan'}}"></label>
                    <label><span>{{localize "XJZL.Stats.Shencai"}}</span><input type="number"
                        name="system.config.{{stage.key}}.stats.shencai" value="{{lookup (lookup (lookup ../system.config stage.key) 'stats') 'shencai'}}"></label>
                </div>

                <div class="realm-tools-grid">
                    {{#with (lookup (lookup ../system.config stage.key) 'xpCostRatio') as |ratio|}}
                    <label class="setting-card ratio-card">
                        <span><i class="fas fa-coins" aria-hidden="true"></i> {{localize "XJZL.Neigong.XPCostRatio"}}</span>
                        <div><input type="number" name="system.config.{{stage.key}}.xpCostRatio" value="{{ratio}}" min="0.1" step="0.1"><small>{{localize "XJZL.UI.RatioHint"}}</small></div>
                    </label>
                    {{/with}}
                    <div class="setting-card script-summary">
                        <span><i class="fas fa-code" aria-hidden="true"></i> {{localize "XJZL.Neigong.ScriptLabel"}}</span>
                        <button type="button" data-action="addStageScript" data-stage="{{stage.key}}"><i class="fas fa-plus" aria-hidden="true"></i> {{localize "XJZL.Neigong.AddScript"}}</button>
                    </div>
                </div>

                <div class="script-list">
                    {{#each (lookup (lookup ../system.config stage.key) 'scripts') as |script i|}}
                    <details class="script-card" {{#unless script.script}}open{{/unless}}>
                        <summary>
                            <i class="fas fa-code" aria-hidden="true"></i>
                            <strong>{{#if script.label}}{{script.label}}{{else}}{{localize "XJZL.Script.NamePlaceholder"}}{{/if}}</strong>
                            <span>{{lookup ../../scriptTriggerChoices script.trigger}}</span>
                            <span class="script-state {{#if script.active}}is-active{{/if}}">{{#if script.active}}{{localize "XJZL.UI.Enable"}}{{else}}{{localize "XJZL.UI.StatusDisabled"}}{{/if}}</span>
                        </summary>
                        <div class="script-card-body">
                            <div class="script-meta-row">
                                <input type="text" name="system.config.{{stage.key}}.scripts.{{i}}.label" value="{{script.label}}" placeholder="{{localize 'XJZL.Script.NamePlaceholder'}}">
                                <select name="system.config.{{stage.key}}.scripts.{{i}}.trigger">{{selectOptions ../../scriptTriggerChoices selected=script.trigger localize=false}}</select>
                                <label class="inline-check"><input type="checkbox" name="system.config.{{stage.key}}.scripts.{{i}}.active" {{checked script.active}}> {{localize "XJZL.UI.Enable"}}</label>
                                <button type="button" class="icon-button danger" data-action="deleteStageScript" data-stage="{{stage.key}}" data-index="{{i}}" aria-label="{{localize 'XJZL.UI.Delete'}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
                            </div>
                            <textarea name="system.config.{{stage.key}}.scripts.{{i}}.script" class="script-code" placeholder="// JS Code...">{{script.script}}</textarea>
                        </div>
                    </details>
                    {{/each}}
                </div>

                {{#if (eq stage.key "stage3")}}
                <section class="mastery-section">
                    <header><div><span class="panel-kicker">{{localize "XJZL.Neigong.MasteryKicker"}}</span><h3>{{localize "XJZL.Neigong.MasteryTitle"}}</h3></div>
                        <button type="button" data-action="addMasteryChange"><i class="fas fa-plus" aria-hidden="true"></i> {{localize "XJZL.Neigong.MasteryAddChange"}}</button></header>
                    <p>{{localize "XJZL.Neigong.MasteryHint"}}</p>
                    <div class="mastery-list">
                        {{#each @root.system.masteryChanges as |change i|}}
                        <div class="mastery-row">
                            <input type="hidden" name="system.masteryChanges.{{i}}.key" value="{{change.key}}">
                            <button type="button" class="modifier-picker" data-action="openModifierPicker" data-index="{{i}}" data-tooltip="{{change.key}}"><span>{{change.displayLabel}}</span><i class="fas fa-chevron-down" aria-hidden="true"></i></button>
                            <input type="number" name="system.masteryChanges.{{i}}.value" value="{{change.value}}" placeholder="0">
                            <input type="text" name="system.masteryChanges.{{i}}.label" value="{{change.label}}" placeholder="{{localize 'XJZL.Neigong.Note'}}">
                            <button type="button" class="icon-button danger" data-action="deleteMasteryChange" data-index="{{i}}" aria-label="{{localize 'XJZL.UI.Delete'}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
                        </div>
                        {{else}}
                        <p class="empty-inline">{{localize "XJZL.Neigong.EmptyMasteryHint"}}</p>
                        {{/each}}
                    </div>
                    <div class="field-block mastery-effect-field">
                        <span>{{localize "XJZL.Neigong.MasteryEffect"}}</span>
                        <small>{{localize "XJZL.Neigong.MasteryEffectHint"}}</small>
                        <div class="martial-rich-editor">
                            <div class="martial-rich-preview">{{{@root.enrichedMasteryEffect}}}</div>
                            <prose-mirror name="system.masteryEffect" data-document-u-u-i-d="{{@root.document.uuid}}"
                                value="{{@root.system.masteryEffect}}" toggled="false" button="true"></prose-mirror>
                        </div>
                    </div>
                </section>
                {{/if}}
            </section>
            {{/each}}
        </div>
    </div>
</section>
