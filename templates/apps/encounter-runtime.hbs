<div class="encounter-hud-shell {{#if compact}}is-compact{{else}}is-detailed{{/if}}" data-application-part="main">
  {{#if linked}}
  <header class="hud-command-deck">
    <div class="hud-crest" aria-hidden="true">局</div>
    <div class="hud-identity"><span>{{combat.name}}</span><h1>{{state.name}}</h1></div>
    <div class="hud-round"><i></i><span>{{localize "XJZL.Encounter.Round"}}</span><b>{{combat.round}}</b></div>
    <button type="button" class="hud-mode-toggle" data-action="toggleViewMode" title="{{#if compact}}{{localize 'XJZL.Encounter.SwitchDetailed'}}{{else}}{{localize 'XJZL.Encounter.SwitchCompact'}}{{/if}}"><i class="fas {{#if compact}}fa-sliders{{else}}fa-compress{{/if}}"></i></button>

    {{#if detailed}}
    <nav class="hud-navigation" aria-label="{{localize 'XJZL.Encounter.BattleSituation'}}">
      <button type="button" class="{{#if (eq activeSection 'fields')}}active{{/if}}" data-runtime-section="fields"><i class="fas fa-mountain"></i><span>{{localize "XJZL.Encounter.FieldEffects"}}</span></button>
      {{#if canUseSupport}}<button type="button" class="{{#if (eq activeSection 'support')}}active{{/if}}" data-runtime-section="support"><i class="fas fa-flag"></i><span>{{localize "XJZL.Encounter.SupportEffects"}}</span></button>{{/if}}
      <button type="button" class="{{#if (eq activeSection 'pending')}}active{{/if}}" data-runtime-section="pending"><i class="fas fa-list-check"></i><span>{{localize "XJZL.Encounter.PendingItems"}}</span><b>{{state.pendingItems.length}}</b></button>
    </nav>
    {{/if}}
  </header>

  {{#if compact}}
  <main class="encounter-runtime-body compact-runtime-body tactical-ribbon" aria-live="polite">
    {{#if state.fieldEffects.length}}
    <section class="tactical-band field-orbit"><span class="band-mark"><i class="fas fa-mountain"></i></span><div class="effect-orbit-list">
      {{#each state.fieldEffects as |effect|}}<span class="tactical-orb-wrap {{#unless effect.enabled}}is-disabled{{/unless}}"><button type="button" class="tactical-orb field-orb" data-action="{{#if ../isGM}}executeEffect{{else}}viewDescription{{/if}}" data-effect-id="{{effect.id}}" aria-label="{{effect.name}}"><i class="fas {{effect.iconClass}}"></i><span class="orb-lamp"></span></button><span class="tactical-popover field-popover"><em>{{effect.triggerLabel}}</em><b>{{effect.name}}</b><small>{{effect.nextTrigger}}</small><p>{{effect.descriptionText}}</p><span>{{effect.targetNames}} · {{effect.automationLabel}}{{#if effect.damageTypeLabel}} · {{effect.damageTypeLabel}}{{/if}}</span>{{#if effect.hasAmount}}<strong>{{effect.currentAmount}}</strong>{{/if}}</span></span>{{/each}}
    </div></section>
    {{/if}}

    {{#if canUseSupport}}
    <section class="support-dock">
      {{#each state.support.groups as |group|}}<div class="support-dock-group"><header><span>{{group.displayName}}</span><small>{{group.availableCount}} / {{group.npcs.length}}</small></header><div class="support-pod-list">
        {{#each group.npcs as |npc|}}<article class="support-pod {{#if npc.available}}is-available{{else}}is-unavailable{{/if}}"><span class="pod-portrait">{{#if npc.snapshotImg}}<img src="{{npc.snapshotImg}}" alt="">{{else}}<i class="fas fa-user"></i>{{/if}}<i class="pod-lamp"></i><span class="npc-popover tactical-popover"><em>{{group.displayName}}</em><b>{{npc.snapshotName}}</b><small>{{npc.availabilityLabel}}</small><span>{{npc.descriptionText}}</span></span></span><div class="pod-command"><b>{{npc.snapshotName}}</b><div class="pod-action-row">
          {{#each npc.actions as |action|}}<span class="action-orb-wrap"><button type="button" class="action-orb {{#if action.usable}}is-ready{{else}}is-locked{{/if}}" data-action="useSupport" data-quick-use="true" data-group-id="{{group.id}}" data-npc-id="{{npc.id}}" data-action-id="{{action.id}}" aria-label="{{action.name}}" {{#unless action.usable}}disabled{{/unless}}><i class="fas {{action.iconClass}}"></i></button><span class="action-popover tactical-popover"><em>{{action.automationLabel}} · {{action.targetLabel}}</em><b>{{action.name}}</b><small>{{action.availabilityLabel}}</small><span>{{action.descriptionText}}</span></span></span>{{else}}<i class="no-action-mark fas fa-minus"></i>{{/each}}
        </div></div></article>{{/each}}
      </div></div>{{/each}}
    </section>
    {{/if}}
  </main>
  {{else}}
  <main class="encounter-runtime-body detailed-runtime-body" aria-live="polite">
    {{#if (eq activeSection "fields")}}
    <section class="runtime-list">
      {{#each state.fieldEffects as |effect|}}
      <article class="runtime-effect {{#unless effect.enabled}}is-disabled{{/unless}}">
        <div class="runtime-effect-state"><i class="fas fa-wave-square"></i><span>{{effect.nextTrigger}}</span></div>
        <div class="runtime-effect-main"><div class="runtime-title"><h3>{{effect.name}}</h3><span>{{effect.triggerLabel}}</span></div><div class="runtime-tags"><b><i class="fas fa-crosshairs"></i>{{effect.targetNames}}</b><b><i class="fas fa-bolt"></i>{{effect.automationLabel}}</b>{{#if effect.isDamage}}<b class="damage-tag">{{effect.damageTypeLabel}}</b>{{/if}}{{#if effect.hasAmount}}<strong>{{effect.currentAmount}}</strong>{{/if}}</div></div>
        <div class="runtime-actions"><button data-action="viewDescription" data-effect-id="{{effect.id}}" title="{{localize 'XJZL.Encounter.ViewRule'}}"><i class="fas fa-book-open"></i></button>{{#if ../isGM}}<button data-action="editEffect" data-effect-id="{{effect.id}}" title="{{localize 'XJZL.UI.Edit'}}"><i class="fas fa-pen"></i></button><button class="execute" data-action="executeEffect" data-effect-id="{{effect.id}}" title="{{localize 'XJZL.Encounter.ExecuteNow'}}"><i class="fas fa-bolt"></i></button><button data-action="toggleEffect" data-effect-id="{{effect.id}}" title="{{#if effect.enabled}}{{localize 'XJZL.Encounter.Disable'}}{{else}}{{localize 'XJZL.Encounter.Enable'}}{{/if}}"><i class="fas fa-power-off"></i></button>{{/if}}</div>
      </article>
      {{else}}<div class="hud-empty"><i class="fas fa-wind"></i><b>{{localize "XJZL.Encounter.NoFieldEffects"}}</b></div>{{/each}}
    </section>
    {{/if}}

    {{#if canUseSupport}}{{#if (eq activeSection "support")}}
    <section class="support-runtime">
      {{#each state.support.groups as |group|}}
      <article class="runtime-support-group {{#unless group.enabled}}is-disabled{{/unless}}">
        <header class="runtime-group-heading"><div><span>{{localize "XJZL.Encounter.SupportGroup"}}</span><h2>{{group.displayName}}</h2><p>{{group.description}}</p></div><div class="runtime-quota"><span>{{localize "XJZL.Encounter.EncounterRemaining"}} <b>{{group.encounterRemainingLabel}}</b></span><span>{{localize "XJZL.Encounter.RoundRemaining"}} <b>{{group.roundRemainingLabel}}</b></span>{{#if ../isGM}}<button data-action="editSupport" data-group-id="{{group.id}}" title="{{localize 'XJZL.Encounter.EditSupport'}}"><i class="fas fa-sliders"></i></button>{{/if}}</div></header>
        <div class="support-runtime-grid">
          {{#each group.npcs as |npc|}}
          <article class="runtime-npc {{#if npc.available}}is-available{{else}}is-unavailable{{/if}}">
            <header><div class="npc-portrait">{{#if npc.snapshotImg}}<img src="{{npc.snapshotImg}}" alt="">{{else}}<i class="fas fa-user"></i>{{/if}}<span class="availability-lamp"></span></div><div class="runtime-npc-identity"><h3>{{npc.snapshotName}}</h3><p>{{npc.description}}</p></div><span class="npc-remaining"><small>{{localize "XJZL.Encounter.NpcRemaining"}}</small><b>{{npc.encounterRemainingLabel}}</b></span>{{#if ../../isGM}}<span class="quota-adjust npc-adjust"><button data-action="adjustCounter" data-group-id="{{group.id}}" data-scope="npc" data-npc-id="{{npc.id}}" data-delta="-1">−</button><button data-action="adjustCounter" data-group-id="{{group.id}}" data-scope="npc" data-npc-id="{{npc.id}}" data-delta="1">+</button></span><button class="npc-toggle" data-action="toggleNpc" data-group-id="{{group.id}}" data-npc-id="{{npc.id}}"><i class="fas fa-power-off"></i></button>{{/if}}</header>
            <div class="npc-availability"><i class="fas {{#if npc.available}}fa-signal{{else}}fa-lock{{/if}}"></i>{{npc.availabilityLabel}}</div>
            <div class="support-action-list">{{#each npc.actions as |action|}}<div class="runtime-support-action {{#if action.usable}}is-ready{{else}}is-locked{{/if}}"><div><b>{{action.name}}</b><span>{{#if action.usable}}{{action.automationLabel}} · {{action.targetLabel}}{{#if action.damageTypeLabel}} · {{action.damageTypeLabel}}{{/if}}{{else}}{{action.availabilityLabel}}{{/if}}</span></div>{{#if ../../../isGM}}<button data-action="editAction" data-group-id="{{group.id}}" data-npc-id="{{npc.id}}" data-action-id="{{action.id}}"><i class="fas fa-pen"></i></button>{{/if}}<button class="support-use" data-action="useSupport" data-group-id="{{group.id}}" data-npc-id="{{npc.id}}" data-action-id="{{action.id}}" {{#unless action.usable}}disabled{{/unless}}><i class="fas fa-flag"></i><span>{{localize "XJZL.Encounter.UseSupport"}}</span></button></div>{{else}}<div class="quick-empty">{{localize "XJZL.Encounter.NoActions"}}</div>{{/each}}</div>
          </article>
          {{else}}<div class="hud-empty"><i class="fas fa-user-plus"></i><b>{{localize "XJZL.Encounter.NoGroupNpcs"}}</b></div>{{/each}}
        </div>
      </article>
      {{else}}<div class="hud-empty"><i class="fas fa-flag"></i><b>{{localize "XJZL.Encounter.NoSupportGroups"}}</b></div>{{/each}}
    </section>
    {{/if}}{{/if}}

    {{#if (eq activeSection "pending")}}
    <section class="pending-list">{{#each state.pendingItems as |pending|}}<article><div><span>{{pending.triggerLabel}} · {{localize "XJZL.Encounter.Round"}} {{pending.round}}</span><h3>{{pending.name}}</h3><p>{{pending.targetNames}}</p><div class="pending-rule">{{{pending.description}}}</div></div><div class="runtime-actions"><button data-action="openStatus" data-pending-id="{{pending.id}}" title="{{localize 'XJZL.Encounter.OpenStatus'}}"><i class="fas fa-hand-sparkles"></i></button>{{#if ../isGM}}<button class="execute" data-action="resolvePending" data-pending-id="{{pending.id}}" title="{{localize 'XJZL.Encounter.MarkResolved'}}"><i class="fas fa-check"></i></button>{{/if}}</div></article>{{else}}<div class="hud-empty"><i class="fas fa-check-double"></i><b>{{localize "XJZL.Encounter.NoPending"}}</b></div>{{/each}}</section>
    {{/if}}
  </main>
  {{/if}}
  {{else}}
  <div class="runtime-unlinked"><div class="hud-crest">局</div><h2>{{#if skipped}}{{localize "XJZL.Encounter.SkippedTitle"}}{{else}}{{localize "XJZL.Encounter.NotLinked"}}{{/if}}</h2><p>{{localize "XJZL.Encounter.RuntimeUnlinkedHint"}}</p>{{#if canLinkEncounter}}<button data-action="linkEncounter"><i class="fas fa-link"></i>{{localize "XJZL.Encounter.LinkEncounter"}}</button>{{/if}}</div>
  {{/if}}
</div>
