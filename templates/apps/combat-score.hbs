<div class="score-container">
    {{#if isLevel1}}
    <!-- ================= Level 1: 全局榜单视图 ================= -->
    <div class="level1-view">

        <!-- 领奖台区域 (仅渲染有数据的名次) -->
        <div class="podium-section">
            <div class="bg-glow"></div>

            <!-- 银牌: 第 2 名 (固定在左) -->
            {{#if rank2}}
            <div class="podium-spot spot-rank-2">
                <div class="podium-avatar-wrapper">
                    <img src="{{rank2.img}}" onerror="this.src='icons/svg/mystery-man.svg';" />
                    <div class="grade-badge grade-{{rank2.grade}}">{{rank2.grade}}</div>
                </div>
                <div class="podium-info">
                    <div class="podium-name">{{rank2.name}}</div>
                    <div class="podium-score">{{rank2.score}} <span class="pts">PTS</span></div>
                </div>
                <div class="podium-base"></div>
            </div>
            {{/if}}

            <!-- 金牌: 第 1 名 (固定在中) -->
            {{#if rank1}}
            <div class="podium-spot spot-rank-1">
                <div class="podium-avatar-wrapper">
                    <img src="{{rank1.img}}" onerror="this.src='icons/svg/mystery-man.svg';" />
                    <div class="grade-badge grade-{{rank1.grade}}">{{rank1.grade}}</div>
                </div>
                <div class="podium-info">
                    <div class="podium-name">{{rank1.name}}</div>
                    <div class="podium-score">{{rank1.score}} <span class="pts">PTS</span></div>
                </div>
                <div class="podium-base">
                    <div class="base-light"></div>
                </div>
            </div>
            {{/if}}

            <!-- 铜牌: 第 3 名 (固定在右) -->
            {{#if rank3}}
            <div class="podium-spot spot-rank-3">
                <div class="podium-avatar-wrapper">
                    <img src="{{rank3.img}}" onerror="this.src='icons/svg/mystery-man.svg';" />
                    <div class="grade-badge grade-{{rank3.grade}}">{{rank3.grade}}</div>
                </div>
                <div class="podium-info">
                    <div class="podium-name">{{rank3.name}}</div>
                    <div class="podium-score">{{rank3.score}} <span class="pts">PTS</span></div>
                </div>
                <div class="podium-base"></div>
            </div>
            {{/if}}
        </div>

        <!-- 倾斜切角风格列表 -->
        <div class="list-section">
            <div class="list-header"
                style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                <span><i class="fas fa-list-ol"></i> 全员评分 </span>
                <button class="icon-btn" data-action="reportScore" title="发送排行榜到聊天"
                    style="background:transparent; border:none; color:#66fcf1; cursor:pointer; font-size: 14px; font-weight:bold;">
                    <i class="fas fa-bullhorn"></i> 发送
                </button>
            </div>
            <ul class="score-list">
                {{#each actors}}
                <li class="score-row" data-action="viewDetail" data-uuid="{{this.uuid}}">
                    <div class="row-bg"></div>
                    <div class="row-content">
                        <div class="rank-box">#{{this.rank}}</div>
                        <img class="avatar" src="{{this.img}}" onerror="this.src='icons/svg/mystery-man.svg';" />
                        <span class="name">{{this.name}}</span>
                        <div class="score-display">
                            <span class="val">{{this.score}}</span>
                            <span class="label">PTS</span>
                        </div>
                        <div class="grade-text grade-{{this.grade}}">{{this.grade}}</div>
                        <i class="fas fa-caret-right enter-icon"></i>
                    </div>
                </li>
                {{/each}}
            </ul>
        </div>
    </div>
    {{else}}

    <!-- ================= Level 2: 个人战术面板视图 ================= -->
    <div class="level2-view">
        <div class="l2-bg" style="background-image: url('{{detail.img}}');"></div>
        <div class="l2-overlay"></div>

        <!-- 内联样式强制左右对齐 + 标题绝对居中 -->
        <header class="detail-header"
            style="display: flex; justify-content: space-between; align-items: center; width: 100%; box-sizing: border-box;">
            <button class="icon-btn back-btn" data-action="goBack"
                style="background:transparent; border:none; color:#66fcf1; font-size: 16px; font-weight: bold; cursor:pointer; width: 100px; text-align: left;">
                <i class="fas fa-chevron-left"></i> 返回概览
            </button>

            <span class="detail-title"
                style="flex: 1; text-align: center; font-size: 14px; color: #45a29e; letter-spacing: 2px; font-weight: bold;">
                评分分析
            </span>

            <button class="icon-btn" data-action="reportScore" title="发送此人数据到聊天"
                style="background:transparent; border:none; color:#66fcf1; font-size: 16px; font-weight: bold; cursor:pointer; width: 100px; text-align: right;">
                <i class="fas fa-bullhorn"></i> 发送
            </button>
        </header>

        <main class="detail-body">
            <!-- 左侧：英雄立绘展示区 -->
            <div class="hero-showcase">
                <div class="hero-avatar-box">
                    <img src="{{detail.img}}" onerror="this.src='icons/svg/mystery-man.svg';" />
                    <div class="huge-grade grade-{{detail.grade}}">{{detail.grade}}</div>
                </div>
                <h2 class="hero-name">{{detail.name}}</h2>
                <div class="hero-total">
                    <span class="lbl">TOTAL RATING</span>
                    <span class="val">{{detail.score}}</span>
                </div>
            </div>

            <!-- 右侧：原生水晶雷达图 + 数据模块 -->
            <div class="data-showcase">

                <!-- 手写纯净版 SVG 雷达图 -->
                <div class="radar-hud">
                    <svg viewBox="0 0 100 100" class="radar-svg">
                        <defs>
                            <!-- 炫光滤镜 -->
                            <filter id="radar-glow" x="-20%" y="-20%" width="140%" height="140%">
                                <feGaussianBlur stdDeviation="1.5" result="blur" />
                                <feMerge>
                                    <feMergeNode in="blur" />
                                    <feMergeNode in="SourceGraphic" />
                                </feMerge>
                            </filter>
                            <!-- 内部发光渐变 -->
                            <linearGradient id="radar-fill" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="rgba(102, 252, 241, 0.7)" />
                                <stop offset="100%" stop-color="rgba(255, 60, 0, 0.7)" />
                            </linearGradient>
                        </defs>

                        <!-- 背景网格刻度 (四个菱形层) -->
                        <g class="radar-grid" stroke="rgba(255,255,255,0.15)" stroke-width="0.5" fill="none">
                            <polygon points="50,10 90,50 50,90 10,50" />
                            <polygon points="50,20 80,50 50,80 20,50" />
                            <polygon points="50,30 70,50 50,70 30,50" />
                            <polygon points="50,40 60,50 50,60 40,50" />
                        </g>

                        <!-- 十字坐标轴 -->
                        <g class="radar-axis" stroke="rgba(255,255,255,0.2)" stroke-width="0.5">
                            <line x1="50" y1="10" x2="50" y2="90" />
                            <line x1="10" y1="50" x2="90" y2="50" />
                        </g>

                        <!-- 动态生成的四维数据多边形 -->
                        <polygon points="{{detail.radar.svgPolygon}}" fill="url(#radar-fill)" stroke="#66fcf1"
                            stroke-width="1.2" filter="url(#radar-glow)" class="radar-data-shape" />
                    </svg>

                    <!-- 雷达图标签 -->
                    <div class="r-label l-top">
                        <span class="lbl">输出</span><span class="pct">{{detail.radar.damage}}%</span>
                    </div>
                    <div class="r-label l-right">
                        <span class="pct">{{detail.radar.healing}}%</span><span class="lbl">治疗</span>
                    </div>
                    <div class="r-label l-bottom">
                        <span class="lbl">承伤</span><span class="pct">{{detail.radar.taken}}%</span>
                    </div>
                    <div class="r-label l-left">
                        <span class="lbl">破架</span><span class="pct">{{detail.radar.broken}}%</span>
                    </div>
                </div>

                <!-- 下方四个数据模块 -->
                <div class="stats-grid">
                    <div class="stat-box highlight-dmg">
                        <i class="fas fa-fire"></i>
                        <div class="stat-texts">
                            <span class="lbl">造成伤害</span>
                            <span class="val">{{detail.raw.damage}}</span>
                        </div>
                    </div>
                    <div class="stat-box highlight-heal">
                        <i class="fas fa-heart"></i>
                        <div class="stat-texts">
                            <span class="lbl">提供治疗</span>
                            <span class="val">{{detail.raw.healing}}</span>
                        </div>
                    </div>
                    <div class="stat-box highlight-shield">
                        <i class="fas fa-shield-alt"></i>
                        <div class="stat-texts">
                            <span class="lbl">承受伤害</span>
                            <span class="val">{{detail.raw.taken}}</span>
                        </div>
                    </div>
                    <div class="stat-box highlight-break">
                        <i class="fas fa-hammer"></i>
                        <div class="stat-texts">
                            <span class="lbl">破架次数</span>
                            <span class="val">{{detail.raw.broken}}</span>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    {{/if}}
</div>