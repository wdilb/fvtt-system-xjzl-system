<div class="xjzl-gufeng-panel {{#if isExpanded}}expanded{{else}}minimized{{/if}}">

    {{#if isExpanded}}
    <!-- 展开状态：古风卷轴面板 -->
    <div class="panel-border-overlay"></div> <!-- 装饰边框 -->

    <div class="panel-header" data-tooltip="{{localize 'XJZL.UI.ToneTracker.DragHint'}}">
        <span class="title"><i class="fas fa-scroll"></i> {{localize "XJZL.UI.ToneTracker.Header"}}</span>
        <a class="toggle-btn" data-tooltip="{{localize 'XJZL.UI.ToneTracker.Collapse'}}"><i class="fas fa-compress-alt"></i></a>
    </div>

    <!-- 队列区 -->
    <div class="queue-wrapper">
        <div class="slots-container">
            {{#each slots}}
            <!-- 在 class 里面追加了 slide-left 的判定 -->
            <div class="tone-slot {{#if this.isEmpty}}empty{{else}}filled{{/if}} {{#if this.isNew}}pop-in{{/if}} {{#if this.isSliding}}slide-left{{/if}}"
                data-index="{{this.index}}" data-tooltip="{{localize 'XJZL.UI.ToneTracker.ToneHint'}}"
                style="--tone-color: {{this.color}}; --tone-shadow: {{this.shadow}};">

                {{#if this.isEmpty}}
                <div class="slot-core"></div>
                {{else}}
                <span class="tone-text">{{this.label}}</span>
                {{/if}}
            </div>
            {{/each}}
        </div>
    </div>

    <div class="divider-line"></div>

    <!-- 抚琴控制区 -->
    <div class="controls-container">
        <div class="add-buttons" data-tooltip="{{localize 'XJZL.UI.ToneTracker.PlayHint'}}">
            {{#each buttons}}
            <button class="add-tone-btn" data-tone="{{this.key}}" style="--btn-color: {{this.color}};">
                {{this.label}}
            </button>
            {{/each}}
        </div>

        <div class="footer-actions">
            <a class="clear-tones-btn {{#unless hasTones}}disabled{{/unless}}" data-tooltip="{{localize 'XJZL.UI.ToneTracker.Clear'}}">
                <i class="fas fa-wind"></i> {{localize "XJZL.UI.ToneTracker.ClearAction"}}
            </a>
        </div>
    </div>

    {{else}}
    <!-- 缩起状态：一块温润的玉佩 -->
    <div class="toggle-btn mini-jade" data-tooltip="{{localize 'XJZL.UI.ToneTracker.Expand'}}">
        <i class="fas fa-music"></i>
        {{#if hasTones}}
        <span class="jade-tassel"></span> <!-- 假装是玉佩下的红穗子提示 -->
        {{/if}}
    </div>
    {{/if}}

</div>
