<div class="resource-picker-body">
    <header class="resource-picker-header">
        <div class="resource-picker-header-copy">
            <div class="resource-picker-eyebrow"><span></span>{{localize "XJZL.CharacterGenerator.ResourcePickerKicker"}}<span></span></div>
            <h2>
                <span class="resource-picker-title-mark"><i class="fas fa-filter"></i></span>
                <span>{{localize "XJZL.CharacterGenerator.ResourcePickerTitle"}}</span>
                <em>{{tabLabel}}</em>
            </h2>
            <p>{{hint}}</p>
        </div>
        <div class="resource-picker-header-stat">
            <span>{{localize "XJZL.CharacterGenerator.ResourcePickerTotal"}}</span>
            <strong>{{resultCount}}</strong>
            <small>项</small>
        </div>
    </header>

    <div class="resource-picker-layout">
        <aside class="resource-picker-filters">
            <div class="resource-picker-filter-toolbar">
                <div>
                    <span class="resource-picker-section-kicker">FILTER / 01</span>
                    <h3><i class="fas fa-sliders"></i> {{localize "XJZL.CompendiumBrowser.Filter.Label"}}</h3>
                </div>
                <button type="button" class="resource-picker-reset" data-action="resetFilters">
                    <i class="fas fa-rotate-left"></i>
                    {{localize "XJZL.CompendiumBrowser.Filter.Reset"}}
                </button>
            </div>

            <label class="resource-picker-search">
                <span>{{localize "XJZL.CompendiumBrowser.Filter.SearchPlaceholder"}}</span>
                <span class="resource-picker-search-field">
                    <i class="fas fa-search"></i>
                    <input type="search" data-picker-search value="{{searchQuery}}" autocomplete="off">
                </span>
            </label>

            <div class="resource-picker-filter-list">
                {{#each filterList}}
                <details class="resource-picker-filter-group" {{#if this.isOpen}}open{{/if}}>
                    <summary>
                        <span>{{this.label}}</span>
                        <i class="fas fa-chevron-down"></i>
                    </summary>
                    <div class="resource-picker-filter-options">
                        {{#each this.options}}
                        <label class="resource-picker-filter-option {{#if this.checked}}is-checked{{/if}}">
                            <input class="resource-picker-checkbox" type="checkbox" data-picker-filter="{{../key}}" value="{{this.val}}" {{checked this.checked}}>
                            <span class="resource-picker-filter-label">{{this.label}}</span>
                            <small>{{this.count}}</small>
                        </label>
                        {{/each}}
                    </div>
                </details>
                {{else}}
                <p class="resource-picker-empty-note">{{localize "XJZL.CompendiumBrowser.Filter.NoFilters"}}</p>
                {{/each}}
            </div>
        </aside>

        <section class="resource-picker-results">
            <div class="resource-picker-result-heading">
                <div class="resource-picker-result-copy">
                    <span class="resource-picker-section-kicker">RESOURCE / RESULT</span>
                    <strong>{{#if hasMore}}显示 {{displayedCount}} / {{resultCount}} 项{{else}}全部 {{resultCount}} 项{{/if}}</strong>
                </div>
                <div class="resource-picker-result-actions">
                    {{#if hasMore}}
                    <button type="button" class="resource-picker-load-more" data-action="loadMore">
                        <i class="fas fa-plus"></i>
                        {{localize "XJZL.CharacterGenerator.ResourcePickerLoadMore"}}
                    </button>
                    {{/if}}
                    {{#if (eq mode "range")}}
                    <button type="button" class="resource-picker-apply" data-action="applyRange">
                        <i class="fas fa-check"></i>
                        {{localize "XJZL.CharacterGenerator.ApplyRange"}}
                    </button>
                    {{/if}}
                </div>
            </div>

            <div class="resource-picker-card-grid">
                {{#each items}}
                <button type="button" class="resource-picker-card" {{#if (eq ../mode "resource")}}data-action="selectResource"{{/if}} data-uuid="{{this.uuid}}" data-tooltip="{{this.tooltip}}" data-tooltip-direction="UP">
                    <span class="resource-picker-card-art">
                        <img src="{{this.img}}" loading="lazy" alt="">
                    </span>
                    <span class="resource-picker-card-info">
                        <strong>{{this.name}}</strong>
                        {{#if this.sub}}<small>{{this.sub}}</small>{{else if this.packLabel}}<small>{{this.packLabel}}</small>{{/if}}
                        {{#if this.badges}}
                        <span class="resource-picker-card-badges">
                            {{#each this.badges}}<em class="{{this.cls}}">{{this.label}}</em>{{/each}}
                        </span>
                        {{/if}}
                    </span>
                    <span class="resource-picker-card-arrow"><i class="fas fa-arrow-up-right-from-square"></i></span>
                </button>
                {{else}}
                <div class="resource-picker-no-results">
                    <i class="fas fa-magnifying-glass"></i>
                    <p>{{localize "XJZL.CompendiumBrowser.State.NoFilteredItems"}}</p>
                </div>
                {{/each}}
            </div>
        </section>
    </div>
</div>
