<div class="resource-picker-body">
    <header class="resource-picker-header">
        <div>
            <h2><i class="fas fa-filter"></i> {{localize "XJZL.CharacterGenerator.ResourcePickerTitle"}} · {{tabLabel}}</h2>
            <p>{{hint}}</p>
        </div>
        <strong class="resource-picker-count">{{resultCount}} 项</strong>
    </header>

    <div class="resource-picker-layout">
        <aside class="resource-picker-filters">
            <label class="resource-picker-search">
                <span><i class="fas fa-search"></i> {{localize "XJZL.CompendiumBrowser.Filter.SearchPlaceholder"}}</span>
                <input type="search" data-picker-search value="{{searchQuery}}" autocomplete="off">
            </label>
            <div class="resource-picker-filter-heading">
                <span><i class="fas fa-sliders"></i> {{localize "XJZL.CompendiumBrowser.Filter.Label"}}</span>
                <button type="button" data-action="resetFilters">{{localize "XJZL.CompendiumBrowser.Filter.Reset"}}</button>
            </div>
            <div class="resource-picker-filter-list">
                {{#each filterList}}
                <details class="resource-picker-filter-group" {{#if this.isOpen}}open{{/if}}>
                    <summary>{{this.label}}</summary>
                    <div class="resource-picker-filter-options">
                        {{#each this.options}}
                        <label class="resource-picker-filter-option {{#if this.checked}}is-checked{{/if}}">
                            <input type="checkbox" data-picker-filter="{{../key}}" value="{{this.val}}" {{checked this.checked}}>
                            <span>{{this.label}}</span><small>{{this.count}}</small>
                        </label>
                        {{/each}}
                    </div>
                </details>
                {{else}}
                <p class="resource-picker-empty-note">{{localize "XJZL.CompendiumBrowser.Filter.NoFilters"}}</p>
                {{/each}}
            </div>
        </aside>

        <section class="resource-picker-results">
            <div class="resource-picker-result-heading">
                <span>{{#if hasMore}}显示 {{displayedCount}} / {{resultCount}} 项{{else}}全部 {{resultCount}} 项{{/if}}</span>
                {{#if hasMore}}<button type="button" class="resource-picker-load-more" data-action="loadMore">{{localize "XJZL.CharacterGenerator.ResourcePickerLoadMore"}}</button>{{/if}}
                {{#if (eq mode "range")}}<button type="button" class="resource-picker-apply" data-action="applyRange"><i class="fas fa-check"></i> {{localize "XJZL.CharacterGenerator.ApplyRange"}}</button>{{/if}}
            </div>
            <div class="resource-picker-card-grid">
                {{#each items}}
                <button type="button" class="resource-picker-card" {{#if (eq ../mode "resource")}}data-action="selectResource"{{/if}} data-uuid="{{this.uuid}}" data-tooltip="{{this.tooltip}}">
                    <img src="{{this.img}}" loading="lazy" alt="">
                    <span class="resource-picker-card-info">
                        <strong>{{this.name}}</strong>
                        {{#if this.sub}}<small>{{this.sub}}</small>{{else if this.packLabel}}<small>{{this.packLabel}}</small>{{/if}}
                        {{#if this.badges}}<span class="resource-picker-badges">{{#each this.badges}}<em class="{{this.cls}}">{{this.label}}</em>{{/each}}</span>{{/if}}
                    </span>
                </button>
                {{else}}
                <div class="resource-picker-no-results"><i class="fas fa-magnifying-glass"></i><p>{{localize "XJZL.CompendiumBrowser.State.NoFilteredItems"}}</p></div>
                {{/each}}
            </div>
        </section>
    </div>
</div>
