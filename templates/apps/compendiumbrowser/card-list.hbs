{{#each items}}
<div class="xjzl-cb-card {{#if (eq ../viewMode "grid")}}xjzl-cb-card-grid{{/if}}"
     data-uuid="{{this.uuid}}" data-action="openSheet" draggable="true"
     data-drag-data='{ "type": "Item", "uuid": "{{this.uuid}}" }'
     data-type="{{this.type}}" data-quality="{{this.system.quality}}" data-tier="{{this.system.tier}}"
     data-tooltip="{{this.tooltip}}" tabindex="0" aria-label="{{this.name}}">
    <img src="{{this.img}}" loading="lazy" alt="" />
    <div class="xjzl-cb-card-info">
        <div class="name">{{this.name}}</div>
        {{#if (eq ../viewMode "grid")}}
        <div class="cb-badges">
            {{#each this.badges}}<span class="cb-badge {{this.cls}}">{{this.label}}</span>{{/each}}
        </div>
        {{#if this.packLabel}}<div class="source">{{this.packLabel}}</div>{{/if}}
        {{else}}
        {{#if this.sub}}<div class="source">{{this.sub}}</div>{{else if this.packLabel}}<div class="source">{{this.packLabel}}</div>{{/if}}
        {{/if}}
    </div>
</div>
{{/each}}