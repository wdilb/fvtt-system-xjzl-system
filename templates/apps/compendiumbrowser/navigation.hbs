<div class="xjzl-nav-content">
    <div class="xjzl-nav-brand" title="江湖万卷阁">
        <i class="fas fa-book-open"></i>
    </div>
    <div class="xjzl-nav-divider"></div>
    <div class="xjzl-nav-tabs">
    {{#each tabs}}
    <button type="button" class="xjzl-cb-tab-btn {{#if (eq ../activeTab this.id)}}active{{/if}}" data-action="changeTab"
        data-tab="{{this.id}}">
        <i class="{{this.icon}}"></i><span class="xjzl-cb-tab-label">{{this.label}}</span>
    </button>
    {{/each}}
    </div>
    <button type="button" data-action="refresh" class="xjzl-cb-tab-btn xjzl-nav-refresh" title="刷新数据">
        <i class="fas fa-sync-alt"></i>
    </button>
</div>