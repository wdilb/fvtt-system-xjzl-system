<div class="xjzl-content-content">
    {{#unless isLoaded}}
    <div class="xjzl-cb-loading">
        <i class="fas fa-spinner fa-pulse"></i>
        <span>{{loadingText}}</span>
    </div>
    {{else}}
    <div class="xjzl-cb-stats-bar">
        <span class="stats-track">{{{statsFound}}}
            {{#if hasMore}}<span class="xjzl-cb-stats-shown warning">{{statsShown}}</span>{{/if}}
            {{#if reachedMax}}<span class="warning">{{limitText}}</span>{{/if}}
        </span>
        <span class="stats-controls">
            <label class="sort-control">
                <i class="fas fa-sort-amount-down" title="{{sortLabel}}"></i>
                <select name="sortBy" aria-label="{{sortLabel}}">
                    <option value="name" {{#if (eq sortBy "name")}}selected{{/if}}>{{sortName}}</option>
                    <option value="quality-desc" {{#if (eq sortBy "quality-desc")}}selected{{/if}}>{{sortQualityDesc}}</option>
                    <option value="quality-asc" {{#if (eq sortBy "quality-asc")}}selected{{/if}}>{{sortQualityAsc}}</option>
                </select>
            </label>
            <div class="view-toggle" role="group" aria-label="{{viewLabel}}">
                <button type="button" class="view-btn {{#if (eq viewMode "compact")}}active{{/if}}" data-action="toggleView"
                    data-view="compact" title="{{viewCompact}}" aria-pressed="{{#if (eq viewMode "compact")}}true{{else}}false{{/if}}">
                    <i class="fas fa-list"></i>
                </button>
                <button type="button" class="view-btn {{#if (eq viewMode "grid")}}active{{/if}}" data-action="toggleView"
                    data-view="grid" title="{{viewGrid}}" aria-pressed="{{#if (eq viewMode "grid")}}true{{else}}false{{/if}}">
                    <i class="fas fa-th-large"></i>
                </button>
            </div>
        </span>
    </div>

    <div class="xjzl-cb-grid {{#if (eq viewMode "grid")}}xjzl-cb-grid-wide{{/if}}">
        {{{cardListHtml}}}

        {{#unless totalCount}}
        <div class="no-results">
            <p>{{localize "XJZL.CompendiumBrowser.Filter.NoResults"}}</p>
        </div>
        {{else}}
        {{#if hasMore}}
        <div class="xjzl-cb-sentinel">
            <button type="button" class="load-more-btn" data-action="loadMore">{{loadMoreText}}</button>
        </div>
        {{else}}
        <div class="xjzl-cb-ended">{{#if reachedMax}}{{limitText}}{{else}}{{endedText}}{{/if}}</div>
        {{/if}}
        {{/unless}}
    </div>
    {{/unless}}
</div>
