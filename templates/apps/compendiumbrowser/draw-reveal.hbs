<div class="xjzl-draw-stage" data-rarity="{{highestRarity}}" data-phase="invitation" role="dialog" aria-modal="true"
    aria-label="{{localize 'XJZL.CompendiumBrowser.Draw.AriaLabel'}}" tabindex="-1">
    <div class="xjzl-draw-backdrop" aria-hidden="true">
        <div class="xjzl-draw-cinematic">
            <div class="xjzl-cinematic-scene scene-invitation"></div>
            <div class="xjzl-cinematic-scene scene-sword"></div>
            <div class="xjzl-cinematic-scene scene-rift"></div>
            <div class="xjzl-cinematic-scene scene-archive"></div>
            <div class="xjzl-cinematic-vignette"></div>
            <div class="xjzl-cinematic-atmosphere">
                <div class="xjzl-cinematic-volume-light"></div>
                <div class="xjzl-cinematic-jade-motes">
                    {{#each particles}}
                    <i style="--mote-x: {{this.x}}%; --mote-y: {{this.y}}%; --mote-delay: {{this.delay}}s; --mote-duration: {{this.duration}}s; --mote-size: {{this.size}}px;"></i>
                    {{/each}}
                </div>
                <div class="xjzl-cinematic-ink-feathers">
                    <i></i><i></i><i></i><i></i><i></i><i></i>
                </div>
                <canvas class="xjzl-cinematic-meteor-canvas"></canvas>
                <div class="xjzl-cinematic-sword-pressure">
                    <i></i><i></i>
                </div>
            </div>
            <div class="xjzl-cinematic-paper-cut"></div>
            <div class="xjzl-cinematic-flash"></div>
        </div>
        <div class="xjzl-draw-realm">
            <div class="xjzl-draw-realm-image"></div>
            <div class="xjzl-draw-realm-depth"></div>
        </div>
        <div class="xjzl-draw-ink-cloud ink-cloud-a"></div>
        <div class="xjzl-draw-ink-cloud ink-cloud-b"></div>
        <div class="xjzl-draw-radiance"></div>
        <div class="xjzl-draw-speed-lines"></div>
        <div class="xjzl-draw-particles">
            {{#each particles}}
            <i style="--particle-x: {{this.x}}%; --particle-y: {{this.y}}%; --particle-delay: {{this.delay}}s; --particle-duration: {{this.duration}}s; --particle-size: {{this.size}}px;"></i>
            {{/each}}
        </div>
    </div>

    <button type="button" class="xjzl-draw-skip" data-draw-action="skip">
        {{localize "XJZL.CompendiumBrowser.Draw.Skip"}} <i class="fas fa-forward"></i>
    </button>

    <div class="xjzl-cinematic-interface" aria-hidden="true">
        <div class="xjzl-cinematic-brand">
            <span>WANG JUAN ARCHIVE</span>
            <strong>{{localize "XJZL.CompendiumBrowser.Draw.CinematicBrand"}}</strong>
        </div>
        <div class="xjzl-cinematic-status">
            <i></i>
            <span>{{localize "XJZL.CompendiumBrowser.Draw.CinematicStatus"}}</span>
        </div>
        <div class="xjzl-cinematic-captions">
            <p data-cinematic-caption="invitation">{{localize "XJZL.CompendiumBrowser.Draw.SceneInvitation"}}</p>
            <p data-cinematic-caption="grasp">{{localize "XJZL.CompendiumBrowser.Draw.SceneGrasp"}}</p>
            <p data-cinematic-caption="sword">{{localize "XJZL.CompendiumBrowser.Draw.SceneSword"}}</p>
            <p data-cinematic-caption="rift">{{localize "XJZL.CompendiumBrowser.Draw.SceneRift"}}</p>
            <p data-cinematic-caption="archive">{{localize "XJZL.CompendiumBrowser.Draw.SceneArchive"}}</p>
        </div>
        <div class="xjzl-cinematic-progress">
            <i></i>
        </div>
    </div>

    {{#if useShowcase}}
    <section class="xjzl-draw-showcase" aria-live="polite">
        <div class="xjzl-showcase-progress">
            <span data-showcase-current>01</span>
            <i></i>
            <span>{{totalDisplay}}</span>
        </div>

        <div class="xjzl-showcase-items">
            {{#each items}}
            <article class="xjzl-showcase-item" data-showcase-index="{{@index}}" data-rarity="{{this.drawClass}}">
                <div class="xjzl-showcase-kanji" aria-hidden="true">侠</div>
                <div class="xjzl-showcase-energy" aria-hidden="true">
                    <i></i><i></i><i></i>
                </div>
                <div class="xjzl-showcase-portrait">
                    <span class="portrait-ring ring-a"></span>
                    <span class="portrait-ring ring-b"></span>
                    <img src="{{this.img}}" alt="">
                    <span class="portrait-shine"></span>
                </div>
                <div class="xjzl-showcase-copy">
                    <span class="xjzl-showcase-number">{{this.displayNumber}}</span>
                    <span class="xjzl-showcase-type">{{this.typeLabel}}</span>
                    <h2>{{this.name}}</h2>
                    <div class="xjzl-showcase-rarity">{{this.rarityLabel}}</div>
                    <div class="xjzl-showcase-marks" aria-hidden="true">
                        {{#each this.marks}}<i class="fas fa-diamond"></i>{{/each}}
                    </div>
                </div>
            </article>
            {{/each}}
        </div>

        <div class="xjzl-showcase-footer">
            <span>{{localize "XJZL.CompendiumBrowser.Draw.ShowcaseHint"}}</span>
            <button type="button" data-draw-action="showcase-next">
                <span data-showcase-next-label>{{localize "XJZL.CompendiumBrowser.Draw.NextItem"}}</span>
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </section>
    {{/if}}

    <section class="xjzl-draw-reveal" aria-live="polite">
        <header class="xjzl-draw-heading">
            <span>{{localize "XJZL.CompendiumBrowser.Draw.Eyebrow"}}</span>
            <h2>{{title}}</h2>
            <p>{{countText}}</p>
        </header>

        <div class="xjzl-draw-results {{#if isSingle}}is-single{{/if}} {{#if isLarge}}is-large{{/if}} {{#if isMassive}}is-massive{{/if}}">
            {{#each items}}
            <button type="button" class="xjzl-draw-card" data-rarity="{{this.drawClass}}" data-draw-uuid="{{this.uuid}}"
                style="--draw-order: {{this.order}};" aria-label="{{this.name}}，{{this.rarityLabel}}">
                <span class="draw-card-aura" aria-hidden="true"></span>
                <span class="draw-card-back" aria-hidden="true"><i>侠</i></span>
                <span class="draw-card-frame">
                    <span class="draw-card-corner corner-nw"></span>
                    <span class="draw-card-corner corner-ne"></span>
                    <span class="draw-card-corner corner-sw"></span>
                    <span class="draw-card-corner corner-se"></span>
                    <img src="{{this.img}}" alt="" loading="lazy" decoding="async">
                </span>
                <span class="draw-card-marks" aria-hidden="true">
                    {{#each this.marks}}<i class="fas fa-diamond"></i>{{/each}}
                </span>
                <span class="draw-card-rarity">{{this.rarityLabel}}</span>
                <strong>{{this.name}}</strong>
                <small>{{this.typeLabel}}</small>
            </button>
            {{/each}}
        </div>

        <footer class="xjzl-draw-footer">
            <span>{{localize "XJZL.CompendiumBrowser.Draw.ItemHint"}}</span>
            <button type="button" data-draw-action="accept">
                <i class="fas fa-scroll"></i> {{localize "XJZL.CompendiumBrowser.Draw.Accept"}}
            </button>
        </footer>
    </section>

    <div class="xjzl-draw-detail-scrim" data-draw-action="detail-close" aria-hidden="true"></div>
    <aside class="xjzl-draw-detail" data-rarity="quality-0" aria-hidden="true"
        aria-label="{{localize 'XJZL.CompendiumBrowser.Draw.DetailAriaLabel'}}">
        <button type="button" class="xjzl-draw-detail-close" data-draw-action="detail-close"
            aria-label="{{localize 'XJZL.CompendiumBrowser.Draw.CloseDetail'}}">
            <i class="fas fa-times"></i>
        </button>
        <div class="xjzl-draw-detail-visual">
            <div class="xjzl-draw-detail-halo" aria-hidden="true"></div>
            <img class="xjzl-draw-detail-image" src="" alt="">
            <div class="xjzl-draw-detail-seal" aria-hidden="true">录</div>
        </div>
        <div class="xjzl-draw-detail-copy">
            <span class="xjzl-draw-detail-kicker">{{localize "XJZL.CompendiumBrowser.Draw.DetailEyebrow"}}</span>
            <span class="xjzl-draw-detail-rarity"></span>
            <h3 class="xjzl-draw-detail-name"></h3>
            <div class="xjzl-draw-detail-meta">
                <span class="xjzl-draw-detail-type"></span>
                <span class="xjzl-draw-detail-marks" aria-hidden="true"></span>
            </div>
            <div class="xjzl-draw-detail-divider"></div>
            <div class="xjzl-draw-detail-description"></div>
        </div>
    </aside>
</div>
