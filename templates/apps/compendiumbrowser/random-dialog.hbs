<div class="xjzl-cb-random-dialog">
<div class="rd-fields">
    <div class="rd-row">
        <label class="rd-field" style="flex:1;">
            <span>{{amountLabel}}</span>
            <input type="number" name="amount" value="{{amount}}" min="1" max="50">
        </label>
        <label class="rd-field" style="flex:2;">
            <span>{{senderLabel}}</span>
            <input type="text" name="alias" value="{{alias}}">
        </label>
    </div>
    <label class="rd-field">
        <span>{{titleLabel}}</span>
        <input type="text" name="title" value="{{title}}">
    </label>
</div>
<fieldset class="rd-weights">
    <legend><i class="fas fa-balance-scale"></i> {{weightLegend}}</legend>
    <div class="rd-weight-grid {{#if isTier}}rd-weight-grid-tier{{/if}}">
        {{#each weights}}
        <div class="rd-weight-input">
            <span class="rd-weight-label" style="color:{{this.color}};">{{this.label}}</span>
            <input type="number" name="{{this.name}}" value="{{this.value}}" min="0">
        </div>
        {{/each}}
    </div>
</fieldset>
<p class="rd-pool">{{{poolLabel}}}</p>
</div>