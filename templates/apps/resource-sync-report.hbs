<div class="xjzl-resource-sync-report-root">
<header class="xjzl-resource-sync-header">
  <div>
    <div class="xjzl-resource-sync-kicker"><i class="fas fa-compass"></i> {{localize "XJZL.Settings.ResourceSync.Kicker"}}</div>
    <h2>{{localize "XJZL.Settings.ResourceSync.Header"}}</h2>
    <p>{{localize "XJZL.Settings.ResourceSync.Description"}}</p>
  </div>
  <button type="button" data-action="export" class="xjzl-resource-sync-export"><i class="fas fa-download"></i> {{localize "XJZL.Settings.ResourceSync.Export"}}</button>
</header>

<section class="xjzl-resource-sync-cards" aria-label="同步统计">
  {{#each cards}}
    <div class="xjzl-resource-sync-card {{key}}">
      <i class="fas {{icon}}"></i>
      <span class="value">{{value}}</span>
      <span class="label">{{label}}</span>
    </div>
  {{/each}}
</section>

<div class="xjzl-resource-sync-note"><i class="fas fa-circle-info"></i> {{localize "XJZL.Settings.ResourceSync.ScopePolicy"}}</div>
<div class="xjzl-resource-sync-note"><i class="fas fa-location-dot"></i> {{tokenPolicy}}</div>
{{#if fatalError}}<div class="xjzl-resource-sync-error"><i class="fas fa-triangle-exclamation"></i> {{fatalError}}</div>{{/if}}

<div class="xjzl-resource-sync-toolbar">
  <label><i class="fas fa-filter"></i><input class="xjzl-resource-sync-filter" type="search" placeholder="{{localize 'XJZL.Settings.ResourceSync.FilterPlaceholder'}}"></label>
  <span class="xjzl-resource-sync-time">{{generatedAtLabel}}</span>
</div>

<section class="xjzl-resource-sync-list">
  {{#each actors}}
    <details class="xjzl-resource-sync-actor" data-search="{{searchText}}" open>
      <summary>
        <span class="actor-name"><i class="fas fa-user-shield"></i> {{name}}</span>
        <span class="actor-summary">
          {{#each summary}}<b class="sync-mini {{status}}">{{count}}</b>{{/each}}
          <button type="button" data-action="openActor" data-uuid="{{actorUuid}}" title="{{localize 'XJZL.Settings.ResourceSync.OpenActor'}}"><i class="fas fa-external-link-alt"></i></button>
        </span>
      </summary>
      <div class="xjzl-resource-sync-items">
        {{#each items}}
          <article class="xjzl-resource-sync-item {{statusClass}}">
            <div class="item-main"><i class="fas {{icon}}"></i><strong>{{name}}</strong><span class="item-type">{{typeLabel}}</span></div>
            <span class="item-status">{{statusLabel}}</span>
            {{#if sourcePack}}<span class="item-source">{{sourcePack}}</span>{{/if}}
            {{#if details.length}}<div class="item-details">{{#each details}}<div>{{this}}</div>{{/each}}</div>{{/if}}
          </article>
        {{/each}}
      </div>
    </details>
  {{else}}
    <div class="xjzl-resource-sync-empty"><i class="fas fa-feather-pointed"></i><p>{{localize "XJZL.Settings.ResourceSync.Empty"}}</p></div>
  {{/each}}
</section>
</div>

