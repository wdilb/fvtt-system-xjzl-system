<div class="xjzl-action-panel">
    <!-- 顶部：名字与装饰区 -->
    <div class="panel-hero">
        <div class="hero-name">{{tokenName}}</div>
        <div class="hero-deco">
            <span class="deco-line"></span>
            <span class="deco-dot"></span>
            <span class="deco-line"></span>
        </div>
    </div>

    <!-- 底部：动作插槽 -->
    <div class="action-group">
        <!-- 主要动作 -->
        <div class="action-btn {{#if actions.major}}active{{/if}}" data-type="major" title="主要动作">
            <div class="item-ring"></div>
            <div class="item-text">主</div>
        </div>

        <!-- 次要动作 -->
        <div class="action-btn {{#if actions.minor}}active{{/if}}" data-type="minor" title="次要动作">
            <div class="item-ring"></div>
            <div class="item-text">次</div>
        </div>

        <!-- 反应动作 -->
        <div class="action-btn {{#if actions.reaction}}active{{/if}}" data-type="reaction" title="反应动作">
            <div class="item-ring"></div>
            <div class="item-text">反</div>
        </div>

        <!-- 简要动作 -->
        <div class="action-btn {{#if actions.swift}}active{{/if}}" data-type="swift" title="简要动作">
            <div class="item-ring"></div>
            <div class="item-text">简</div>
        </div>
    </div>
</div>