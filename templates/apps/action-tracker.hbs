<div class="xjzl-action-panel">
    <!-- 顶部：名字与装饰区 -->
    <div class="panel-hero">
        <div class="hero-name">{{tokenName}}</div>
        <div class="hero-deco">
            <span class="deco-line"></span>
            <span class="deco-dot"></span>
            <span class="deco-line"></span>
        </div>
    </div>

    <!-- 底部：动作插槽 -->
    <div class="action-group">
        <!-- 主要动作 -->
        <div class="action-btn {{#if actions.major}}active{{/if}}" data-type="major" data-tooltip="{{localize 'XJZL.UI.ActionTracker.Major'}}">
            <div class="item-ring"></div>
            <div class="item-text">{{localize "XJZL.UI.ActionTracker.MajorShort"}}</div>
        </div>

        <!-- 次要动作 -->
        <div class="action-btn {{#if actions.minor}}active{{/if}}" data-type="minor" data-tooltip="{{localize 'XJZL.UI.ActionTracker.Minor'}}">
            <div class="item-ring"></div>
            <div class="item-text">{{localize "XJZL.UI.ActionTracker.MinorShort"}}</div>
        </div>

        <!-- 反应动作 -->
        <div class="action-btn {{#if actions.reaction}}active{{/if}}" data-type="reaction" data-tooltip="{{localize 'XJZL.UI.ActionTracker.Reaction'}}">
            <div class="item-ring"></div>
            <div class="item-text">{{localize "XJZL.UI.ActionTracker.ReactionShort"}}</div>
        </div>

        <!-- 简要动作 -->
        <div class="action-btn {{#if actions.swift}}active{{/if}}" data-type="swift" data-tooltip="{{localize 'XJZL.UI.ActionTracker.Swift'}}">
            <div class="item-ring"></div>
            <div class="item-text">{{localize "XJZL.UI.ActionTracker.SwiftShort"}}</div>
        </div>
    </div>
</div>
