<div class="standard-form">
    <div class="form-group">
        <label>{{localize "XJZL.UI.AuraQuick.DisplayName"}}</label>
        <div class="form-fields">
            <input type="text" name="displayName" value="{{displayName}}" placeholder="{{localize 'XJZL.UI.AuraQuick.DefaultName'}}" />
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "XJZL.UI.AuraQuick.Radius"}}</label>
        <div class="form-fields">
            <input type="number" name="radius" value="{{radius}}" step="1" min="0" />
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "XJZL.UI.AuraQuick.Duration"}}</label>
        <div class="form-fields">
            <input type="number" name="duration" value="{{duration}}" step="1" min="0" />
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "XJZL.UI.AuraQuick.Color"}}</label>
        <div class="form-fields">
            <input type="color" name="color" value="{{color}}"
                style="height: 32px; width: 100%; border:none; padding:0; background:none; cursor:pointer;" />
        </div>
    </div>

    <hr style="border-color: #444; margin: 10px 0;">

    <div class="form-group">
        <label>{{localize "XJZL.UI.AuraQuick.Mode"}}</label>
        <div class="form-fields">
            <select name="mode" id="aura-mode-select">
                {{selectOptions modes selected=defaultMode}}
            </select>
        </div>
    </div>

    <div class="form-group" id="aura-token-select-group">
        <label>{{localize "XJZL.UI.AuraQuick.SourceToken"}}</label>
        <div class="form-fields">
            <select name="tokenId">
                {{selectOptions allTokens selected=selectedTokenId valueAttr="id" labelAttr="name"}}
            </select>
        </div>
    </div>

    <p class="notes" style="margin-top: 5px; font-size: 0.8em; color: #888;">
        <i class="fas fa-info-circle"></i> {{localize "XJZL.UI.AuraQuick.Hint"}}
    </p>

    <footer class="form-footer">
        <button type="button" data-action="confirm" class="save-button">
            <i class="fas fa-check"></i> {{localize "XJZL.UI.AuraQuick.Confirm"}}
        </button>
    </footer>
</div>
