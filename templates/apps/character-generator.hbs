<div class="character-generator-body">
    <header class="generator-toolbar">
        <div class="generator-toolbar-copy">
            <h2><i class="fas fa-dice-d20"></i> {{localize "XJZL.CharacterGenerator.Title"}}</h2>
            <p class="generator-hint">{{localize "XJZL.CharacterGenerator.Hint"}}</p>
        </div>
        <div class="generator-actions">
            <button type="button" data-action="generate" {{#if busy}}disabled{{/if}}><i class="fas fa-wand-magic-sparkles"></i> {{localize "XJZL.CharacterGenerator.Generate"}}</button>
            <button type="button" data-action="createAll" {{#unless canCreate}}disabled{{/unless}}><i class="fas fa-user-plus"></i> {{localize "XJZL.CharacterGenerator.Create"}}</button>
        </div>
    </header>

    <div class="generator-grid">
        <section class="generator-config generator-pane">
            <fieldset>
                <legend>{{localize "XJZL.CharacterGenerator.Basic"}}</legend>
                <div class="generator-form-grid">
                    <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.NamePrefix"}}</span><input name="namePrefix" value="{{config.namePrefix}}"></label>
                    <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.Quantity"}}</span><input type="number" name="quantity" min="1" max="20" value="{{config.quantity}}"></label>
                    <label class="generator-match-field"><span class="generator-field-label" data-tooltip="{{localize 'XJZL.CharacterGenerator.MatchDegreeHint'}}" data-tooltip-direction="UP">{{localize "XJZL.CharacterGenerator.MatchDegree"}} <i class="fas fa-circle-question"></i></span><div class="generator-range-control"><input type="range" name="synergyProbability" min="0" max="100" step="1" value="{{config.synergyProbability}}" data-match-slider><output data-match-value>{{config.synergyProbability}}%</output></div></label>
                    <label><span class="generator-field-label" data-tooltip="{{localize 'XJZL.CharacterGenerator.MatchStrategyHint'}}" data-tooltip-direction="UP">{{localize "XJZL.CharacterGenerator.MatchStrategy"}} <i class="fas fa-circle-question"></i></span><select name="matchStandard"><option value="loose" {{#if (eq config.matchStandard "loose")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Loose"}}</option><option value="standard" {{#if (eq config.matchStandard "standard")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.BalancedMatch"}}</option><option value="strict" {{#if (eq config.matchStandard "strict")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Strict"}}</option></select></label>
                    <label class="generator-check" data-tooltip="{{localize 'XJZL.CharacterGenerator.MatchAllRandomWuxueHint'}}"><input type="checkbox" name="matchAllRandomWuxue" {{checked config.matchAllRandomWuxue}}> {{localize "XJZL.CharacterGenerator.MatchAllRandomWuxue"}}</label>
                </div>
            </fieldset>

            <fieldset>
                <legend>{{localize "XJZL.CharacterGenerator.Neigong"}}</legend>
                <div class="generator-form-grid">
                    <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.CurrentNeigongTier"}}</span><select name="runTier"><option value="" {{#unless config.neigong.runTier}}selected{{/unless}}>{{localize "XJZL.CharacterGenerator.RandomTier"}}</option><option value="1" {{#if (eq config.neigong.runTier 1)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Human"}}</option><option value="2" {{#if (eq config.neigong.runTier 2)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Earth"}}</option><option value="3" {{#if (eq config.neigong.runTier 3)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Heaven"}}</option></select></label>
                    <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.Stage"}}</span><select name="runStage"><option value="">{{localize "XJZL.CharacterGenerator.Random"}}</option><option value="1" {{#if (eq config.neigong.runStage 1)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Awaken"}}</option><option value="2" {{#if (eq config.neigong.runStage 2)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Minor"}}</option><option value="3" {{#if (eq config.neigong.runStage 3)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Complete"}}</option></select></label>
                    <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.Element"}}</span><select name="runElement"><option value="auto" {{#if (eq config.neigong.runElement "auto")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Auto"}}</option><option value="yin" {{#if (eq config.neigong.runElement "yin")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Yin"}}</option><option value="yang" {{#if (eq config.neigong.runElement "yang")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Yang"}}</option><option value="taiji" {{#if (eq config.neigong.runElement "taiji")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Taiji"}}</option><option value="none" {{#if (eq config.neigong.runElement "none")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.NoElement"}}</option></select></label>
                </div>
                <div class="generator-resource-row"><span>{{rangeLabels.neigong}}</span><button type="button" data-action="openBrowser" data-kind="neigongRange" data-type="neigong"><i class="fas fa-filter"></i> {{localize "XJZL.CharacterGenerator.Range"}}</button><button type="button" data-action="openBrowser" data-kind="run" data-type="neigong"><i class="fas fa-bookmark"></i> {{localize "XJZL.CharacterGenerator.SpecifyRun"}}</button></div>
                <div class="generator-additional-config">
                    <label><span class="generator-field-label" data-tooltip="{{localize 'XJZL.CharacterGenerator.AdditionalCountHint'}}" data-tooltip-direction="UP">{{localize "XJZL.CharacterGenerator.AdditionalCount"}} <i class="fas fa-circle-question"></i></span><input type="number" name="additionalCount" data-additional-count min="0" max="10" value="{{config.neigong.additionalCount}}"></label>
                    <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.AdditionalRandomMin"}}</span><input type="number" name="neigongAdditionalRandomMin" min="0" max="10" value="{{config.neigong.additionalRandomMin}}"></label>
                    <label><span class="generator-field-label" data-tooltip="{{localize 'XJZL.CharacterGenerator.AdditionalRandomMaxHint'}}" data-tooltip-direction="UP">{{localize "XJZL.CharacterGenerator.AdditionalRandomMax"}} <i class="fas fa-circle-question"></i></span><input type="number" name="neigongAdditionalRandomMax" min="0" max="10" value="{{config.neigong.additionalRandomMax}}"></label>
                    <p class="generator-note">{{localize "XJZL.CharacterGenerator.OtherNeigongHint"}}</p>
                </div>
                {{#if (gt config.neigong.additionalCount 0)}}
                <div class="generator-neigong-groups">
                    {{#each additionalGroups}}
                    <article class="generator-neigong-group" data-neigong-group data-neigong-group-index="{{@index}}" data-neigong-group-id="{{this.id}}">
                        <header><strong>{{localize "XJZL.CharacterGenerator.OtherNeigong"}} {{this.number}}</strong><span>{{#if this.uuids.length}}{{localize "XJZL.CharacterGenerator.SpecifiedCount" count=1}}{{else}}{{localize "XJZL.CharacterGenerator.NotSpecified"}}{{/if}}</span></header>
                        <div class="generator-form-grid">
                            <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.Tier"}}</span><select data-neigong-field="tier"><option value="" {{#unless this.tier}}selected{{/unless}}>{{localize "XJZL.CharacterGenerator.RandomTier"}}</option><option value="1" {{#if (eq this.tier 1)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Human"}}</option><option value="2" {{#if (eq this.tier 2)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Earth"}}</option><option value="3" {{#if (eq this.tier 3)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Heaven"}}</option></select></label>
                            <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.Stage"}}</span><select data-neigong-field="stage"><option value="" {{#unless this.stage}}selected{{/unless}}>{{localize "XJZL.CharacterGenerator.Random"}}</option><option value="1" {{#if (eq this.stage 1)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Awaken"}}</option><option value="2" {{#if (eq this.stage 2)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Minor"}}</option><option value="3" {{#if (eq this.stage 3)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Complete"}}</option></select></label>
                        </div>
                        <div class="generator-resource-row"><span>{{#if this.resourceName}}{{this.resourceName}}{{else}}{{localize "XJZL.CharacterGenerator.RandomResource"}}{{/if}}</span><button type="button" data-action="openBrowser" data-kind="additional-{{@index}}" data-type="neigong"><i class="fas fa-bookmark"></i> {{localize "XJZL.CharacterGenerator.SpecifyResource"}}</button></div>
                    </article>
                    {{/each}}
                </div>
                {{else}}
                <p class="generator-empty-note">{{localize "XJZL.CharacterGenerator.NoOtherNeigong"}}</p>
                {{/if}}
                <label class="generator-check"><input type="checkbox" name="supplementForJingmai" {{checked config.neigong.supplementForJingmai}}> {{localize "XJZL.CharacterGenerator.AllowSupplement"}}</label>
            </fieldset>

            <fieldset>
                <legend>{{localize "XJZL.CharacterGenerator.Meridian"}}</legend>
                <div class="generator-form-grid">
                    <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.MeridianMode"}}</span><select name="jingmaiMode"><option value="none" {{#if (eq config.jingmai.mode "none")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.NoMeridian"}}</option><option value="target" {{#if (eq config.jingmai.mode "target")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.TargetMeridian"}}</option><option value="max" {{#if (eq config.jingmai.mode "max")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.MaxMeridian"}}</option></select></label>
                    <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.Total"}}</span><input type="number" name="jingmaiTotal" min="0" max="12" value="{{config.jingmai.total}}"></label><label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.YinMeridian"}}</span><input type="number" name="jingmaiYin" min="0" max="6" value="{{config.jingmai.yin}}"></label><label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.YangMeridian"}}</span><input type="number" name="jingmaiYang" min="0" max="6" value="{{config.jingmai.yang}}"></label>
                </div>
                <div class="generator-meridian-grid"><span class="generator-label">{{localize "XJZL.CharacterGenerator.MeridianFixed"}}</span>{{#each meridianOptions}}<label class="generator-check"><input type="checkbox" data-jingmai-fixed="{{this.key}}" {{checked this.checked}}> {{localize this.label}}</label>{{/each}}</div>
                <label class="generator-check"><input type="checkbox" name="jingmaiAutoSupplement" {{checked config.jingmai.autoSupplement}}> {{localize "XJZL.CharacterGenerator.AutoMeridian"}}</label><label class="generator-check"><input type="checkbox" name="xuanguanBroken" {{checked config.jingmai.xuanguanBroken}}> {{localize "XJZL.CharacterGenerator.Xuanguan"}}</label>
            </fieldset>

            <fieldset>
                <legend>{{localize "XJZL.CharacterGenerator.Wuxue"}}</legend>
                <div class="generator-wuxue-primary generator-subsection">
                    <div class="generator-subsection-heading"><h4>{{localize "XJZL.CharacterGenerator.PrimaryWuxue"}}</h4><span class="generator-note">{{localize "XJZL.CharacterGenerator.PrimaryHint"}}</span></div>
                    <div class="generator-form-grid">
                        <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.PrimaryTier"}}</span><select name="primaryTier"><option value="" {{#unless primaryTier}}selected{{/unless}}>{{localize "XJZL.CharacterGenerator.RandomTier"}}</option><option value="1" {{#if (eq primaryTier 1)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Human"}}</option><option value="2" {{#if (eq primaryTier 2)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Earth"}}</option><option value="3" {{#if (eq primaryTier 3)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Heaven"}}</option></select></label>
                        <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.PrimaryStage"}}</span><select name="primaryStage"><option value="">{{localize "XJZL.CharacterGenerator.Random"}}</option><option value="1" {{#if (eq primaryStage 1)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Awaken"}}</option><option value="2" {{#if (eq primaryStage 2)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Master"}}</option><option value="3" {{#if (eq primaryStage 3)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Perfect"}}</option><option value="4" {{#if (eq primaryStage 4)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Unity"}}</option></select><small class="generator-field-help">{{localize "XJZL.CharacterGenerator.PrimaryStageHint"}}</small></label>
                        <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.Allocation"}}</span><select name="allocation"><option value="uniform" {{#if (eq config.wuxue.allocation "uniform")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Uniform"}}</option><option value="core" {{#if (eq config.wuxue.allocation "core")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.CoreFirst"}}</option><option value="independent" {{#if (eq config.wuxue.allocation "independent")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Independent"}}</option></select><small class="generator-field-help">{{localize "XJZL.CharacterGenerator.AllocationHint"}}</small></label>
                    </div>
                    <div class="generator-resource-row"><span>{{rangeLabels.wuxue}}</span><button type="button" data-action="openBrowser" data-kind="wuxueRange" data-type="wuxue"><i class="fas fa-filter"></i> {{localize "XJZL.CharacterGenerator.Range"}}</button><button type="button" data-action="openBrowser" data-kind="primary" data-type="wuxue"><i class="fas fa-bookmark"></i> {{localize "XJZL.CharacterGenerator.SpecifyPrimary"}} ({{#if primarySpecified}}1{{else}}0{{/if}})</button></div>
                    {{#if moveLocks.length}}<div class="generator-locks"><strong>{{localize "XJZL.CharacterGenerator.MoveLocks"}}</strong><span class="generator-note">{{localize "XJZL.CharacterGenerator.MoveLocksHint"}}</span>{{#each moveLocks}}<label><span class="generator-field-label">{{this.name}}</span><select data-move-lock="{{this.id}}"><option value="" {{#if (eq this.stage "")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Random"}}</option><option value="1" {{#if (eq this.stage 1)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Awaken"}}</option><option value="2" {{#if (eq this.stage 2)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Master"}}</option><option value="3" {{#if (eq this.stage 3)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Perfect"}}</option><option value="4" {{#if (eq this.stage 4)}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Unity"}}</option></select></label>{{/each}}</div>{{/if}}
                    <div class="generator-healing"><label class="generator-check"><input type="checkbox" name="healingRequired" {{checked config.wuxue.healingRequired}}> {{localize "XJZL.CharacterGenerator.HealingRequired"}}</label><label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.HealingCount"}}</span><input type="number" name="healingCount" min="1" value="{{config.wuxue.healingCount}}"></label><label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.HealingUuids"}}</span><input name="healingUuids" value="{{healingUuidsText}}"></label><button type="button" data-action="openBrowser" data-kind="healing" data-type="wuxue"><i class="fas fa-book-medical"></i> {{localize "XJZL.CharacterGenerator.SpecifyHealing"}}</button></div>
                </div>
                <div class="generator-wuxue-additional generator-subsection">
                    <div class="generator-subsection-heading"><h4>{{localize "XJZL.CharacterGenerator.OtherWuxue"}}</h4><span class="generator-note">{{localize "XJZL.CharacterGenerator.OtherWuxueHint"}}</span></div>
                    <div class="generator-form-grid">
                        <div class="generator-tier-counts"><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.OtherWuxueFixedCounts"}}</span><span class="generator-note">{{localize "XJZL.CharacterGenerator.OtherWuxueFixedCountsHint"}}</span><div class="generator-tier-count-grid">{{#each mainTierOptions}}<label><span>{{this.label}}</span><input type="number" data-main-tier-count="{{this.key}}" min="0" max="20" value="{{this.count}}"></label>{{/each}}</div></div>
                        <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.OtherWuxueRandomMin"}}</span><input type="number" name="wuxueAdditionalRandomMin" min="0" max="20" value="{{mainRandomMin}}"></label>
                        <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.OtherWuxueRandomMax"}}</span><input type="number" name="wuxueAdditionalRandomMax" min="0" max="20" value="{{mainRandomMax}}"></label>
                        <label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.SanshouCount"}}</span><input type="number" name="sanshouCount" min="0" value="{{config.wuxue.sanshouCount}}"></label><label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.QinggongCount"}}</span><input type="number" name="qinggongCount" min="0" value="{{config.wuxue.qinggongCount}}"></label><label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.ZhenfaCount"}}</span><input type="number" name="zhenfaCount" min="0" value="{{config.wuxue.zhenfaCount}}"></label><label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.WuxingLimit"}}</span><input type="number" name="wuxingLimit" min="0" placeholder="{{localize 'XJZL.CharacterGenerator.Unlimited'}}" value="{{config.wuxue.wuxingLimit}}"></label>
                    </div>
                    <div class="generator-resource-row"><span>{{localize "XJZL.CharacterGenerator.SpecifyAuxiliary"}}</span><button type="button" data-action="openBrowser" data-kind="sanshou" data-type="wuxue">{{localize "XJZL.CharacterGenerator.SpecifySanshou"}} ({{config.wuxue.fixed.sanshou.length}})</button><button type="button" data-action="clearResource" data-kind="sanshou" {{#unless config.wuxue.fixed.sanshou.length}}disabled{{/unless}}>{{localize "XJZL.CharacterGenerator.ClearSpecified"}}</button><button type="button" data-action="openBrowser" data-kind="qinggong" data-type="wuxue">{{localize "XJZL.CharacterGenerator.SpecifyQinggong"}} ({{config.wuxue.fixed.qinggong.length}})</button><button type="button" data-action="clearResource" data-kind="qinggong" {{#unless config.wuxue.fixed.qinggong.length}}disabled{{/unless}}>{{localize "XJZL.CharacterGenerator.ClearSpecified"}}</button><button type="button" data-action="openBrowser" data-kind="zhenfa" data-type="wuxue">{{localize "XJZL.CharacterGenerator.SpecifyZhenfa"}} ({{config.wuxue.fixed.zhenfa.length}})</button><button type="button" data-action="clearResource" data-kind="zhenfa" {{#unless config.wuxue.fixed.zhenfa.length}}disabled{{/unless}}>{{localize "XJZL.CharacterGenerator.ClearSpecified"}}</button></div>
                </div>
            </fieldset>

            <fieldset>
                <legend>{{localize "XJZL.CharacterGenerator.StatsEquipment"}}</legend>
                <div class="generator-form-grid"><label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.StatsStrategy"}}</span><select name="statsStrategy"><option value="balanced" {{#if (eq config.stats.strategy "balanced")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Balanced"}}</option><option value="match" {{#if (eq config.stats.strategy "match")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Match"}}</option><option value="output" {{#if (eq config.stats.strategy "output")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Output"}}</option><option value="survival" {{#if (eq config.stats.strategy "survival")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Survival"}}</option><option value="random" {{#if (eq config.stats.strategy "random")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Random"}}</option></select></label><label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.FreePoints"}}</span><input type="number" name="freePoints" min="0" value="{{config.stats.freePoints}}"></label></div>
                <div class="generator-resource-row"><span>{{rangeLabels.weapon}}</span><button type="button" data-action="openBrowser" data-kind="weaponRange" data-type="weapon"><i class="fas fa-filter"></i> {{localize "XJZL.CharacterGenerator.WeaponRange"}}</button><button type="button" data-action="openBrowser" data-kind="weapon" data-type="weapon"><i class="fas fa-bookmark"></i> {{localize "XJZL.CharacterGenerator.SpecifyWeapon"}}</button></div>
                <div class="generator-form-grid"><label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.WeaponType"}}</span><select name="weaponType"><option value="auto" {{#if (eq config.wuxue.weaponType "auto")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.Auto"}}</option><option value="sword" {{#if (eq config.wuxue.weaponType "sword")}}selected{{/if}}>{{localize "XJZL.Combat.Rank.Sword"}}</option><option value="blade" {{#if (eq config.wuxue.weaponType "blade")}}selected{{/if}}>{{localize "XJZL.Combat.Rank.Blade"}}</option><option value="staff" {{#if (eq config.wuxue.weaponType "staff")}}selected{{/if}}>{{localize "XJZL.Combat.Rank.Staff"}}</option><option value="dagger" {{#if (eq config.wuxue.weaponType "dagger")}}selected{{/if}}>{{localize "XJZL.Combat.Rank.Dagger"}}</option><option value="hidden" {{#if (eq config.wuxue.weaponType "hidden")}}selected{{/if}}>{{localize "XJZL.Combat.Rank.Hidden"}}</option><option value="instrument" {{#if (eq config.wuxue.weaponType "instrument")}}selected{{/if}}>{{localize "XJZL.Combat.Rank.Instrument"}}</option><option value="special" {{#if (eq config.wuxue.weaponType "special")}}selected{{/if}}>{{localize "XJZL.Combat.Rank.Special"}}</option><option value="unarmed" {{#if (eq config.wuxue.weaponType "unarmed")}}selected{{/if}}>{{localize "XJZL.Combat.Rank.Unarmed"}}</option><option value="none" {{#if (eq config.wuxue.weaponType "none")}}selected{{/if}}>{{localize "XJZL.Combat.Rank.None"}}</option></select></label><label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.WeaponQuality"}}</span><select name="weaponQuality"><option value="0" {{#if (eq config.equipment.weaponQuality 0)}}selected{{/if}}>凡</option><option value="1" {{#if (eq config.equipment.weaponQuality 1)}}selected{{/if}}>铜</option><option value="2" {{#if (eq config.equipment.weaponQuality 2)}}selected{{/if}}>银</option><option value="3" {{#if (eq config.equipment.weaponQuality 3)}}selected{{/if}}>金</option><option value="4" {{#if (eq config.equipment.weaponQuality 4)}}selected{{/if}}>玉</option></select></label><label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.ArmorQuality"}}</span><select name="armorQuality"><option value="0" {{#if (eq config.equipment.armorQuality 0)}}selected{{/if}}>凡</option><option value="1" {{#if (eq config.equipment.armorQuality 1)}}selected{{/if}}>铜</option><option value="2" {{#if (eq config.equipment.armorQuality 2)}}selected{{/if}}>银</option><option value="3" {{#if (eq config.equipment.armorQuality 3)}}selected{{/if}}>金</option><option value="4" {{#if (eq config.equipment.armorQuality 4)}}selected{{/if}}>玉</option></select></label></div>
                <div class="generator-form-grid"><label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.ArmorMinCount"}}</span><input type="number" name="armorMinCount" min="{{armorRequiredCount}}" max="14" value="{{config.equipment.armorMinCount}}"><small class="generator-field-help">{{localize "XJZL.CharacterGenerator.ArmorMinCountHint"}}</small></label><label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.ArmorFillMode"}}</span><select name="armorFillMode"><option value="random" {{#if (eq config.equipment.armorFillMode "random")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.ArmorFillRandom"}}</option><option value="minimum" {{#if (eq config.equipment.armorFillMode "minimum")}}selected{{/if}}>{{localize "XJZL.CharacterGenerator.ArmorFillMinimum"}}</option></select></label>{{#if (eq config.equipment.armorFillMode "random")}}<label><span class="generator-field-label">{{localize "XJZL.CharacterGenerator.ArmorRandomExtraMax"}}</span><input type="number" name="armorRandomExtraMax" min="0" max="14" value="{{config.equipment.armorRandomExtraMax}}"><small class="generator-field-help">{{localize "XJZL.CharacterGenerator.ArmorRandomExtraMaxHint"}}</small></label>{{/if}}</div>
                <div class="generator-armor-types"><span class="generator-label">{{localize "XJZL.CharacterGenerator.ArmorTypes"}}</span><span class="generator-note">{{localize "XJZL.CharacterGenerator.ArmorTypesHint"}}</span><div class="generator-armor-type-grid">{{#each armorOptions}}<div class="generator-armor-type"><label class="generator-check"><input type="checkbox" data-armor-type="{{this.key}}" {{checked this.checked}}> <span>{{this.label}}</span></label>{{#if (and this.checked this.multi)}}<input type="number" data-armor-type-count="{{this.key}}" min="1" max="{{this.max}}" value="{{this.count}}" title="{{this.label}}数量">{{/if}}</div>{{/each}}</div></div>
                <div class="generator-resource-row"><span>{{#if config.equipment.armorUuids.length}}{{localize "XJZL.CharacterGenerator.ArmorSpecified" count=config.equipment.armorUuids.length}}{{else}}{{localize "XJZL.CharacterGenerator.ArmorNone"}}{{/if}}</span><button type="button" data-action="openBrowser" data-kind="armor" data-type="armor"><i class="fas fa-bookmark"></i> {{localize "XJZL.CharacterGenerator.SpecifyArmor"}}</button><button type="button" data-action="clearResource" data-kind="armor" {{#unless config.equipment.armorUuids.length}}disabled{{/unless}}>{{localize "XJZL.CharacterGenerator.ClearSpecified"}}</button></div><div class="generator-resource-row"><span>{{rangeLabels.armor}}</span><button type="button" data-action="openBrowser" data-kind="armorRange" data-type="armor"><i class="fas fa-filter"></i> {{localize "XJZL.CharacterGenerator.ArmorRange"}}</button></div><p class="generator-note">{{localize "XJZL.CharacterGenerator.EquipmentNote"}}</p>
            </fieldset>
        </section>

        <section class="generator-preview generator-pane">
            <div class="preview-header"><h3><i class="fas fa-scroll"></i> {{localize "XJZL.CharacterGenerator.Preview"}}</h3>{{#if busy}}<span class="generator-busy"><i class="fas fa-spinner fa-pulse"></i> <span data-progress-text>{{progressText}}</span></span>{{/if}}</div>
            {{#if dirty}}<div class="generator-warning"><i class="fas fa-rotate"></i> {{localize "XJZL.CharacterGenerator.PreviewDirty"}}</div>{{/if}}
            {{#if conflicts}}<div class="generator-conflicts"><h4><i class="fas fa-triangle-exclamation"></i> {{localize "XJZL.CharacterGenerator.ConstraintsFailed"}}</h4>{{#each conflicts}}<div class="conflict-row"><span class="conflict-type">{{this.type}}</span>{{#if this.draftName}}<strong>{{this.draftName}}</strong> · {{/if}}<strong>{{this.fieldLabel}}</strong>：{{this.reason}}（期望 {{this.expectedText}}，实际 {{this.actualText}}）</div>{{/each}}</div>{{/if}}
            {{#if warnings}}<div class="generator-warning"><h4>{{localize "XJZL.CharacterGenerator.MatchWarnings"}}</h4>{{#each warnings}}<div><strong>{{this.draftName}} · {{this.fieldLabel}}</strong>：{{this.reason}}（期望 {{this.expectedText}}，实际 {{this.actualText}}）</div>{{/each}}</div>{{/if}}
            {{#each draft}}
            <div class="draft-tier-summary"><b>{{localize "XJZL.CharacterGenerator.PrimarySummary"}}</b>：{{#if this.primary}}{{this.primary.name}}（{{this.primary.tier}}级，实际 {{this.primary.actualStage}} 重）{{else}}未选{{/if}}；<b>{{localize "XJZL.CharacterGenerator.OtherWuxueSummary"}}</b>：人武 {{lookup this.additionalWuxueTierCounts "1"}}、地武 {{lookup this.additionalWuxueTierCounts "2"}}、天武 {{lookup this.additionalWuxueTierCounts "3"}}</div>
            <article class="draft-card"><header><strong>{{this.name}}</strong><span>{{this.status}}</span></header><div class="draft-summary"><div><b>{{localize "XJZL.CharacterGenerator.RunNeigong"}}</b>：{{this.runNeigong.name}}</div><div><b>{{localize "XJZL.CharacterGenerator.MeridianSummary"}}</b>：{{this.jingmai.selected.length}} 条{{#if this.jingmai.adjustments}}（含补功/升级）{{/if}}</div><div><b>{{localize "XJZL.CharacterGenerator.PrimarySummary"}}</b>：{{#if this.primary}}{{this.primary.name}}{{else}}未选{{/if}}；<b>{{localize "XJZL.CharacterGenerator.OtherWuxueSummary"}}</b>：{{this.additionalWuxueCount}} 套；<b>散手</b>：{{this.wuxueCounts.sanshou}} 套；<b>轻功</b>：{{this.wuxueCounts.qinggong}} 套；<b>阵法</b>：{{this.wuxueCounts.zhenfa}} 套；<b>{{localize "XJZL.CharacterGenerator.WuxingSummary"}}</b>：{{this.wuxing.total}}</div><div><b>{{localize "XJZL.CharacterGenerator.HealingSummary"}}</b>：{{this.healing.count}} 套{{#if this.config.wuxue.healingRequired}}／{{localize "XJZL.CharacterGenerator.Requirement"}} {{this.config.wuxue.healingCount}}{{/if}}</div><div><b>{{localize "XJZL.CharacterGenerator.StatsSummary"}}</b>：{{this.evaluation.derived.assignedPoints}} / {{this.stats.availableFreePoints}}；<b>{{localize "XJZL.CharacterGenerator.WeaponSummary"}}</b>：{{this.equipment.weapon.name}}；<b>{{localize "XJZL.CharacterGenerator.ArmorSummary"}}</b>：{{this.equipment.armor.length}} 件</div></div><details><summary>{{localize "XJZL.CharacterGenerator.Details"}}</summary><div class="draft-details">{{#if this.primary}}<div>{{localize "XJZL.CharacterGenerator.PrimarySummary"}}：{{this.primary.name}}（{{this.primary.tier}}级，目标 {{this.primary.targetStage}} 重，实际 {{this.primary.actualStage}} 重）</div>{{/if}}{{#each this.neigong}}<div>{{localize "XJZL.CharacterGenerator.NeigongSummary"}}：{{this.name}}（{{this.stage}} 重）</div>{{/each}}{{#each this.wuxue}}<div>{{localize "XJZL.CharacterGenerator.WuxueSummary"}}：{{this.name}}（{{this.tier}}级，目标 {{this.targetStage}} 重，实际 {{this.actualStage}} 重；{{localize "XJZL.CharacterGenerator.CoreSummary"}}：{{this.core}}）</div>{{#each this.operations}}<div class="generator-operation">辅助操作：{{this.name}}（{{#if (gt this.level 0)}}可用{{else}}未学{{/if}}）</div>{{/each}}{{/each}}{{#each this.healing.items}}<div>实际治疗：{{this.item.name}}（{{#each this.moves}}{{this.name}}{{#unless @last}}、{{/unless}}{{/each}}）</div>{{/each}}{{#each this.decisions}}<div>{{localize "XJZL.CharacterGenerator.MatchSummary"}}：{{this.result}} {{#if this.compatibility}}{{localize "XJZL.CharacterGenerator.CompatibilitySummary"}} {{this.compatibility}}／{{localize "XJZL.CharacterGenerator.ScalingSummary"}} {{this.scaling}}{{/if}}</div>{{/each}}{{#if this.evaluation.derived}}<div>{{localize "XJZL.CharacterGenerator.EvaluationSummary"}}：{{localize "XJZL.CharacterGenerator.HPMax"}} {{this.evaluation.derived.hpMax}}，{{localize "XJZL.CharacterGenerator.MPMax"}} {{this.evaluation.derived.mpMax}}，{{localize "XJZL.CharacterGenerator.ActualPool"}} {{this.stats.availableFreePoints}}</div>{{/if}}</div></details></article>
            {{else}}
            <div class="preview-empty"><i class="fas fa-feather-pointed"></i><p>{{localize "XJZL.CharacterGenerator.ReadyHint"}}</p></div>
            {{/each}}
            {{#if createResults}}<div class="create-results"><h4>{{localize "XJZL.CharacterGenerator.CreateResults"}}</h4>{{#each createResults}}<div class="create-result {{this.status}}"><span>{{this.status}}</span> {{this.actor.name}} {{this.reason}}</div>{{/each}}</div>{{/if}}
        </section>
    </div>
</div>
