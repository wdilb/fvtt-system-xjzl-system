{{!-- 野兽检定后果配置列（在配置编辑器的两列对照布局内渲染）。
prefix 指向一个 checkOutcome 数据节点（save.fail / save.success / contest.win / contest.lose）。
列内容按作用对象分小节："作用于目标" 恒有；"作用于野兽" 仅对抗模式渲染
（豁免管线的后果固定作用于掷骰目标，无法配置给发起者）。--}}
<input type="text" class="check-outcome-text" name="{{prefix}}.text" value="{{outcome.text}}"
    placeholder="{{localize "XJZL.Creature.Check.TextPlaceholder"}}"
    data-tooltip="{{localize "XJZL.Creature.Check.Text"}}" />

{{!-- 小节一：作用于目标 --}}
<div class="col-section target-side">
    <div class="col-section-head target">{{localize "XJZL.Creature.Check.TargetSection"}}</div>

    {{> "systems/xjzl-system/templates/apps/partials/check-damage.hbs"
        prefix=(concat prefix ".damage") damage=outcome.damage }}

    <div class="check-effects-row">
        <span class="check-effects-label">{{localize "XJZL.Creature.Check.Effects"}}</span>
        {{#each outcome.effects as |eid|}}
        <span class="check-effect-chip">
            {{lookup @root.statusNames eid}}
            <a data-action="removeCheckEffect" data-path="{{../prefix}}.effects" data-id="{{eid}}"
                data-tooltip="{{localize "XJZL.Creature.Check.RemoveEffect"}}"><i class="fas fa-times"></i></a>
        </span>
        {{/each}}
        <a class="check-effect-add" data-action="pickCheckEffects" data-path="{{prefix}}.effects"
            data-tooltip="{{localize "XJZL.Creature.Check.AddEffectHint"}}">
            <i class="fas fa-plus"></i>
        </a>
    </div>
    {{#if outcome.effects.length}}
    <div class="check-effect-options">
        <label class="effect-stack-toggle" data-tooltip="{{localize "XJZL.Creature.Check.EffectStackableHint"}}">
            <input type="checkbox" name="{{prefix}}.effectStackable" {{checked outcome.effectStackable}} />
            {{localize "XJZL.Creature.Check.EffectStackable"}}
        </label>
        <label data-tooltip="{{localize "XJZL.Creature.Check.EffectCountHint"}}">
            {{localize "XJZL.Creature.Check.EffectCount"}}
            <input type="number" name="{{prefix}}.effectCount" value="{{outcome.effectCount}}" min="1" step="1" />
        </label>
        {{#if outcome.effectStackable}}
        <label data-tooltip="{{localize "XJZL.Creature.Check.EffectMaxStacksHint"}}">
            {{localize "XJZL.Creature.Check.EffectMaxStacks"}}
            <input type="number" name="{{prefix}}.effectMaxStacks" value="{{outcome.effectMaxStacks}}" min="0" step="1" />
        </label>
        {{/if}}
        <label data-tooltip="{{localize "XJZL.Creature.Check.EffectDurationHint"}}">
            {{localize "XJZL.Creature.Check.EffectDuration"}}
            <input type="number" name="{{prefix}}.effectDuration.value" value="{{outcome.effectDuration.value}}" min="0" step="1" />
            <span class="effect-unit">回合</span>
        </label>
    </div>
    {{/if}}

    {{#unless isContest}}
    {{!-- 豁免特有：判定后解除目标的架招（同样作用于目标）--}}
    <label class="check-inline-toggle" data-tooltip="{{localize "XJZL.Creature.Check.RemoveStanceHint"}}">
        <input type="checkbox" name="{{prefix}}.removeStance" {{checked outcome.removeStance}} />
        {{localize "XJZL.Creature.Check.RemoveStance"}}
    </label>
    {{/unless}}
</div>

{{#if isContest}}
{{!-- 小节二：作用于野兽（对抗特有：反噬/自伤、自身状态、自身恢复；不需要就留空）--}}
<div class="col-section self-side">
    <div class="col-section-head self">{{localize "XJZL.Creature.Check.SelfSection"}}</div>

    {{> "systems/xjzl-system/templates/apps/partials/check-damage.hbs"
        prefix=(concat prefix ".selfDamage") damage=outcome.selfDamage
        label=(localize "XJZL.Creature.Check.SelfDamage") }}

    <div class="check-effects-row">
        <span class="check-effects-label">{{localize "XJZL.Creature.Check.SelfEffects"}}</span>
        {{#each outcome.selfEffects as |eid|}}
        <span class="check-effect-chip">
            {{lookup @root.statusNames eid}}
            <a data-action="removeCheckEffect" data-path="{{../prefix}}.selfEffects" data-id="{{eid}}"
                data-tooltip="{{localize "XJZL.Creature.Check.RemoveEffect"}}"><i class="fas fa-times"></i></a>
        </span>
        {{/each}}
        <a class="check-effect-add" data-action="pickCheckEffects" data-path="{{prefix}}.selfEffects"
            data-tooltip="{{localize "XJZL.Creature.Check.AddEffectHint"}}">
            <i class="fas fa-plus"></i>
        </a>
    </div>
    {{#if outcome.selfEffects.length}}
    <div class="check-effect-options">
        <label class="effect-stack-toggle" data-tooltip="{{localize "XJZL.Creature.Check.EffectStackableHint"}}">
            <input type="checkbox" name="{{prefix}}.selfEffectStackable" {{checked outcome.selfEffectStackable}} />
            {{localize "XJZL.Creature.Check.EffectStackable"}}
        </label>
        <label data-tooltip="{{localize "XJZL.Creature.Check.EffectCountHint"}}">
            {{localize "XJZL.Creature.Check.EffectCount"}}
            <input type="number" name="{{prefix}}.selfEffectCount" value="{{outcome.selfEffectCount}}" min="1" step="1" />
        </label>
        {{#if outcome.selfEffectStackable}}
        <label data-tooltip="{{localize "XJZL.Creature.Check.EffectMaxStacksHint"}}">
            {{localize "XJZL.Creature.Check.EffectMaxStacks"}}
            <input type="number" name="{{prefix}}.selfEffectMaxStacks" value="{{outcome.selfEffectMaxStacks}}" min="0" step="1" />
        </label>
        {{/if}}
        <label data-tooltip="{{localize "XJZL.Creature.Check.EffectDurationHint"}}">
            {{localize "XJZL.Creature.Check.EffectDuration"}}
            <input type="number" name="{{prefix}}.selfEffectDuration.value" value="{{outcome.selfEffectDuration.value}}" min="0" step="1" />
            <span class="effect-unit">回合</span>
        </label>
    </div>
    {{/if}}

    <div class="check-recovery-row">
        <span class="check-damage-label">{{localize "XJZL.Creature.Check.SelfRecovery"}}</span>
        <input type="number" name="{{prefix}}.selfRecovery.value" value="{{outcome.selfRecovery.value}}" min="0"
            placeholder="0" data-tooltip="{{localize "XJZL.Creature.Check.RecoveryValueHint"}}" />
        <select name="{{prefix}}.selfRecovery.type">
            {{selectOptions @root.choices.resourceTypes selected=outcome.selfRecovery.type}}
        </select>
    </div>
</div>
{{/if}}
