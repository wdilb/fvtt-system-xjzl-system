{{!-- 野兽检定后果的一笔伤害/流失配置。
prefix 指向 checkOutcome.damage（或 contestOutcome.selfDamage）节点；
value>0 才会在发起时生成该笔后果；type 属于系统伤害类型走 applyDamage 抗性结算，资源键走直接流失。--}}
<div class="check-damage-config">
    {{#if label}}<span class="check-damage-label">{{label}}</span>{{/if}}
    <input type="number" name="{{prefix}}.value" value="{{damage.value}}" min="0" placeholder="0"
        data-tooltip="{{localize "XJZL.Creature.Check.DamageValue"}}" />
    <select name="{{prefix}}.type" data-tooltip="{{localize "XJZL.Wuxue.Moves.DamageType"}}">
        {{selectOptions @root.choices.outcomeTypes selected=damage.type}}
    </select>
    <details class="check-advanced">
        <summary>{{localize "XJZL.Creature.Check.Advanced"}}</summary>
        <div class="check-advanced-grid">
            <label data-tooltip="{{localize "XJZL.Creature.Check.IsCritHint"}}">
                <input type="checkbox" name="{{prefix}}.isCrit" {{checked damage.isCrit}} />
                {{localize "XJZL.Creature.Check.IsCrit"}}
            </label>
            <label>
                <input type="checkbox" name="{{prefix}}.applyCritDamage" {{checked damage.applyCritDamage}} />
                {{localize "XJZL.Creature.Check.ApplyCritDamage"}}
            </label>
            <label>
                <input type="checkbox" name="{{prefix}}.ignoreBlock" {{checked damage.ignoreBlock}} />
                {{localize "XJZL.Creature.Check.IgnoreBlock"}}
            </label>
            <label>
                <input type="checkbox" name="{{prefix}}.ignoreDefense" {{checked damage.ignoreDefense}} />
                {{localize "XJZL.Creature.Check.IgnoreDefense"}}
            </label>
            <label>
                <input type="checkbox" name="{{prefix}}.ignoreStance" {{checked damage.ignoreStance}} />
                {{localize "XJZL.Creature.Check.IgnoreStance"}}
            </label>
            <label>
                <input type="checkbox" name="{{prefix}}.ignoreMinDamage" {{checked damage.ignoreMinDamage}} />
                {{localize "XJZL.Creature.Check.IgnoreMinDamage"}}
            </label>
            <label class="element-field">
                <span>{{localize "XJZL.Creature.Check.Element"}}</span>
                <select name="{{prefix}}.element">
                    {{selectOptions @root.choices.elements selected=damage.element}}
                </select>
            </label>
        </div>
    </details>
</div>
