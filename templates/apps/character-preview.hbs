<div class="preview-scroll-container">
    <div class="xjzl-export-settings no-print">
        <div class="settings-row">
            <label><i class="fas fa-camera"></i> {{localize "XJZL.UI.CharacterPreview.ExportQuality"}}</label>
            <select id="export-dpi-selector">
                <option value="1.0" selected>{{localize "XJZL.UI.CharacterPreview.Standard"}}</option>
                <option value="2.0">{{localize "XJZL.UI.CharacterPreview.High"}}</option>
                <option value="3.0">{{localize "XJZL.UI.CharacterPreview.Ultra"}}</option>
            </select>
        </div>
        <div class="settings-hint">
            {{localize "XJZL.UI.CharacterPreview.ExportHint"}}
        </div>
    </div>
    <div class="xjzl-preview-content master-layout">

        <!-- ================= 1. 基础信息表头 ================= -->
        <header class="master-header avoid-break">
            <div class="avatar-box">
                <img src="{{basic.img}}" alt="{{basic.name}}">
            </div>
            <div class="header-info">
                <div class="info-row name-row">
                    <span class="name" contenteditable="plaintext-only">{{basic.name}}</span>
                </div>
                <div class="info-row stamp-row">
                    <span class="top-stamp">{{localize "XJZL.UI.CharacterPreview.Sect"}}：<span contenteditable="plaintext-only">{{basic.sect}}</span></span>
                    <span class="top-stamp">{{localize "XJZL.UI.CharacterPreview.Realm"}}：<span contenteditable="plaintext-only">{{basic.realmLevel}}</span></span>
                </div>
                <div class="info-row">
                    <div class="info-cell"><span>{{localize "XJZL.UI.CharacterPreview.Hp"}}：</span><strong class="text-hp"
                            contenteditable="plaintext-only">{{basic.hpMax}}</strong></div>
                    <div class="info-cell"><span>{{localize "XJZL.UI.CharacterPreview.Mp"}}：</span><strong class="text-mp"
                            contenteditable="plaintext-only">{{basic.mpMax}}</strong></div>
                </div>
                <div class="info-row">
                    <div class="info-cell"><span>{{localize "XJZL.UI.CharacterPreview.Background"}}：</span><strong
                            contenteditable="plaintext-only">{{basic.background}}</strong></div>
                    <div class="info-cell"><span>{{localize "XJZL.UI.CharacterPreview.Personality"}}：</span><strong
                            contenteditable="plaintext-only">{{basic.personality}}</strong></div>
                </div>
                <div class="info-row">
                    <div class="info-cell"><span>{{localize "XJZL.UI.CharacterPreview.Xiayi"}}：</span><strong
                            contenteditable="plaintext-only">{{basic.xiayi}}</strong></div>
                    <div class="info-cell"><span>{{localize "XJZL.UI.CharacterPreview.Exing"}}：</span><strong
                            contenteditable="plaintext-only">{{basic.exing}}</strong></div>
                </div>
                <div class="info-row">
                    <div class="info-cell"><span>{{localize "XJZL.UI.CharacterPreview.ShaLu"}}：</span><strong
                            contenteditable="plaintext-only">{{basic.shalu}}</strong></div>
                    <div class="info-cell"><span>{{localize "XJZL.UI.CharacterPreview.ShaNie"}}：</span><strong
                            contenteditable="plaintext-only">{{basic.shanie}}</strong></div>
                </div>
                <div class="info-row">
                    <div class="info-cell"><span>{{localize "XJZL.UI.CharacterPreview.WulinRep"}}：</span><strong
                            contenteditable="plaintext-only">{{basic.repWulin}}</strong></div>
                    <div class="info-cell"><span>{{localize "XJZL.UI.CharacterPreview.CourtRep"}}：</span><strong
                            contenteditable="plaintext-only">{{basic.repChaoting}}</strong></div>
                </div>
            </div>
        </header>

        <!-- ================= 2. 人物七维属性 ================= -->
        <section class="master-section avoid-break">
            <div class="section-title">{{localize "XJZL.UI.CharacterPreview.Attributes"}}</div>
            <div class="stats-grid">
                <div class="tr head-row">
                    {{#each stats}}<div class="th">{{this.label}}</div>{{/each}}
                </div>
                <div class="tr val-row">
                    {{#each stats}}<div class="td" contenteditable="plaintext-only">{{this.value}}</div>{{/each}}
                </div>
            </div>
        </section>

        <!-- ================= 3. 战斗能力面板 ================= -->
        <section class="master-section avoid-break">
            <div class="section-title">{{localize "XJZL.UI.CharacterPreview.Combat"}}</div>
            <div class="combat-grid">
                {{#each combat}}
                <div class="combat-cell">
                    <div class="th">{{this.label}}</div>
                    <div class="td" contenteditable="plaintext-only">{{this.value}}</div>
                </div>
                {{/each}}
            </div>
        </section>

        <!-- ================= 4. 江湖生活技能 ================= -->
        <section class="master-section avoid-break">
            <div class="section-title">{{localize "XJZL.UI.CharacterPreview.Skills"}}</div>
            <div class="skills-grid">
                {{#each skillGroups}}
                <div class="tr">
                    <div class="th group-name">{{this.label}}</div>
                    <div class="td skill-items">
                        {{#each this.skills}}
                        <span class="skill-item"><span>{{this.name}}：</span><strong
                                contenteditable="plaintext-only">{{this.value}}</strong></span>
                        {{/each}}
                    </div>
                </div>
                {{/each}}
                {{#if arts.length}}
                <div class="tr">
                    <div class="th group-name">{{localize "XJZL.UI.CharacterPreview.Arts"}}</div>
                    <div class="td skill-items">
                        {{#each arts}}
                        <span class="skill-item"><span>{{this.name}}：</span><strong
                                contenteditable="plaintext-only">{{this.value}}</strong></span>
                        {{/each}}
                    </div>
                </div>
                {{/if}}
            </div>
        </section>

        <!-- ================= 5. 战斗操作备注 ================= -->
        <section class="master-section avoid-break">
            <div class="section-title">{{localize "XJZL.UI.CharacterPreview.Notes"}}</div>
            <div class="notes-box">
                <div class="notes-content" contenteditable="plaintext-only" spellcheck="false">
                    {{localize "XJZL.UI.CharacterPreview.NotesPlaceholder"}}
                    <br><br><br>
                </div>
            </div>
        </section>

        <!-- ================= 6. 当前运行内功 ================= -->
        <section class="master-section avoid-break">
            <div class="section-title">{{localize "XJZL.UI.CharacterPreview.ActiveNeigong"}}</div>
            {{#if activeNeigong}}
            <div class="neigong-box">
                <div class="ng-header" contenteditable="plaintext-only">{{activeNeigong.name}}</div>
                <div class="ng-body" contenteditable="plaintext-only">{{{activeNeigong.effect}}}</div>
            </div>
            {{else}}
            <div class="empty-notice">{{localize "XJZL.UI.CharacterPreview.NoActiveNeigong"}}</div>
            {{/if}}
        </section>

        <!-- ================= 7. 常用武学招式 ================= -->
        <section class="master-section moves-section">
            <div class="section-title avoid-break">{{localize "XJZL.UI.CharacterPreview.Wuxue"}}</div>
            {{#if wuxueGroups.length}}
            <div class="wuxue-list">
                {{#each wuxueGroups}}
                <div class="wuxue-book">
                    <div class="book-header">
                        <span class="book-name" contenteditable="plaintext-only">{{this.name}}</span>
                        <div class="book-meta">
                            <span class="b-tier" contenteditable="plaintext-only">{{this.tierName}}</span>
                            <span class="b-cat" contenteditable="plaintext-only">{{this.category}}</span>
                        </div>
                    </div>
                    <div class="moves-list">
                        {{#each this.moves}}
                        <div class="move-card avoid-break">
                            <div class="move-head">
                                <div class="move-title">
                                    <strong contenteditable="plaintext-only">{{this.name}}</strong>
                                    <span class="level" contenteditable="plaintext-only">· {{this.levelName}}</span>
                                </div>
                                <div class="move-tags">
                                    <span class="m-tier">{{this.tierName}}</span>
                                    <span class="type">{{this.typeLabel}}</span>
                                    {{#if this.isUltimate}}<span class="ultimate">{{localize "XJZL.UI.CharacterPreview.Ultimate"}}</span>{{/if}}
                                </div>
                            </div>
                            <div class="move-stats">
                                <span class="stat-tag">{{localize "XJZL.UI.CharacterPreview.Action"}}: <strong class="{{#if this.formulaFields.actionCost}}xjzl-level-formula-result{{/if}}"
                                        contenteditable="plaintext-only">{{this.actionCost}}</strong></span>
                                <span class="stat-tag">{{localize "XJZL.UI.CharacterPreview.Range"}}: <strong class="{{#if this.formulaFields.range}}xjzl-level-formula-result{{/if}}"
                                        contenteditable="plaintext-only">{{this.range}}</strong></span>
                                {{#if this.isStance}}
                                <span class="stat-tag">{{localize "XJZL.UI.CharacterPreview.Block"}}: <strong class="text-dmg"
                                        contenteditable="plaintext-only">{{this.blockValue}}</strong></span>
                                {{else}}
                                <span class="stat-tag">{{localize "XJZL.UI.CharacterPreview.Damage"}}: <strong class="text-dmg"
                                        contenteditable="plaintext-only">{{this.damage}}</strong></span>
                                {{/if}}
                                {{#if this.isFeint}}
                                <span class="stat-tag">{{localize "XJZL.UI.CharacterPreview.Feint"}}: <strong class="text-dmg"
                                        contenteditable="plaintext-only">{{this.feintValue}}</strong></span>
                                {{/if}}
                                {{#if this.cost.hp}}<span class="stat-tag text-hp">{{localize "XJZL.UI.CharacterPreview.Hp"}}: <strong
                                        contenteditable="plaintext-only">{{this.cost.hp}}</strong></span>{{/if}}
                                {{#if this.cost.mp}}<span class="stat-tag text-mp">{{localize "XJZL.UI.CharacterPreview.Mp"}}: <strong
                                        contenteditable="plaintext-only">{{this.cost.mp}}</strong></span>{{/if}}
                                {{#if this.cost.rage}}<span class="stat-tag text-rage">{{localize "XJZL.Resources.Rage"}}: <strong
                                        contenteditable="plaintext-only">{{this.cost.rage}}</strong></span>{{/if}}
                            </div>
                            <div class="move-desc">
                                <div contenteditable="plaintext-only">{{{this.description}}}</div>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/each}}
            </div>
            {{else}}
            <div class="empty-notice avoid-break">{{localize "XJZL.UI.CharacterPreview.NoWuxue"}}</div>
            {{/if}}
        </section>

    </div>
</div>
