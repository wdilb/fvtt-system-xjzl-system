<div class="preview-scroll-container">
    <div class="xjzl-preview-content">

        <!-- 1. 顶部基础档案 -->
        <header class="preview-header">
            <div class="preview-avatar">
                <img src="{{basic.img}}" alt="{{basic.name}}">
            </div>
            <div class="preview-bio">
                <!-- 名字和资源栏在一行 -->
                <div class="bio-header-row">
                    <h1 class="actor-name"><span contenteditable="plaintext-only"
                            spellcheck="false">{{basic.name}}</span></h1>
                    <div class="bio-resources">
                        <div class="res-item">
                            <label>气血</label>
                            <div class="val text-hp"><span contenteditable="plaintext-only"
                                    spellcheck="false">{{basic.hpMax}}</span></div>
                        </div>
                        <div class="res-item">
                            <label>内力</label>
                            <div class="val text-mp"><span contenteditable="plaintext-only"
                                    spellcheck="false">{{basic.mpMax}}</span></div>
                        </div>
                    </div>
                </div>

                <div class="bio-tags">
                    <span class="tag sect"><i class="fas fa-torii-gate"></i> <span contenteditable="plaintext-only"
                            spellcheck="false">{{basic.sect}}</span></span>
                    <span class="tag realm"><i class="fas fa-cloud-moon"></i> <span contenteditable="plaintext-only"
                            spellcheck="false">{{basic.realmLevel}}</span></span>
                    <span class="tag bg"><i class="fas fa-scroll"></i> <span contenteditable="plaintext-only"
                            spellcheck="false">{{basic.background}}</span></span>
                    <span class="tag pers"><i class="fas fa-yin-yang"></i> <span contenteditable="plaintext-only"
                            spellcheck="false">{{basic.personality}}</span></span>
                </div>

                <div class="bio-morality">
                    <span>侠义: <strong class="text-good"><span contenteditable="plaintext-only"
                                spellcheck="false">{{basic.xiayi}}</span></strong></span><span class="divider">|</span>
                    <span>恶行: <strong class="text-evil"><span contenteditable="plaintext-only"
                                spellcheck="false">{{basic.exing}}</span></strong></span><span class="divider">|</span>
                    <span>杀戮: <strong class="text-blood"><span contenteditable="plaintext-only"
                                spellcheck="false">{{basic.shalu}}</span></strong></span><span class="divider">|</span>
                    <span>杀孽: <strong class="text-sin"><span contenteditable="plaintext-only"
                                spellcheck="false">{{basic.shanie}}</span></strong></span>
                </div>

                <div class="bio-morality">
                    <span>武林声望: <strong class="text-rep"><span contenteditable="plaintext-only"
                                spellcheck="false">{{basic.repWulin}}</span></strong></span><span
                        class="divider">|</span>
                    <span>朝廷声望: <strong class="text-rep"><span contenteditable="plaintext-only"
                                spellcheck="false">{{basic.repChaoting}}</span></strong></span><span
                        class="divider">|</span>
                    <span>武林态度: <strong class="text-att"><span contenteditable="plaintext-only"
                                spellcheck="false">{{basic.attWulin}}</span></strong></span><span
                        class="divider">|</span>
                    <span>朝廷态度: <strong class="text-att"><span contenteditable="plaintext-only"
                                spellcheck="false">{{basic.attChaoting}}</span></strong></span><span
                        class="divider">|</span>
                    <span>世俗态度: <strong class="text-att"><span contenteditable="plaintext-only"
                                spellcheck="false">{{basic.attShisu}}</span></strong></span>
                </div>
            </div>
        </header>

        <!-- 2. 七维核心属性 -->
        <section class="preview-section">
            <h2 class="section-title"><i class="fas fa-dna"></i> 根骨悟性</h2>
            <div class="stats-grid">
                {{#each stats}}
                <div class="stat-box">
                    <div class="stat-label">{{this.label}}</div>
                    <div class="stat-value"><span contenteditable="plaintext-only"
                            spellcheck="false">{{this.value}}</span>
                    </div>
                </div>
                {{/each}}
            </div>
        </section>

        <!-- 3. 战斗面板 -->
        <section class="preview-section">
            <h2 class="section-title"><i class="fas fa-swords"></i> 战斗能力</h2>
            <div class="combat-grid">
                {{#each combat}}
                <div class="combat-item">
                    <span class="combat-label">{{this.label}}</span>
                    <span class="combat-value"><span contenteditable="plaintext-only"
                            spellcheck="false">{{this.value}}</span></span>
                </div>
                {{/each}}
            </div>
        </section>

        <!-- 4. 技能熟练度 -->
        <section class="preview-section">
            <h2 class="section-title"><i class="fas fa-star-half-alt"></i> 江湖技能</h2>
            <div class="skills-container">
                {{#each skillGroups}}
                <div class="skill-group">
                    <div class="skill-group-head">{{this.label}}</div>
                    <div class="skill-list">
                        {{#each this.skills}}
                        <div class="skill-item">
                            <span class="s-name">{{this.name}}</span>
                            <span class="s-val"><span contenteditable="plaintext-only"
                                    spellcheck="false">{{this.value}}</span></span>
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/each}}
            </div>
        </section>

        <!-- 技艺展示 -->
        {{#if arts.length}}
        <section class="preview-section">
            <h2 class="section-title"><i class="fas fa-paint-brush"></i> 江湖技艺</h2>
            <div class="arts-grid">
                {{#each arts}}
                <div class="art-item">
                    <span class="art-name">{{this.name}}</span>
                    <span class="art-val"><span contenteditable="plaintext-only"
                            spellcheck="false">{{this.value}}</span></span>
                </div>
                {{/each}}
            </div>
        </section>
        {{/if}}

        <!-- 5. 运行内功 -->
        <section class="preview-section">
            <h2 class="section-title"><i class="fas fa-yin-yang"></i> 运行内功</h2>
            {{#if activeNeigong}}
            <div class="active-neigong-box">
                <h3 class="ng-name"><span contenteditable="plaintext-only"
                        spellcheck="false">{{activeNeigong.name}}</span>
                </h3>
                <div class="ng-effect">
                    <i class="fas fa-quote-left"></i> <span contenteditable="plaintext-only"
                        spellcheck="false">{{activeNeigong.effect}}</span>
                </div>
            </div>
            {{else}}
            <div class="empty-notice">当前未运行任何内功</div>
            {{/if}}
        </section>

        <!-- 6. 常用武学与招式 -->
        <section class="preview-section">
            <h2 class="section-title"><i class="fas fa-book-open"></i> 常用招式</h2>
            {{#if wuxueGroups.length}}
            <div class="wuxue-list">
                {{#each wuxueGroups}}
                <div class="wuxue-book">
                    <div class="book-header">
                        <h3 class="book-name"><span contenteditable="plaintext-only"
                                spellcheck="false">{{this.name}}</span>
                        </h3>
                        <span class="book-cat"><span contenteditable="plaintext-only"
                                spellcheck="false">{{this.category}}</span></span>
                    </div>
                    <div class="moves-list">
                        {{#each this.moves}}
                        <div class="move-card">
                            <div class="move-head">
                                <h4 class="move-name">
                                    <span contenteditable="plaintext-only" spellcheck="false">{{this.name}}</span>
                                    <span style="color:#666; margin:0 4px;">——</span>
                                    <span class="move-level level-{{this.levelName}}" contenteditable="plaintext-only"
                                        spellcheck="false">{{this.levelName}}</span>
                                </h4>
                                <!-- 将标签独立到一个右侧容器中 -->
                                <div class="move-tags-right">
                                    {{#if this.isUltimate}}<span class="tag-ultimate">绝招</span>{{/if}}
                                    <span class="move-type type-{{this.typeLabel}}">{{this.typeLabel}}</span>
                                </div>
                            </div>

                            <!-- 招式数值合并为一行展示 -->
                            <div class="move-info-row">
                                <span class="m-tag"><i class="fas fa-crosshairs"></i> <span
                                        contenteditable="plaintext-only" spellcheck="false">{{this.range}}</span></span>

                                {{#if this.isStance}}
                                <span class="m-tag"><i class="fas fa-shield-alt"></i> 格挡: <strong class="text-dmg"><span
                                            contenteditable="plaintext-only"
                                            spellcheck="false">{{this.blockValue}}</span></strong></span>
                                {{else}}
                                <span class="m-tag"><i class="fas fa-fire"></i> 伤害: <strong class="text-dmg"><span
                                            contenteditable="plaintext-only"
                                            spellcheck="false">{{this.damage}}</span></strong></span>
                                {{/if}}

                                {{#if this.isFeint}}
                                <span class="m-tag"><i class="fas fa-ghost"></i> 虚招: <strong class="text-dmg"><span
                                            contenteditable="plaintext-only"
                                            spellcheck="false">{{this.feintValue}}</span></strong></span>
                                {{/if}}

                                {{#if this.cost.hp}}<span class="m-cost c-hp">血: <span contenteditable="plaintext-only"
                                        spellcheck="false">{{this.cost.hp}}</span></span>{{/if}}
                                {{#if this.cost.mp}}<span class="m-cost c-mp">内: <span contenteditable="plaintext-only"
                                        spellcheck="false">{{this.cost.mp}}</span></span>{{/if}}
                                {{#if this.cost.rage}}<span class="m-cost c-rage">怒: <span
                                        contenteditable="plaintext-only"
                                        spellcheck="false">{{this.cost.rage}}</span></span>{{/if}}
                            </div>

                            <div class="move-desc">
                                <!-- 对于描述内容，由于包含了外部HTML，我们将其整体包裹为可编辑 -->
                                <div contenteditable="plaintext-only" spellcheck="false">
                                    {{{this.description}}}
                                </div>
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
                {{/each}}
            </div>
            {{else}}
            <div class="empty-notice">未将任何招式加入常用列表</div>
            {{/if}}
        </section>

    </div>
</div>