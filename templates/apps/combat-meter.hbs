<div class="combat-meter-container">

    <!-- 顶部控制栏 -->
    <header class="meter-controls">
        <select class="metric-select">
            <option value="damageDealt" {{#if isDamageDealt}}selected{{/if}}>造成伤害 (Damage Dealt)</option>
            <option value="healingDealt" {{#if isHealingDealt}}selected{{/if}}>造成治疗 (Healing Dealt)</option>
            <option value="damageTaken" {{#if isDamageTaken}}selected{{/if}}>承受伤害 (Damage Taken)</option>
        </select>

        {{#if isGM}}
        <button type="button" class="clear-btn" data-action="clearData" title="清空当前数据">
            <i class="fas fa-trash"></i>
        </button>
        {{/if}}
    </header>

    <!-- 列表展示区 -->
    <ul class="meter-list">
        {{#if rows.length}}
        {{#each rows}}
        <li class="meter-row" data-uuid="{{this.uuid}}" title="{{this.name}}">
            <!-- 进度条背景 -->
            <div class="meter-bar" style="width: {{this.percent}}%; background-color: {{this.color}};"></div>

            <!-- 内容层 -->
            <div class="meter-content">
                <span class="rank">{{this.rank}}</span>
                <img src="{{this.img}}" class="avatar" />
                <span class="name">{{this.name}}</span>
                <span class="value">{{this.value}} ({{this.percent}}%)</span>
            </div>
        </li>
        {{/each}}
        {{else}}
        <li class="empty-state">暂无战斗数据...</li>
        {{/if}}
    </ul>

    <!-- 底部总计 -->
    <footer class="meter-footer">
        <span>总计 (Total):</span>
        <span class="total-value">{{totalValue}}</span>
    </footer>
</div>