<div class="wizard-main-wrapper"
    style="display: flex; flex-direction: column; height: 100%; flex-grow: 1; overflow: hidden;">

    {{!-- 头部区域 --}}
    <div class="wizard-header"
        style="padding: 10px 20px; background: rgba(0,0,0,0.4); border-bottom: 2px solid var(--c-highlight); flex-shrink: 0;">
        <h3 style="margin: 0; color: #fff;">{{actor.name}} - 步骤 {{data.currentStep}}</h3>
    </div>

    {{!-- 主体内容区 (设为可滚动) --}}
    <div class="wizard-step-body" style="padding: 20px; flex-grow: 1; overflow-y: auto; box-sizing: border-box;">

        {{#if (eq data.currentStep 1)}}
        <div class="form-group" style="margin-bottom: 15px;">
            <label style="font-weight: bold; margin-bottom: 5px; display: block;">姓名</label>
            <div class="form-fields">
                <input type="text" name="info.name" value="{{data.info.name}}" autofocus
                    style="width: 100%; padding: 5px;">
            </div>
        </div>
        <div class="form-group" style="margin-bottom: 15px;">
            <label style="font-weight: bold; margin-bottom: 5px; display: block;">称号</label>
            <div class="form-fields">
                <input type="text" name="info.title" value="{{data.info.title}}" style="width: 100%; padding: 5px;">
            </div>
        </div>
        <div class="form-group" style="margin-bottom: 15px;">
            <label style="font-weight: bold; margin-bottom: 5px; display: block;">性别</label>
            <div class="form-fields">
                <select name="info.gender" style="width: 100%; padding: 5px;">
                    {{selectOptions choices.genders selected=data.info.gender localize=true}}
                </select>
            </div>
        </div>
        <div class="form-group" style="margin-bottom: 15px;">
            <label style="font-weight: bold; margin-bottom: 5px; display: block;">所属门派</label>
            <div class="form-fields">
                <select name="info.sect" style="width: 100%; padding: 5px;">
                    {{selectOptions choices.sects selected=data.info.sect localize=true}}
                </select>
            </div>
        </div>
        <div class="form-group" style="margin-bottom: 15px;">
            <label style="font-weight: bold; margin-bottom: 5px; display: block;">初始银两</label>
            <div class="form-fields">
                <input type="number" name="info.silver" value="{{data.info.silver}}" style="width: 100%; padding: 5px;">
            </div>
        </div>
        {{/if}}

        {{#if (eq data.currentStep 2)}}
        <p style="color:#aaa;">这里将在下一步开发：支持从合集包拖入背景与性格卡片。</p>
        {{/if}}

        {{#if (eq data.currentStep 3)}}
        <p style="color:#aaa;">这里将在下一步开发：填写声望、嗜好等社交数据。</p>
        {{/if}}

        {{#if (eq data.currentStep 4)}}
        <p style="color:#aaa;">这是最复杂的预算池与武学装配界面，将在第三阶段开发。</p>
        {{/if}}

        {{#if (eq data.currentStep 5)}}
        <p style="color:#aaa;">这里将列出所有技艺并提供 +/- 按钮，在第四阶段开发。</p>
        {{/if}}

        {{#if (eq data.currentStep 6)}}
        <div style="text-align: center; margin-top: 50px;">
            <i class="fas fa-yin-yang fa-4x" style="color: var(--c-highlight); margin-bottom: 20px;"></i>
            <h2 style="color: #fff;">诸事具备，只欠东风</h2>
            <p style="color: #ccc; max-width: 80%; margin: 0 auto; line-height: 1.6;">
                请仔细核对之前的配置。点击“完成建卡”后，<br>系统将清空当前角色卡的旧数据，并注入你刚刚选择的所有命运与馈赠。
            </p>
        </div>
        {{/if}}
    </div>
</div>