<div class="wizard-main-wrapper">
    {{!-- 头部区域 --}}
    <div class="wizard-header">
        <div class="header-deco-line"></div>
        <h3>{{actor.name}} <span class="step-indicator">- {{localize "XJZL.Wizard.Common.Step"}}
                {{data.currentStep}}</span></h3>
    </div>

    {{!-- 主体内容区 --}}
    <div class="wizard-step-body scrollable">

        {{#if (eq data.currentStep 1)}}
        {{!-- 新增：Step 1 专属背景图 --}}
        <div class="step-bg" style="background-image: url('systems/xjzl-system/assets/picture/wizard-step1-bg.png');">
        </div>

        <div class="wizard-form-container relative-z">
            <div class="form-group split-group">
                <div class="sub-group">
                    <label>{{localize "XJZL.Wizard.Step1.NameLabel"}}</label>
                    <div class="form-fields">
                        <input type="text" name="info.name" value="{{data.info.name}}" autofocus
                            placeholder="{{localize 'XJZL.Wizard.Step1.NamePlaceholder'}}">
                    </div>
                </div>
                {{!-- 新增：字 --}}
                <div class="sub-group">
                    <label>{{localize "XJZL.Wizard.Step1.ZiLabel"}}</label>
                    <div class="form-fields">
                        <input type="text" name="info.zi" value="{{data.info.zi}}"
                            placeholder="{{localize 'XJZL.Wizard.Step1.ZiPlaceholder'}}">
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>{{localize "XJZL.Wizard.Step1.TitleLabel"}}</label>
                <div class="form-fields">
                    <input type="text" name="info.title" value="{{data.info.title}}"
                        placeholder="{{localize 'XJZL.Wizard.Step1.TitlePlaceholder'}}">
                </div>
            </div>

            <div class="form-group split-group">
                <div class="sub-group">
                    <label>{{localize "XJZL.Wizard.Step1.GenderLabel"}}</label>
                    <div class="form-fields">
                        <select name="info.gender">
                            {{selectOptions choices.genders selected=data.info.gender localize=true}}
                        </select>
                    </div>
                </div>
                {{!-- 进阶：门派选择卡片 --}}
                <div class="sub-group">
                    <label>{{localize "XJZL.Wizard.Step1.SectLabel"}}</label>
                    <div class="form-fields">
                        <!-- 隐藏的 input 用来被 formData 抓取 -->
                        <input type="hidden" name="info.sect" value="{{data.info.sect}}">
                        <!-- 伪装成按钮的显示框 -->
                        <div class="sect-selector-btn" data-action="openSectSelector">
                            <span class="sect-name">{{localize (lookup choices.sects data.info.sect)}}</span>
                            <span class="sect-hint">{{localize "XJZL.Wizard.Step1.ChangeSect"}} <i
                                    class="fas fa-exchange-alt"></i></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/if}}

        {{!-- ================= Step 2: 命理性格 ================= --}}
        {{#if (eq data.currentStep 2)}}
        <div class="step-bg" style="background-image: url('systems/xjzl-system/assets/picture/wizard-step2-bg.png');">
        </div>
        <div class="wizard-form-container relative-z origin-step-container">

            <div class="origin-split-layout">

                {{!-- 左半区：身世背景 --}}
                <div class="origin-column">
                    <h3 class="column-title"><i class="fas fa-scroll"></i> {{localize
                        "XJZL.Wizard.Step2.BackgroundTitle"}}</h3>

                    <div class="origin-inner-split">
                        {{!-- 左侧：滚动列表 --}}
                        <div class="origin-list-sidebar scrollable">
                            {{#each originsPack.backgrounds as |bg|}}
                            <div class="origin-list-item {{#if (eq ../data.origins.background.uuid bg.uuid)}}selected{{/if}}"
                                data-action="selectOriginItem" data-type="background" data-uuid="{{bg.uuid}}">
                                <img src="{{bg.img}}">
                                <span>{{bg.name}}</span>
                            </div>
                            {{/each}}
                        </div>

                        {{!-- 右侧：详情展示区 (被 JS 动态替换) --}}
                        <div class="origin-detail-view scrollable">
                            {{#if data.origins.background}}
                            <div class="detail-header">
                                <img src="{{data.origins.background.img}}" class="detail-icon">
                                <h4 class="detail-name">{{data.origins.background.name}}</h4>
                            </div>
                            <div class="detail-desc">{{{data.origins.background.system.description}}}</div>
                            <div class="detail-assets">
                                <strong><i class="fas fa-box-open"></i> {{localize
                                    "XJZL.Wizard.Step2.InitialAssets"}}</strong>
                                {{{data.origins.background.system.assets}}}
                            </div>
                            {{else}}
                            <div class="origin-empty-box"><i class="fas fa-arrow-left"></i> {{localize
                                "XJZL.Wizard.Step2.SelectBackgroundHint"}}</div>
                            {{/if}}
                        </div>
                    </div>
                    {{!-- 背景特有的提示 --}}
                    <div class="system-warning-note">
                        <i class="fas fa-info-circle"></i> {{localize "XJZL.Wizard.Step2.WarningNote"}}
                    </div>
                </div>

                {{!-- 右半区：命理性格 --}}
                <div class="origin-column">
                    <h3 class="column-title"><i class="fas fa-theater-masks"></i> {{localize
                        "XJZL.Wizard.Step2.PersonalityTitle"}}</h3>

                    <div class="origin-inner-split">
                        {{!-- 左侧：滚动列表 --}}
                        <div class="origin-list-sidebar scrollable">
                            {{#each originsPack.personalities as |pers|}}
                            <div class="origin-list-item {{#if (eq ../data.origins.personality.uuid pers.uuid)}}selected{{/if}}"
                                data-action="selectOriginItem" data-type="personality" data-uuid="{{pers.uuid}}">
                                <img src="{{pers.img}}">
                                <span>{{pers.name}}</span>
                            </div>
                            {{/each}}
                        </div>

                        {{!-- 右侧：详情展示区 (被 JS 动态替换) --}}
                        <div class="origin-detail-view scrollable">
                            {{#if data.origins.personality}}
                            <div class="detail-header">
                                <img src="{{data.origins.personality.img}}" class="detail-icon">
                                <h4 class="detail-name">{{data.origins.personality.name}}</h4>
                            </div>
                            <div class="detail-desc">{{{data.origins.personality.system.description}}}</div>

                            {{#if data.origins.personality.system.options.length}}
                            <div class="personality-skills">
                                <label class="skill-prompt"><i class="fas fa-hand-sparkles"></i> {{localize
                                    "XJZL.Wizard.Step2.SelectSkillsPrompt"}}</label>
                                <div class="skill-checkbox-group">
                                    {{#each data.origins.personality.system.options as |opt|}}
                                    <label class="skill-checkbox">
                                        <input type="checkbox" value="{{opt}}" data-action="togglePersonalitySkill"
                                            {{checked (includes ../data.origins.personality.system.chosen opt)}}>
                                        <span>{{localize (concat "XJZL.Skills." (capitalize opt))}}</span>
                                    </label>
                                    {{/each}}
                                </div>
                            </div>
                            {{/if}}
                            {{else}}
                            <div class="origin-empty-box"><i class="fas fa-arrow-left"></i> {{localize
                                "XJZL.Wizard.Step2.SelectPersonalityHint"}}</div>
                            {{/if}}
                        </div>
                    </div>
                </div>

            </div>
        </div>
        {{/if}}

        {{!-- ================= Step 3: 处世结交 ================= --}}
        {{#if (eq data.currentStep 3)}}
        <div class="step-bg" style="background-image: url('systems/xjzl-system/assets/picture/wizard-step3-bg.png');">
        </div>
        <div class="wizard-form-container relative-z social-step-container">

            <div class="dossier-wrapper">
                <div class="dossier-header">
                    <h3 class="dossier-title">{{localize "XJZL.Wizard.Step3.DossierTitle"}}</h3>
                    <div class="dossier-subtitle">{{localize "XJZL.Wizard.Step3.DossierSubtitle"}}</div>
                </div>

                <div class="dossier-body">
                    {{!-- 顶部三栏：形貌 / 嗜好 / 声望 --}}
                    <div class="dossier-grid-3">
                        <div class="dossier-section">
                            <div class="sec-label">{{localize "XJZL.Wizard.Step3.AppearanceLabel"}}</div>
                            <div class="ink-input-row">
                                <span>{{localize "XJZL.Wizard.Step3.Age"}}</span>
                                <input type="number" name="info.age" value="{{data.info.age}}">
                            </div>
                            <div class="ink-input-row">
                                <span>{{localize "XJZL.Wizard.Step3.Height"}}</span>
                                <input type="text" name="info.height" value="{{data.info.height}}">
                            </div>
                            <div class="ink-input-row">
                                <span>{{localize "XJZL.Wizard.Step3.Weight"}}</span>
                                <input type="text" name="info.weight" value="{{data.info.weight}}">
                            </div>
                        </div>

                        <div class="dossier-section">
                            <div class="sec-label">{{localize "XJZL.Wizard.Step3.HobbyLabel"}}</div>
                            <div class="hobby-stack">
                                {{#each hobbySlots as |slot|}}
                                <select name="social.shihao.{{slot.index}}" class="ink-select">
                                    {{selectOptions @root.choices.hobbies selected=slot.value blank=(localize
                                    "XJZL.Wizard.Common.None") localize=true}}
                                </select>
                                {{/each}}
                            </div>
                        </div>

                        <div class="dossier-section">
                            <div class="sec-label">{{localize "XJZL.Wizard.Step3.ReputationLabel"}}</div>
                            <div class="rep-stack">
                                <div class="rep-mini-row">
                                    <span class="rep-name">{{localize "XJZL.Wizard.Step3.Court"}}</span>
                                    <input type="number" name="social.rep_chaoting"
                                        value="{{data.social.rep_chaoting}}">
                                    <select name="social.attitude_chaoting" class="ink-select">
                                        {{selectOptions choices.attitudes selected=data.social.attitude_chaoting
                                        localize=true}}
                                    </select>
                                </div>
                                <div class="rep-mini-row">
                                    <span class="rep-name">{{localize "XJZL.Wizard.Step3.Jianghu"}}</span>
                                    <input type="number" name="social.rep_wulin" value="{{data.social.rep_wulin}}">
                                    <select name="social.attitude_wulin" class="ink-select">
                                        {{selectOptions choices.attitudes selected=data.social.attitude_wulin
                                        localize=true}}
                                    </select>
                                </div>
                                <div class="rep-mini-row">
                                    <span class="rep-name" style="color:#aaa;">{{localize
                                        "XJZL.Wizard.Step3.Secular"}}</span>
                                    <!-- 隐形占位符，替代原本的 span flex:1 -->
                                    <div class="rep-placeholder"></div>
                                    <select name="social.attitude_shisu" class="ink-select">
                                        {{selectOptions choices.attitudes selected=data.social.attitude_shisu
                                        localize=true}}
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="dossier-divider"></div>

                    {{!-- 中部：生平传记 + 道德批注 --}}
                    <div class="dossier-section">
                        <div class="bio-header">
                            <div class="sec-label">{{localize "XJZL.Wizard.Step3.BiographyLabel"}}</div>
                            <div class="moral-ink">
                                <label class="moral-tag tag-xiayi">
                                    <span>{{localize "XJZL.Wizard.Step3.Xiayi"}}</span>
                                    <input type="number" name="social.xiayi" value="{{data.social.xiayi}}" min="0">
                                </label>
                                <span class="moral-brush"></span>
                                <label class="moral-tag tag-exing">
                                    <span>{{localize "XJZL.Wizard.Step3.Exing"}}</span>
                                    <input type="number" name="social.exing" value="{{data.social.exing}}" min="0">
                                </label>
                            </div>
                        </div>
                        <textarea name="info.bio" class="ink-textarea" rows="4"
                            placeholder="{{localize 'XJZL.Wizard.Step3.BioPlaceholder'}}">{{{data.info.bio}}}</textarea>
                    </div>

                    <div class="dossier-divider"></div>

                    {{!-- 底部：关系网 --}}
                    <div class="dossier-section">
                        <div class="flex-between">
                            <div class="sec-label">{{localize "XJZL.Wizard.Step3.BondsLabel"}}</div>
                            <button type="button" class="btn-ink-add" data-action="addRelation"><i
                                    class="fas fa-pen-fancy"></i> {{localize "XJZL.Wizard.Step3.AddNewBond"}}</button>
                        </div>

                        <div class="relations-list-container">
                            {{#if data.social.relations.length}}
                            {{#each data.social.relations as |rel i|}}
                            <div class="relation-row">
                                <input type="text" name="social.relations.{{i}}.name" value="{{rel.name}}"
                                    placeholder="{{localize 'XJZL.Wizard.Step3.NpcNamePlaceholder'}}">
                                <input type="text" name="social.relations.{{i}}.type" value="{{rel.type}}"
                                    placeholder="{{localize 'XJZL.Wizard.Step3.RelationTypePlaceholder'}}">
                                <input type="number" name="social.relations.{{i}}.value" value="{{rel.value}}"
                                    title="{{localize 'XJZL.Wizard.Step3.AffectionTitle'}}">
                                <button type="button" data-action="deleteRelation" class="btn-delete-rel"
                                    title="{{localize 'XJZL.Wizard.Common.Delete'}}"><i
                                        class="fas fa-trash"></i></button>
                            </div>
                            {{/each}}
                            {{else}}
                            <div class="empty-hint">{{localize "XJZL.Wizard.Step3.NoBonds"}}</div>
                            {{/if}}
                        </div>
                    </div>

                </div>
            </div>
        </div>
        {{/if}}
        {{!-- ================= Step 4: 武学内功 (预算与装配) ================= --}}
        {{#if (eq data.currentStep 4)}}
        <div class="step-bg" style="background-image: url('systems/xjzl-system/assets/picture/wizard-step4-bg.png');">
        </div>
        <div class="wizard-form-container relative-z assembly-step-container">

            <div class="assembly-layout">
                {{!-- 左侧：预算看板 --}}
                <div class="budget-board">
                    <h3 class="board-title"><i class="fas fa-coins"></i> {{localize
                        "XJZL.Wizard.Step4.InitialResources"}}</h3>

                    <div class="budget-input-group">
                        <div class="b-row general-row">
                            <label>{{localize "XJZL.Wizard.Step4.GeneralExp"}}</label>
                            <input type="number" name="budget.general" value="{{data.budget.general}}" min="0">
                            <div class="b-remain">{{localize "XJZL.Wizard.Step4.Remain"}} <span id="remain-gen">{{#if
                                    data.runtimeBudget}}{{data.runtimeBudget.general}}{{else}}{{data.budget.general}}{{/if}}</span>
                            </div>
                        </div>
                        <div class="b-row specific-row">
                            <label>{{localize "XJZL.Wizard.Step4.NeigongExp"}}</label>
                            <input type="number" name="budget.neigong" value="{{data.budget.neigong}}" min="0">
                            <div class="b-remain">{{localize "XJZL.Wizard.Step4.Remain"}} <span id="remain-ng">{{#if
                                    data.runtimeBudget}}{{data.runtimeBudget.neigong}}{{else}}{{data.budget.neigong}}{{/if}}</span>
                            </div>
                        </div>
                        <div class="b-row specific-row">
                            <label>{{localize "XJZL.Wizard.Step4.WuxueExp"}}</label>
                            <input type="number" name="budget.wuxue" value="{{data.budget.wuxue}}" min="0">
                            <div class="b-remain">{{localize "XJZL.Wizard.Step4.Remain"}} <span id="remain-wx">{{#if
                                    data.runtimeBudget}}{{data.runtimeBudget.wuxue}}{{else}}{{data.budget.wuxue}}{{/if}}</span>
                            </div>
                        </div>
                    </div>

                    <div class="compendium-shortcuts">
                        <button type="button" class="btn-shortcut neigong" data-action="openBrowser"
                            data-type="neigong">
                            <i class="fas fa-yin-yang"></i> {{localize "XJZL.Wizard.Step4.PickNeigong"}}
                        </button>
                        <button type="button" class="btn-shortcut wuxue" data-action="openBrowser" data-type="wuxue">
                            <i class="fas fa-fist-raised"></i> {{localize "XJZL.Wizard.Step4.PickWuxue"}}
                        </button>
                    </div>

                    {{!-- 门派规制引导 --}}
                    <div class="sect-rules-note scrollable">
                        <h4 class="rule-title"><i class="fas fa-book"></i> {{localize
                            "XJZL.Wizard.Step4.SectRulesTitle"}}</h4>
                        <ul class="rule-list">
                            <li><span class="highlight">{{localize "XJZL.Wizard.Step4.OuterSect"}}</span>{{localize
                                "XJZL.Wizard.Step4.OuterSectRule"}}</li>
                            <li><span class="highlight">{{localize "XJZL.Wizard.Step4.InnerSect"}}</span>{{localize
                                "XJZL.Wizard.Step4.InnerSectRule"}}</li>
                            <li><span class="highlight">{{localize "XJZL.Wizard.Step4.ElderSect"}}</span>{{localize
                                "XJZL.Wizard.Step4.ElderSectRule"}}</li>
                            <li class="warning"><i class="fas fa-exclamation-circle"></i> {{localize
                                "XJZL.Wizard.Step4.RuleWarning"}}</li>
                        </ul>
                    </div>
                </div>

                {{!-- 右侧：装配列表 --}}
                <div class="assembly-board">
                    <h3 class="board-title"><i class="fas fa-scroll"></i> {{localize "XJZL.Wizard.Step4.AssemblyTitle"}}
                    </h3>
                    <div class="budget-desc">{{localize "XJZL.Wizard.Step4.AssemblyDesc"}}</div>

                    <div class="assembly-list-container scrollable">
                        {{#if data.assembly.items.length}}
                        {{#each data.assembly.items as |asm|}}

                        {{!-- 内功卡片 (注意 name 属性已改为 asm.id) --}}
                        {{#if (eq asm.type "neigong")}}
                        <div class="asm-card neigong-card">
                            <a class="asm-remove" data-action="removeAssemblyItem" data-uuid="{{asm.uuid}}"
                                title="{{localize 'XJZL.Wizard.Common.Remove'}}"><i class="fas fa-times"></i></a>
                            <!-- 注入 data-tooltip 并且加上提示光标样式 -->
                            <div class="asm-header" data-tooltip="{{asm.tooltip}}" style="cursor: help;">
                                <img src="{{asm.img}}">
                                <div class="asm-name">{{asm.name}} <span class="tier-badge">{{localize
                                        "XJZL.Wizard.Step4.BadgeNeigong"}}</span></div>
                            </div>
                            <div class="asm-config-row">
                                <div class="cfg-item">
                                    <label>{{localize "XJZL.Wizard.Step4.TargetStage"}}</label>
                                    <select name="config_neigong.{{asm.id}}.targetStage">
                                        <option value="0">{{localize "XJZL.Wizard.Step4.Stage0"}}</option>
                                        <option value="1" {{#if (eq (lookup (lookup ../data.config_neigong
                                            asm.id) 'targetStage' ) "1" )}}selected{{/if}}>{{localize
                                            "XJZL.Wizard.Step4.Stage1"}}</option>
                                        <option value="2" {{#if (eq (lookup (lookup ../data.config_neigong
                                            asm.id) 'targetStage' ) "2" )}}selected{{/if}}>{{localize
                                            "XJZL.Wizard.Step4.Stage2"}}</option>
                                        <option value="3" {{#if (eq (lookup (lookup ../data.config_neigong
                                            asm.id) 'targetStage' ) "3" )}}selected{{/if}}>{{localize
                                            "XJZL.Wizard.Step4.Stage3"}}</option>
                                    </select>
                                </div>
                                <div class="cfg-item">
                                    <label>{{localize "XJZL.Wizard.Step4.PaymentMethod"}}</label>
                                    <select name="config_neigong.{{asm.id}}.payment">
                                        <option value="xp" {{#if (eq (lookup (lookup ../data.config_neigong
                                            asm.id) 'payment' ) "xp" )}}selected{{/if}}>{{localize
                                            "XJZL.Wizard.Step4.PayExp"}}</option>
                                        <option value="free" {{#if (eq (lookup (lookup ../data.config_neigong
                                            asm.id) 'payment' ) "free" )}}selected{{/if}}>{{localize
                                            "XJZL.Wizard.Step4.PayFree"}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        {{/if}}

                        {{!-- 武学卡片 (注意 name 属性已改为 asm.id) --}}
                        {{#if (eq asm.type "wuxue")}}
                        <div class="asm-card wuxue-card">
                            <a class="asm-remove" data-action="removeAssemblyItem" data-uuid="{{asm.uuid}}"
                                title="{{localize 'XJZL.Wizard.Common.Remove'}}"><i class="fas fa-times"></i></a>
                            <!-- 注入 data-tooltip 并且加上提示光标样式 -->
                            <div class="asm-header" data-tooltip="{{asm.tooltip}}" style="cursor: help;">
                                <img src="{{asm.img}}">
                                <div class="asm-name">{{asm.name}} <span class="tier-badge">{{localize
                                        "XJZL.Wizard.Step4.BadgeWuxue"}}</span></div>
                            </div>
                            <div class="asm-moves-list">
                                {{#each asm.itemData.system.moves as |move|}}
                                <div class="asm-move-row">
                                    <!-- 注入 move 的 data-tooltip -->
                                    <span class="move-name" data-tooltip="{{move.tooltip}}" style="cursor: help;"><i
                                            class="fas fa-caret-right"></i> {{move.name}}</span>
                                    <div class="move-select-group">
                                        <select name="config_wuxue.{{asm.id}}.{{move.id}}.targetLevel"
                                            class="mini-select">
                                            <option value="0">{{localize "XJZL.Wizard.Step4.Level0"}}</option>
                                            <option value="1" {{#if (eq (lookup (lookup (lookup ../../data.config_wuxue
                                                asm.id) move.id) 'targetLevel' ) "1" )}}selected{{/if}}>{{localize
                                                "XJZL.Wizard.Step4.Level1"}}</option>
                                            <option value="2" {{#if (eq (lookup (lookup (lookup ../../data.config_wuxue
                                                asm.id) move.id) 'targetLevel' ) "2" )}}selected{{/if}}>{{localize
                                                "XJZL.Wizard.Step4.Level2"}}</option>
                                            <option value="3" {{#if (eq (lookup (lookup (lookup ../../data.config_wuxue
                                                asm.id) move.id) 'targetLevel' ) "3" )}}selected{{/if}}>{{localize
                                                "XJZL.Wizard.Step4.Level3"}}</option>

                                            {{!-- 根据后台注入的 hasHeyi 属性决定是否显示第4层 --}}
                                            {{#if move.hasHeyi}}
                                            <option value="4" {{#if (eq (lookup (lookup (lookup ../../data.config_wuxue
                                                asm.id) move.id) 'targetLevel' ) "4" )}}selected{{/if}}>{{localize
                                                "XJZL.Wizard.Step4.Level4"}}</option>
                                            {{/if}}
                                        </select>

                                        <select name="config_wuxue.{{asm.id}}.{{move.id}}.payment"
                                            class="mini-select pay">
                                            <option value="xp" {{#if (eq (lookup (lookup (lookup ../../data.config_wuxue
                                                asm.id) move.id) 'payment' ) "xp" )}}selected{{/if}}>{{localize
                                                "XJZL.Wizard.Step4.PayExp"}}</option>
                                            <option value="free" {{#if (eq (lookup (lookup (lookup
                                                ../../data.config_wuxue asm.id) move.id) 'payment' ) "free"
                                                )}}selected{{/if}}>{{localize "XJZL.Wizard.Step4.PayFree"}}</option>
                                        </select>
                                    </div>
                                </div>
                                {{/each}}
                            </div>
                        </div>
                        {{/if}}

                        {{/each}}
                        {{else}}
                        <div class="empty-drop-zone">
                            <i class="fas fa-box-open fa-3x"></i>
                            <p>{{{localize "XJZL.Wizard.Step4.EmptyDropZone"}}}</p>
                        </div>
                        {{/if}}
                    </div>
                </div>

            </div>
        </div>
        {{/if}}
        {{!-- ================= Step 5: 技艺精通 (天赋与修为) ================= --}}
        {{#if (eq data.currentStep 5)}}
        <div class="step-bg" style="background-image: url('systems/xjzl-system/assets/picture/wizard-step5-bg.png');">
        </div>
        <div class="wizard-form-container relative-z arts-step-container">

            <div class="arts-layout">
                {{!-- 左侧：资源填报与指引 --}}
                <div class="arts-guide-panel">
                    <h3 class="board-title"><i class="fas fa-hammer"></i> {{localize "XJZL.Wizard.Step5.ArtsTitle"}}
                    </h3>

                    <div class="budget-input-group" style="margin-top: 20px;">
                        <div class="b-row specific-row" style="border-left-color: #9b59b6;">
                            <label>{{localize "XJZL.Wizard.Step5.InitialArtsExp"}}</label>
                            <input type="number" name="budget.arts" value="{{data.budget.arts}}" min="0">
                        </div>
                    </div>

                    <div class="sect-rules-note scrollable"
                        style="margin-top: 25px; border-left-color: var(--c-highlight);">
                        <h4 class="rule-title"><i class="fas fa-scroll"></i> {{localize "XJZL.Wizard.Step5.RulesTitle"}}
                        </h4>
                        <ul class="rule-list">
                            <li><span class="highlight">{{localize "XJZL.Wizard.Step5.GrantExpTitle"}}</span>{{localize
                                "XJZL.Wizard.Step5.GrantExpDesc"}}</li>
                            <li><span class="highlight">{{localize
                                    "XJZL.Wizard.Step5.GrantLevelTitle"}}</span>{{localize
                                "XJZL.Wizard.Step5.GrantLevelDesc"}}</li>
                            <li class="warning"><i class="fas fa-info-circle"></i> {{localize
                                "XJZL.Wizard.Step5.Warning"}}</li>
                        </ul>
                    </div>
                </div>

                {{!-- 右侧：技艺网格展示 --}}
                <div class="arts-grid-panel scrollable">
                    <div class="arts-grid">
                        {{!-- 遍历所有技艺设置 --}}
                        {{#each choices.arts as |label key|}}
                        <div class="art-item-card">
                            <div class="art-info">
                                <i class="fas fa-book-reader art-icon"></i>
                                <span class="art-name">{{localize label}}</span>
                            </div>
                            <div class="art-input-wrap">
                                <span class="lvl-prefix">Lv.</span>
                                <!-- 使用 if lookup 回退到 0 保证空值美观 -->
                                <input type="number" name="artsBonus.{{key}}"
                                    value="{{#if (lookup ../data.artsBonus key)}}{{lookup ../data.artsBonus key}}{{else}}0{{/if}}"
                                    min="0" max="10">
                            </div>
                        </div>
                        {{/each}}
                    </div>
                </div>
            </div>

        </div>
        {{/if}}
        {{!-- ================= Step 6: 行囊采买 ================= --}}
        {{#if (eq data.currentStep 6)}}
        <div class="step-bg" style="background-image: url('systems/xjzl-system/assets/picture/wizard-step6-bg.png');">
        </div>
        <div class="wizard-form-container relative-z shopping-step-container">
            <div class="shopping-layout">
                {{!-- 左侧：资金看板与入口 --}}
                <div class="budget-board">
                    <h3 class="board-title"><i class="fas fa-coins"></i> {{localize "XJZL.Wizard.Step6.SilverTitle"}}
                    </h3>

                    <div class="budget-input-group shopping-budget-group">
                        <div class="b-row specific-row" style="border-left-color: #f1c40f;">
                            <label>{{localize "XJZL.Wizard.Step6.InitialSilver"}}</label>
                            <input type="number" name="shopping.silver" value="{{data.shopping.silver}}" min="0">
                            <div class="b-remain">{{localize "XJZL.Wizard.Step4.Remain"}} <span id="remain-silver">{{#if
                                    data.shopping.runtimeSilver}}{{data.shopping.runtimeSilver}}{{else}}{{data.shopping.silver}}{{/if}}</span>
                            </div>
                        </div>
                    </div>

                    <div class="compendium-shortcuts" style="flex-direction: column; gap: 8px;">
                        <button type="button" class="btn-shortcut" data-action="openBrowser" data-type="weapon">
                            <i class="fas fa-sword"></i> {{localize "XJZL.Wizard.Step6.PickWeapon"}}
                        </button>
                        <button type="button" class="btn-shortcut" data-action="openBrowser" data-type="armor">
                            <i class="fas fa-tshirt"></i> {{localize "XJZL.Wizard.Step6.PickArmor"}}
                        </button>
                        {{!-- 拆分为两个独立的按钮 --}}
                        <button type="button" class="btn-shortcut" data-action="openBrowser" data-type="consumable">
                            <i class="fas fa-flask"></i> {{localize "XJZL.Wizard.Step6.PickConsumable"}}
                        </button>
                        <button type="button" class="btn-shortcut" data-action="openBrowser" data-type="misc">
                            <i class="fas fa-box-open"></i> {{localize "XJZL.Wizard.Step6.PickMisc"}}
                        </button>
                    </div>

                    <div class="sect-rules-note scrollable" style="border-left-color: #f1c40f;">
                        <h4 class="rule-title"><i class="fas fa-info-circle"></i> {{localize
                            "XJZL.Wizard.Step6.ShoppingRulesTitle"}}</h4>
                        <ul class="rule-list">
                            <li><span class="highlight">{{localize "XJZL.Wizard.Step6.FreeZoneTitle"}}</span>{{localize
                                "XJZL.Wizard.Step6.FreeZoneDesc"}}</li>
                            <li><span class="highlight">{{localize "XJZL.Wizard.Step6.HalfZoneTitle"}}</span>{{localize
                                "XJZL.Wizard.Step6.HalfZoneDesc"}}</li>
                            <li><span class="highlight">{{localize "XJZL.Wizard.Step6.FullZoneTitle"}}</span>{{localize
                                "XJZL.Wizard.Step6.FullZoneDesc"}}</li>
                            <li class="warning"><i class="fas fa-exclamation-triangle"></i> {{localize
                                "XJZL.Wizard.Step6.Warning"}}</li>
                        </ul>
                    </div>
                </div>

                {{!-- 右侧：三个打折区 --}}
                <div class="shopping-board shopping-list-container scrollable">

                    {{!-- 免费区 --}}
                    <div class="shopping-zone free-zone" data-zone="free">
                        <h4 class="zone-title"><i class="fas fa-gift"></i> {{localize
                            "XJZL.Wizard.Step6.FreeZoneHeader"}}</h4>
                        <div class="zone-items">
                            {{#each data.shopping.items as |shopItem|}}
                            {{#if (eq shopItem.zone "free")}}
                            <div class="shop-item-card" data-tooltip="{{shopItem.tooltip}}">
                                {{!-- 上半部分：图片、名字、价格 --}}
                                <div class="si-top">
                                    <img src="{{shopItem.img}}">
                                    <div class="si-info">
                                        <div class="si-name" title="{{shopItem.name}}">{{shopItem.name}}</div>
                                        <div class="si-price">{{localize "XJZL.Wizard.Step6.UnitPrice"}}
                                            {{shopItem.price}}</div>
                                    </div>
                                </div>
                                {{!-- 下半部分：数量、删除 --}}
                                <div class="si-bottom">
                                    <div class="si-qty">
                                        <span>{{localize "XJZL.Wizard.Step6.Quantity"}}</span>
                                        <input type="number" name="shopping_qty_{{shopItem.id}}"
                                            value="{{shopItem.quantity}}" min="1">
                                    </div>
                                    {{#if (or shopItem.isBackgroundAsset shopItem.isSectAsset)}}
                                        {{#if shopItem.isBackgroundAsset}}
                                            <span class="bg-asset-badge"><i class="fas fa-scroll"></i> 身世赠送</span>
                                        {{else}}
                                            <span class="bg-asset-badge sect-badge"><i class="fas fa-flag"></i> 门派赠送</span>
                                        {{/if}}
                                    {{else}}
                                        <a class="si-delete" data-action="removeShoppingItem" data-id="{{shopItem.id}}">
                                            <i class="fas fa-trash"></i> {{localize "XJZL.Wizard.Common.Delete"}}
                                        </a>
                                    {{/if}}
                                </div>
                            </div>
                            {{/if}}
                            {{/each}}
                        </div>
                    </div>

                    {{!-- 半价区 --}}
                    <div class="shopping-zone half-zone" data-zone="half">
                        <h4 class="zone-title"><i class="fas fa-tags"></i> {{localize
                            "XJZL.Wizard.Step6.HalfZoneHeader"}}</h4>
                        <div class="zone-items">
                            {{#each data.shopping.items as |shopItem|}}
                            {{#if (eq shopItem.zone "half")}}
                            <div class="shop-item-card" data-tooltip="{{shopItem.tooltip}}">
                                <div class="si-top">
                                    <img src="{{shopItem.img}}">
                                    <div class="si-info">
                                        <div class="si-name" title="{{shopItem.name}}">{{shopItem.name}}</div>
                                        <div class="si-price">{{localize "XJZL.Wizard.Step6.UnitPrice"}}
                                            {{shopItem.price}}</div>
                                    </div>
                                </div>
                                <div class="si-bottom">
                                    <div class="si-qty">
                                        <span>{{localize "XJZL.Wizard.Step6.Quantity"}}</span>
                                        <input type="number" name="shopping_qty_{{shopItem.id}}"
                                            value="{{shopItem.quantity}}" min="1">
                                    </div>
                                    {{#if (or shopItem.isBackgroundAsset shopItem.isSectAsset)}}
                                        {{#if shopItem.isBackgroundAsset}}
                                            <span class="bg-asset-badge"><i class="fas fa-scroll"></i> 身世赠送</span>
                                        {{else}}
                                            <span class="bg-asset-badge sect-badge"><i class="fas fa-flag"></i> 门派赠送</span>
                                        {{/if}}
                                    {{else}}
                                        <a class="si-delete" data-action="removeShoppingItem" data-id="{{shopItem.id}}">
                                            <i class="fas fa-trash"></i> {{localize "XJZL.Wizard.Common.Delete"}}
                                        </a>
                                    {{/if}}
                                </div>
                            </div>
                            {{/if}}
                            {{/each}}
                        </div>
                    </div>

                    {{!-- 全价区 --}}
                    <div class="shopping-zone full-zone" data-zone="full">
                        <h4 class="zone-title"><i class="fas fa-shopping-cart"></i> {{localize
                            "XJZL.Wizard.Step6.FullZoneHeader"}}</h4>
                        <div class="zone-items">
                            {{#each data.shopping.items as |shopItem|}}
                            {{#if (eq shopItem.zone "full")}}
                            <div class="shop-item-card" data-tooltip="{{shopItem.tooltip}}">
                                <div class="si-top">
                                    <img src="{{shopItem.img}}">
                                    <div class="si-info">
                                        <div class="si-name" title="{{shopItem.name}}">{{shopItem.name}}</div>
                                        <div class="si-price">{{localize "XJZL.Wizard.Step6.UnitPrice"}}
                                            {{shopItem.price}}</div>
                                    </div>
                                </div>
                                <div class="si-bottom">
                                    <div class="si-qty">
                                        <span>{{localize "XJZL.Wizard.Step6.Quantity"}}</span>
                                        <input type="number" name="shopping_qty_{{shopItem.id}}"
                                            value="{{shopItem.quantity}}" min="1">
                                    </div>
                                    {{#if (or shopItem.isBackgroundAsset shopItem.isSectAsset)}}
                                        {{#if shopItem.isBackgroundAsset}}
                                            <span class="bg-asset-badge"><i class="fas fa-scroll"></i> 身世赠送</span>
                                        {{else}}
                                            <span class="bg-asset-badge sect-badge"><i class="fas fa-flag"></i> 门派赠送</span>
                                        {{/if}}
                                    {{else}}
                                        <a class="si-delete" data-action="removeShoppingItem" data-id="{{shopItem.id}}">
                                            <i class="fas fa-trash"></i> {{localize "XJZL.Wizard.Common.Delete"}}
                                        </a>
                                    {{/if}}
                                </div>
                            </div>
                            {{/if}}
                            {{/each}}
                        </div>
                    </div>

                </div>
            </div>
        </div>
        {{/if}}

        {{!-- ================= Step 7: 降生结算 ================= --}}
        {{#if (eq data.currentStep 7)}}
        <div class="wizard-final-view">
            <img class="final-bg" src="systems/xjzl-system/assets/picture/wizard-birth-bg.png">
            <div class="final-content-box">
                <div class="final-glow-ring">
                    <i class="fas fa-yin-yang fa-4x yin-yang-spin"></i>
                </div>

                <h2 class="final-title">{{localize "XJZL.Wizard.Step7.FinalTitle"}}</h2>

                <div class="final-poetry">
                    <p>{{localize "XJZL.Wizard.Step7.PoetryLine1"}}</p>
                    <p>{{localize "XJZL.Wizard.Step7.PoetryLine2_1"}} <span class="text-highlight">{{localize
                            "XJZL.Wizard.Step7.PoetryLine2_Highlight"}}</span>{{{localize
                        "XJZL.Wizard.Step7.PoetryLine2_2"}}}</p>
                </div>

                <div class="final-warning">
                    <div class="warning-icon"><i class="fas fa-exclamation-triangle"></i></div>
                    <div class="warning-text">
                        <strong>{{localize "XJZL.Wizard.Step7.WarningTitle"}}</strong>
                        <span>{{localize "XJZL.Wizard.Step7.WarningDesc"}}</span>
                    </div>
                </div>
            </div>
        </div>
        {{/if}}

    </div>
</div>