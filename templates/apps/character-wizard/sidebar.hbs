<div class="wizard-sidebar-wrapper">
    {{!-- 背景图层 --}}
    <div class="wizard-sidebar-bg">
        <img src="systems/xjzl-system/assets/picture/wizard-sidebar-bg.png">
        <div class="sidebar-gradient"></div>
    </div>

    {{!-- 步骤图层 --}}
    <div class="wizard-steps-container">
        <h2 class="wizard-title">
            <i class="fas fa-scroll"></i> 建卡向导
        </h2>
        <ul class="step-list">
            <li class="{{#if (eq data.currentStep 1)}}active{{/if}}">
                <i class="fas fa-user-circle"></i> 1. 基础身世
            </li>
            <li class="{{#if (eq data.currentStep 2)}}active{{/if}}">
                <i class="fas fa-theater-masks"></i> 2. 命理性格
            </li>
            <li class="{{#if (eq data.currentStep 3)}}active{{/if}}">
                <i class="fas fa-handshake"></i> 3. 处世结交
            </li>
            <li class="{{#if (eq data.currentStep 4)}}active{{/if}}">
                <i class="fas fa-balance-scale"></i> 4. 资源配置
            </li>
            <li class="{{#if (eq data.currentStep 5)}}active{{/if}}">
                <i class="fas fa-hammer"></i> 5. 技艺精通
            </li>
            <li class="{{#if (eq data.currentStep 6)}}active finish-step{{/if}}">
                <i class="fas fa-check-circle"></i> 6. 降生江湖
            </li>
        </ul>
    </div>
</div>