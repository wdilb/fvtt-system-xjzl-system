<div class="wizard-sidebar-wrapper"
    style="position: relative; height: 100%; width: 250px; flex-shrink: 0; background: #111; border-right: 1px solid #444;">
    {{!-- 背景图层 --}}
    <div class="sidebar-bg"
        style="position: absolute; inset: 0; opacity: 0.3; background: url('systems/xjzl-system/assets/picture/background.jpg') center/cover;">
    </div>

    {{!-- 内容图层 --}}
    <div class="wizard-steps-container" style="position: relative; z-index: 1; padding: 20px;">
        <h2
            style="color: var(--c-highlight); border-bottom: 1px solid #555; padding-bottom: 10px; margin-bottom: 20px;">
            <i class="fas fa-scroll"></i> 建卡向导
        </h2>
        <ul class="step-list"
            style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 15px;">
            <li class="{{#if (eq data.currentStep 1)}}active{{/if}}"
                style="opacity: {{#if (eq data.currentStep 1)}}1{{else}}0.5{{/if}}; font-weight: bold;">
                <i class="fas fa-user-circle"></i> 1. 基础身世
            </li>
            <li class="{{#if (eq data.currentStep 2)}}active{{/if}}"
                style="opacity: {{#if (eq data.currentStep 2)}}1{{else}}0.5{{/if}}; font-weight: bold;">
                <i class="fas fa-theater-masks"></i> 2. 命理性格
            </li>
            <li class="{{#if (eq data.currentStep 3)}}active{{/if}}"
                style="opacity: {{#if (eq data.currentStep 3)}}1{{else}}0.5{{/if}}; font-weight: bold;">
                <i class="fas fa-handshake"></i> 3. 处世结交
            </li>
            <li class="{{#if (eq data.currentStep 4)}}active{{/if}}"
                style="opacity: {{#if (eq data.currentStep 4)}}1{{else}}0.5{{/if}}; font-weight: bold;">
                <i class="fas fa-balance-scale"></i> 4. 资源配置
            </li>
            <li class="{{#if (eq data.currentStep 5)}}active{{/if}}"
                style="opacity: {{#if (eq data.currentStep 5)}}1{{else}}0.5{{/if}}; font-weight: bold;">
                <i class="fas fa-hammer"></i> 5. 技艺精通
            </li>
            <li class="{{#if (eq data.currentStep 6)}}active{{/if}}"
                style="opacity: {{#if (eq data.currentStep 6)}}1{{else}}0.5{{/if}}; font-weight: bold; color: {{#if (eq data.currentStep 6)}}#2ecc71{{else}}inherit{{/if}};">
                <i class="fas fa-check-circle"></i> 6. 降生江湖
            </li>
        </ul>
    </div>
</div>