<div class="wizard-sidebar-wrapper">
    {{!-- 背景图层 --}}
    <div class="wizard-sidebar-bg">
        <img src="systems/xjzl-system/assets/picture/wizard-sidebar-bg.png">
        <div class="sidebar-gradient"></div>
    </div>

    {{!-- 步骤图层 --}}
    <div class="wizard-steps-container">
        <h2 class="wizard-title">
            <i class="fas fa-scroll"></i> {{localize "XJZL.Wizard.Common.Title"}}
        </h2>
        <ul class="step-list">
            <li class="{{#if (eq data.currentStep 1)}}active{{/if}}">
                <i class="fas fa-user-circle"></i> 1. {{localize "XJZL.Wizard.Sidebar.Step1"}}
            </li>
            <li class="{{#if (eq data.currentStep 2)}}active{{/if}}">
                <i class="fas fa-theater-masks"></i> 2. {{localize "XJZL.Wizard.Sidebar.Step2"}}
            </li>
            <li class="{{#if (eq data.currentStep 3)}}active{{/if}}">
                <i class="fas fa-handshake"></i> 3. {{localize "XJZL.Wizard.Sidebar.Step3"}}
            </li>
            <li class="{{#if (eq data.currentStep 4)}}active{{/if}}">
                <i class="fas fa-balance-scale"></i> 4. {{localize "XJZL.Wizard.Sidebar.Step4"}}
            </li>
            <li class="{{#if (eq data.currentStep 5)}}active{{/if}}">
                <i class="fas fa-hammer"></i> 5. {{localize "XJZL.Wizard.Sidebar.Step5"}}
            </li>
            <li class="{{#if (eq data.currentStep 6)}}active{{/if}}">
                <i class="fas fa-shopping-bag"></i> 6. {{localize "XJZL.Wizard.Sidebar.Step6"}}
            </li>
            <li class="{{#if (eq data.currentStep 7)}}active finish-step{{/if}}">
                <i class="fas fa-check-circle"></i> 7. {{localize "XJZL.Wizard.Sidebar.Step7"}}
            </li>
        </ul>
    </div>
</div>
