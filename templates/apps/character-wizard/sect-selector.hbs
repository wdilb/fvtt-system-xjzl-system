<div class="mmo-accordion-container" id="mmo-sect-scroll">
    {{#each sects}}
    <div class="mmo-sect-panel {{#if this.isActive}}expanded{{/if}}" data-key="{{this.key}}" data-action="selectSect">

        {{!-- 背景图 (立绘) --}}
        <div class="panel-bg" style="background-image: url('{{this.img}}'); 
                   {{#if this.bgPos}}--custom-pos: {{this.bgPos}};{{/if}} 
                   {{#if this.bgPosExpanded}}--custom-pos-expanded: {{this.bgPosExpanded}};{{/if}}
                   {{#if this.bgSizeExpanded}}--custom-size-expanded: {{this.bgSizeExpanded}};{{/if}}">
        </div>
        <div class="panel-overlay"></div>

        {{!-- 未展开时显示的竖向名字 --}}
        <div class="vertical-title">
            <span class="icon-deco"><i class="fas fa-yin-yang"></i></span>
            <span class="text">{{this.label}}</span>
        </div>

        {{!-- 展开后的详情内容 --}}
        <div class="expanded-content">
            <div class="content-header">
                <h2>{{this.label}}</h2>
            </div>
            <div class="content-body">
                {{{this.desc}}}
            </div>
            <div class="content-footer">
                <button type="button" class="btn-confirm-sect" data-action="confirmSect">
                    拜入此门 <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </div>

    </div>
    {{/each}}
</div>