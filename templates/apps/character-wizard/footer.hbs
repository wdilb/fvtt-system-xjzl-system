<div class="footer-actions">
    <button type="button" class="btn-prev" data-action="prevStep" {{#if isFirstStep}}disabled{{/if}}>
        <i class="fas fa-chevron-left"></i> <span>上一步</span>
    </button>

    {{#if isLastStep}}
    <button type="button" class="btn-finish" data-action="finishWizard">
        <i class="fas fa-feather-alt"></i> <span>踏入江湖</span>
    </button>
    {{else}}
    <button type="button" class="btn-next" data-action="nextStep">
        <span>下一步</span> <i class="fas fa-chevron-right"></i>
    </button>
    {{/if}}
</div>