<div class="footer-actions">
    <button type="button" class="btn-prev" data-action="prevStep" {{#if isFirstStep}}disabled{{/if}}>
        <i class="fas fa-chevron-left"></i> <span>{{localize "XJZL.Wizard.Common.Previous"}}</span>
    </button>

    {{#if isLastStep}}
    <button type="button" class="btn-finish" data-action="finishWizard">
        <i class="fas fa-feather-alt"></i> <span>{{localize "XJZL.Wizard.Common.Finish"}}</span>
    </button>
    {{else}}
    <button type="button" class="btn-next" data-action="nextStep">
        <span>{{localize "XJZL.Wizard.Common.Next"}}</span> <i class="fas fa-chevron-right"></i>
    </button>
    {{/if}}
</div>
