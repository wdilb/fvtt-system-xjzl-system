<div class="wizard-footer-wrapper"
    style="width: 100%; display: flex; justify-content: space-between; padding: 15px 20px; background: rgba(0,0,0,0.8); border-top: 1px solid #444; flex-shrink: 0; box-sizing: border-box;">

    <button type="button" data-action="prevStep" style="max-width: 120px;" {{#if isFirstStep}}disabled{{/if}}>
        <i class="fas fa-chevron-left"></i> 上一步
    </button>

    {{#if isLastStep}}
    <button type="button" data-action="finishWizard"
        style="max-width: 150px; background: #27ae60; color: white; border: none;">
        <i class="fas fa-check"></i> 完成建卡
    </button>
    {{else}}
    <button type="button" data-action="nextStep"
        style="max-width: 120px; background: var(--c-highlight); color: #000; border: none; font-weight: bold;">
        下一步 <i class="fas fa-chevron-right"></i>
    </button>
    {{/if}}

</div>