<div class="xjzl-effect-picker" data-active-category="{{activeCategory}}">

    <header class="dial-hero">
        {{#if hasTarget}}
        {{#if targetActor}}
        <div class="target-portrait-frame">
            <img src="{{targetActor.img}}" class="target-portrait">
        </div>
        <div class="target-copy">
            <div class="target-label">{{localize "XJZL.UI.EffectPicker.CurrentTarget"}}</div>
            <div class="target-name">{{targetActor.name}}</div>
            <div class="target-hint">{{localize "XJZL.UI.EffectPicker.TargetHint"}}</div>
        </div>
        <div class="target-count">
            <span>{{currentEffects.length}}</span>
            <label>{{localize "XJZL.UI.EffectPicker.Status"}}</label>
        </div>
        {{else}}
        <div class="target-copy multi-copy">
            <div class="target-label">{{localize "XJZL.UI.EffectPicker.BatchMode"}}</div>
            <div class="target-avatars">
                {{#each targetAvatars}}
                <span class="target-avatar" data-tooltip="{{name}}"><img src="{{img}}" alt="{{name}}"></span>
                {{/each}}
            </div>
        </div>
        <div class="target-count muted">
            <span>{{targetAvatarTotal}}</span>
            <label>{{localize "XJZL.UI.EffectPicker.Targets"}}</label>
        </div>
        {{/if}}
        {{else}}
        <div class="target-portrait-frame empty"><i class="fas fa-crosshairs"></i></div>
        <div class="target-copy">
        <div class="target-label">{{localize "XJZL.UI.EffectPicker.NoTarget"}}</div>
        <div class="target-name">{{localize "XJZL.UI.EffectPicker.NoTargetHint"}}</div>
        <div class="target-hint">{{localize "XJZL.UI.EffectPicker.NoTargetSubHint"}}</div>
        </div>
        {{/if}}
    </header>

    <div class="dial-target-mode" role="group" aria-label="{{localize 'XJZL.UI.EffectPicker.TargetMode'}}">
        {{#if isActorBound}}
        <span class="dial-target-mode-label"><i class="fas fa-user-lock"></i> {{localize "XJZL.UI.EffectPicker.TargetModeBound" name=boundActorName}}</span>
        {{else}}
        <span class="dial-target-mode-label"><i class="fas fa-crosshairs"></i> {{localize "XJZL.UI.EffectPicker.TargetMode"}}</span>
        <button type="button" data-action="setTargetMode" data-target-mode="controlled"
            class="{{#if targetModeControlled}}active{{/if}}" data-tooltip="{{localize 'XJZL.UI.EffectPicker.TargetModeControlledHint'}}">
            <i class="fas fa-vector-square"></i>
            <span>{{localize "XJZL.UI.EffectPicker.TargetModeControlled"}}</span>
        </button>
        <button type="button" data-action="setTargetMode" data-target-mode="targeted"
            class="{{#if targetModeTargeted}}active{{/if}}" data-tooltip="{{localize 'XJZL.UI.EffectPicker.TargetModeTargetedHint'}}">
            <i class="fas fa-crosshairs"></i>
            <span>{{localize "XJZL.UI.EffectPicker.TargetModeTargeted"}}</span>
        </button>
        {{#if hasTarget}}
        <button type="button" class="dial-clear-targets" data-action="clearTargets"
            data-tooltip="{{localize 'XJZL.UI.EffectPicker.ClearTargetsHint'}}">
            <i class="fas fa-xmark"></i> {{localize "XJZL.UI.EffectPicker.ClearTargets"}}
        </button>
        {{/if}}
        {{/if}}
    </div>

    <div class="dial-layout">
        <nav class="category-tabs">
            {{#each categories as |category|}}
            <button type="button" class="category-tab {{#if category.active}}active{{/if}}"
                data-category="{{category.id}}">
                <i class="{{category.icon}}"></i>
                <span>{{category.label}}</span>
                <b>{{category.count}}</b>
            </button>
            {{/each}}
        </nav>

        <main class="dial-main">
            <section class="current-effects-panel">
                <div class="panel-title">
                    <span><i class="fas fa-fingerprint"></i> {{localize "XJZL.UI.EffectPicker.OnActor"}}</span>
                    {{#if targetActor}}<small>{{localize "XJZL.UI.EffectPicker.OnActorHint"}}</small>{{/if}}
                </div>

                {{#if targetActor}}
                {{#if currentEffects.length}}
                <div class="current-effects-list">
                    {{#each currentEffects as |effect|}}
                    <div class="current-effect interactive-effect {{#if effect.isStackable}}stackable{{/if}}"
                        data-action="adjustEffect" data-id="{{effect.id}}" data-effect-id="{{effect.id}}" data-tooltip="
                            <div style='text-align:left;'>
                                <b>{{effect.name}}</b>
                                {{#if (gt effect.stacks 1)}} <span style='color:#f1c40f'>(x{{effect.stacks}})</span>{{/if}}
                                {{#if effect.durationLabel}} <span style='color:#aaa; margin-left:5px;'><i class='far fa-clock'></i> {{effect.durationLabel}}</span>{{/if}}
                                <hr style='margin:4px 0; border-color:#555;'>
                                <div style='color:#aaa; margin-bottom:4px;'>{{localize "XJZL.UI.EffectPicker.Source"}}: {{effect.sourceName}}</div>
                                {{#if effect.description}}{{effect.description}}<br><br>{{/if}}
                                {{#if effect.isStackable}}
                                <span style='color:#2ecc71'>{{localize "XJZL.UI.EffectPicker.AddStack"}}</span><br>
                                <span style='color:#e74c3c'>{{localize "XJZL.UI.EffectPicker.RemoveStack"}}</span>
                                {{else}}
                                <span style='color:#2ecc71'>{{localize "XJZL.UI.EffectPicker.SetDuration"}}</span>
                                {{/if}}
                            </div>
                        ">
                        <img src="{{effect.img}}">
                        <span class="current-effect-name">{{effect.name}}</span>
                        {{#if (gt effect.stacks 1)}}<span class="chip-badge stacks">x{{effect.stacks}}</span>{{/if}}
                        {{#if effect.durationLabel}}<span class="chip-badge rounds">{{effect.durationLabel}}</span>{{/if}}
                        <a class="effect-delete" data-action="deleteEffect" data-id="{{effect.id}}" data-tooltip="{{localize 'XJZL.UI.EffectPicker.RemoveStatus'}}">
                            <i class="fas fa-times"></i>
                        </a>
                    </div>
                    {{/each}}
                </div>
                {{else}}
                <div class="empty-current">{{localize "XJZL.UI.EffectPicker.NoCurrent"}}</div>
                {{/if}}
                {{else}}
                <div class="empty-current">{{localize "XJZL.UI.EffectPicker.BatchNoCurrent"}}</div>
                {{/if}}
            </section>

            <div class="picker-search">
                <i class="fas fa-search"></i>
                <input type="text" name="filter" value="{{filter}}" placeholder="{{localize 'XJZL.UI.EffectPicker.SearchPlaceholder'}}" autocomplete="off">
            </div>

            <div class="recent-actions">
                <span><i class="fas fa-clock-rotate-left"></i> {{localize "XJZL.UI.EffectPicker.RecentHint"}}</span>
                <button type="button" data-action="clearRecent">
                    <i class="fas fa-broom"></i> {{localize "XJZL.UI.EffectPicker.ClearRecent"}}
                </button>
            </div>

            <div class="favorite-actions">
                <span><i class="fas fa-star"></i> {{localize "XJZL.UI.EffectPicker.FavoriteHint"}}</span>
                <button type="button" data-action="resetFavorites">
                    <i class="fas fa-rotate-left"></i> {{localize "XJZL.UI.EffectPicker.ResetFavorites"}}
                </button>
            </div>

            <div class="picker-scroll">
                <div class="effect-grid">
                    {{#each statusEffects}}
                    <div role="button" tabindex="0"
                        class="effect-btn {{#if this.isActive}}active{{/if}} {{#if this.isStackable}}stackable{{/if}} {{#if this.isRecent}}recent{{/if}} {{#if this.isFavorite}}favorite{{/if}}"
                        data-action="applyStatus" data-slug="{{this.id}}" data-categories="{{this.categoryString}}"
                        data-search="{{this.name}} {{this.id}}" data-tooltip="{{this.richTooltip}}"
                        data-tooltip-class="xjzl-tooltip">
                        <a class="favorite-pin {{#if this.isFavorite}}pinned{{/if}}" data-action="toggleFavorite"
                            data-slug="{{this.id}}" data-tooltip="{{#if this.isFavorite}}{{localize 'XJZL.UI.EffectPicker.RemoveFavorite'}}{{else}}{{localize 'XJZL.UI.EffectPicker.AddFavorite'}}{{/if}}">
                            <i class="{{#if this.isFavorite}}fas{{else}}far{{/if}} fa-star"></i>
                        </a>
                        <span class="effect-icon-frame"><img src="{{this.img}}" /></span>
                        <span class="effect-name">{{this.name}}</span>
                        {{#if this.isStackable}}<span class="stack-mark"><i class="fas fa-layer-group"></i></span>{{/if}}
                        {{#if this.isRecent}}
                        <a class="recent-remove" data-action="removeRecent" data-slug="{{this.id}}"
                            data-tooltip="{{localize 'XJZL.UI.EffectPicker.RemoveRecent'}}">
                            <i class="fas fa-times"></i>
                            <span>{{localize "XJZL.UI.EffectPicker.RemoveRecentAction"}}</span>
                        </a>
                        {{/if}}
                        {{#if this.isFavorite}}
                        <a class="favorite-remove" data-action="toggleFavorite" data-slug="{{this.id}}"
                            data-tooltip="{{localize 'XJZL.UI.EffectPicker.RemoveFavorite'}}">
                            <i class="fas fa-star"></i>
                            <span>{{localize "XJZL.UI.EffectPicker.RemoveFavoriteAction"}}</span>
                        </a>
                        {{/if}}
                    </div>
                    {{/each}}
                </div>
                <div class="status-empty">
                    {{localize "XJZL.UI.EffectPicker.CategoryEmpty"}}
                </div>

                {{#if sceneGroups.length}}
                <div class="scene-effects">
                    {{#each sceneGroups}}
                    <div class="actor-group {{#if this.collapsed}}collapsed{{/if}}" data-actor-id="{{this.actorId}}">
                        <button type="button" class="group-title" data-action="toggleGroupCollapse"
                            data-tooltip="{{localize 'XJZL.UI.EffectPicker.ToggleGroup'}}">
                            <i class="fas fa-chevron-down group-chevron"></i>
                            <i class="fas fa-user"></i>
                            <span class="group-name">{{this.actorName}}</span>
                            <b class="group-count">{{this.effects.length}}</b>
                        </button>
                        <div class="effect-grid compact">
                            {{#each this.effects}}
                            <div role="button" tabindex="0"
                                class="effect-btn scene {{#if this.isRecent}}recent{{/if}}"
                                data-action="applyItemEffect" data-recent="{{#if this.isRecent}}true{{else}}false{{/if}}"
                                data-uuid="{{this.uuid}}" data-search="{{this.name}} {{this.itemName}} {{this.actorName}}"
                                data-tooltip="{{this.richTooltip}}">
                                <span class="effect-icon-frame"><img src="{{this.img}}" /></span>
                                <span class="effect-name">{{this.name}}</span>
                                <small>{{this.itemName}}</small>
                                {{#if this.isRecent}}
                                <a class="recent-remove" data-action="removeRecent" data-recent-type="scene"
                                    data-uuid="{{this.uuid}}" data-tooltip="{{localize 'XJZL.UI.EffectPicker.RemoveRecent'}}">
                                    <i class="fas fa-times"></i>
                                    <span>{{localize "XJZL.UI.EffectPicker.RemoveRecentAction"}}</span>
                                </a>
                                {{/if}}
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    {{/each}}
                </div>
                {{else}}
                <div class="scene-empty">
                    {{localize "XJZL.UI.EffectPicker.SceneEmpty"}}
                </div>
                {{/if}}
            </div>
        </main>
    </div>
</div>
