{{!-- 系统状态 ID 选择器（供野兽检定型特性等配置场景勾选状态，不做施加） --}}
<div class="xjzl-status-picker">

    <div class="picker-toolbar">
        <i class="fas fa-magnifying-glass"></i>
        <input type="search" name="filter" placeholder="{{localize "XJZL.Creature.Check.PickerSearch"}}"
            value="{{filter}}" autocomplete="off" />
    </div>

    <div class="category-tabs">
        {{#each categories as |c|}}
        <button type="button" class="category-tab{{#if c.active}} active{{/if}}" data-category="{{c.id}}">
            {{c.label}} <span class="count">({{c.count}})</span>
        </button>
        {{/each}}
    </div>

    <div class="picker-scroll">
        {{#each statuses as |s|}}
        <label class="picker-row" data-categories="{{s.categoryString}}" data-search="{{s.searchText}}"
            data-tooltip="{{s.tooltip}}">
            <input type="checkbox" data-id="{{s.id}}" {{#if s.isChecked}}checked{{/if}} />
            <img class="row-icon" src="{{s.img}}" alt="" />
            <span class="row-name">{{s.name}}</span>
            <span class="row-id">{{s.id}}</span>
        </label>
        {{else}}
        <div class="picker-empty">{{localize "XJZL.Creature.Check.PickerEmpty"}}</div>
        {{/each}}
    </div>

    <div class="picker-footer">
        <button type="button" class="picker-confirm" data-action="confirm">
            <i class="fas fa-check"></i> {{localize "XJZL.Creature.Check.PickerConfirm"}}
        </button>
    </div>
</div>
