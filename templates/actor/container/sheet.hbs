<div class="container-layout">

    {{!-- 1. 头部区域 --}}
    <header class="sheet-header">
        <img class="profile-img" src="{{actorImg}}" data-action="editImage" title="更换外观" />

        <div class="header-content">
            <div class="top-row">
                <h1 class="charname">
                    {{#if isOwner}}
                    <input name="name" type="text" value="{{actorName}}" placeholder="容器名称" />
                    {{else}}
                    <span>{{actorName}}</span>
                    {{/if}}
                </h1>

                <div class="lock-status">
                    {{#if system.locked}}
                    <i class="fas fa-lock status-locked" title="已上锁"></i>
                    {{else}}
                    <i class="fas fa-lock-open status-unlocked" title="已开启"></i>
                    {{/if}}

                    {{#if isOwner}}
                    <label class="lock-toggle">
                        <input type="checkbox" name="system.locked" {{checked system.locked}}>
                    </label>
                    {{/if}}
                </div>
            </div>

            <div class="resource-row">
                <div class="currency-box">
                    <i class="fas fa-coins gold-icon"></i>
                    {{!-- 所有人看到都是数字，不能直接改，改必须走GM Socket逻辑(通过按钮) --}}
                    {{!-- 如果是GM或拥有者调试，可以直接输入 --}}
                    {{#if isOwner}}
                    <input type="number" name="system.currency" value="{{system.currency}}" min="0" />
                    {{else}}
                    <span class="currency-val">{{system.currency}}</span>
                    {{/if}}

                    <div class="currency-actions">
                        {{!-- 拿取按钮: 有权限、有钱 --}}
                        {{#if (and canLoot (gt system.currency 0))}}
                        <a data-action="currencyAction" data-type="loot" class="curr-btn loot" title="拿取银两">
                            <i class="fas fa-hand-holding-dollar"></i>
                        </a>
                        {{/if}}

                        {{!-- 存入按钮: 是主人、未上锁 --}}
                        {{#if canDeposit}}
                        <a data-action="currencyAction" data-type="deposit" class="curr-btn deposit" title="存入银两">
                            <i class="fas fa-piggy-bank"></i>
                        </a>
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>
    </header>

    {{!-- 2. 筛选栏 --}}
    <div class="filter-bar">
        <div class="search-wrapper">
            <i class="fas fa-search"></i>
            {{!-- 搜索功能暂时由 Foundry 默认处理或暂未实现JS过滤，保留UI --}}
            <input type="text" class="container-search-input" placeholder="筛选战利品...">
        </div>
    </div>

    {{!-- 3. 物品网格区域 --}}
    <div class="inventory-grid-container">
        {{#if (not hasItems)}}
        <div class="empty-state">
            <i class="fas fa-box-open"></i>
            <p>箱子里空空如也</p>
        </div>
        {{/if}}

        {{#each inventory as |section|}}
        <div class="grid-section">
            <div class="section-header">
                <span class="label">{{localize section.label}}</span>
                <span class="count">{{section.items.length}}</span>
            </div>

            <div class="item-grid">
                {{#each section.items as |item|}}

                {{!--
                draggable 条件:
                是拥有者 OR (有观察权限 AND 未锁)
                --}}
                <div class="item-grid-card {{item.colorClass}}" data-item-id="{{item.id}}" {{#if (or ../../isOwner
                    ../../canLoot)}}draggable="true" {{/if}}>

                    <div class="card-img">
                        <img src="{{item.img}}" data-tooltip="{{{item.tooltip}}}">
                        {{#if item.isStackable}}
                        <span class="qty">{{item.quantity}}</span>
                        {{/if}}
                    </div>

                    <div class="card-info">
                        <div class="name" data-tooltip="{{{item.tooltip}}}">{{item.name}}</div>
                        <div class="actions">
                            {{#if ../../isOwner}}
                            <a data-action="editItem" data-item-id="{{item.id}}" title="编辑"><i
                                    class="fas fa-edit"></i></a>
                            <a data-action="deleteItem" data-item-id="{{item.id}}" title="销毁" class="danger"><i
                                    class="fas fa-trash"></i></a>
                            {{else}}
                            {{!-- 观察者视角下没有按钮，纯靠拖拽 --}}
                            {{/if}}
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
        {{/each}}
    </div>

    {{!-- 4. 底部全部拿取 --}}
    {{#if (and canLoot (or hasItems (gt system.currency 0)))}}
    <footer class="sheet-footer">
        <a role="button" data-action="lootAll" class="loot-all-btn">
            <i class="fas fa-sack-dollar"></i> 全部拿取
        </a>
    </footer>
    {{/if}}
</div>