<div class="loot-workbench">
    <header class="loot-header">
        <img class="loot-header-image" src="{{actorImg}}" data-action="editImage" alt="{{actorName}}">
        <div class="loot-heading">
            <div class="loot-kicker">{{localize "XJZL.Container.NodeTitle"}}</div>
            <h1>{{actorName}}</h1>
            <div class="loot-meta">
                <span class="loot-mode">{{modeLabel}}</span>
                <span class="loot-status">{{statusLabel}}</span>
                <span>{{visibleItemCount}} {{localize "XJZL.Container.ItemCount"}}</span>
            </div>
        </div>
        <div class="loot-currency" aria-label="{{localize "XJZL.Container.Currency"}}">
            <span class="loot-currency-label">{{localize "XJZL.Container.Currency"}}</span>
            <strong>{{system.currency}}</strong>
            {{#if isGM}}
            <button type="button" class="icon-button currency-edit-button" data-action="editCurrency" title="{{localize "XJZL.Container.EditCurrency"}}">
                <i class="fas fa-pen" aria-hidden="true"></i>
            </button>
            {{/if}}
        </div>
    </header>

    <section class="loot-controls" aria-label="{{localize "XJZL.Container.Controls"}}">
        <label class="participant-field">
            <span>{{localize "XJZL.Container.Participant"}}</span>
            <select class="participant-select" {{#unless participants.length}}disabled{{/unless}}>
                {{#each participants as |participant|}}
                <option value="{{participant.uuid}}" {{#if (eq participant.uuid ../selectedActor.uuid)}}selected{{/if}}>{{participant.name}}</option>
                {{else}}
                <option value="">{{localize "XJZL.Container.NoParticipant"}}</option>
                {{/each}}
            </select>
        </label>
        <label class="loot-search">
            <span class="visually-hidden">{{localize "XJZL.Container.Search"}}</span>
            <i class="fas fa-search" aria-hidden="true"></i>
            <input class="container-search-input" type="search" placeholder="{{localize "XJZL.Container.Search"}}">
        </label>
    </section>

    {{#if isGM}}
    <details class="node-config" {{#if nodeConfigOpen}}open{{/if}}>
        <summary><i class="fas fa-sliders" aria-hidden="true"></i>{{localize "XJZL.Container.NodeConfig"}}</summary>
        <div class="node-config-grid">
            <label>
                <span>{{localize "XJZL.Container.Mode"}}</span>
                <select data-config-path="mode">
                    {{#each modeChoices as |choice|}}
                    <option value="{{choice.value}}" {{#if (eq choice.value ../system.mode)}}selected{{/if}}>{{choice.label}}</option>
                    {{/each}}
                </select>
            </label>
            <label>
                <span>{{localize "XJZL.Container.Status"}}</span>
                <select data-config-path="status">
                    {{#each statusChoices as |choice|}}
                    <option value="{{choice.value}}" {{#if (eq choice.value ../system.status)}}selected{{/if}}>{{choice.label}}</option>
                    {{/each}}
                </select>
            </label>
            {{#if isLootMode}}
            <label class="node-config-check"><input type="checkbox" data-config-path="settings.allowTakeAll" {{checked system.settings.allowTakeAll}}>{{localize "XJZL.Container.AllowTakeAll"}}</label>
            {{/if}}
            {{#if isStorageMode}}
            <p class="node-config-note">{{localize "XJZL.Container.StoragePermissionNote"}}</p>
            {{/if}}
            {{#if isShopMode}}
            <label>
                <span>{{localize "XJZL.Container.BuyDiscount"}}</span>
                <input type="number" data-config-path="settings.buyDiscount" min="0" step="0.05" value="{{system.settings.buyDiscount}}">
            </label>
            <label>
                <span>{{localize "XJZL.Container.SellDiscount"}}</span>
                <input type="number" data-config-path="settings.sellDiscount" min="0" step="0.05" value="{{system.settings.sellDiscount}}">
            </label>
            <label class="node-config-check"><input type="checkbox" data-config-path="settings.infiniteStock" {{checked system.settings.infiniteStock}}>{{localize "XJZL.Container.InfiniteStock"}}</label>
            <label class="node-config-check"><input type="checkbox" data-config-path="settings.infiniteWallet" {{checked system.settings.infiniteWallet}}>{{localize "XJZL.Container.InfiniteWallet"}}</label>
            <p class="node-config-note">{{localize "XJZL.Container.ShopConfigNote"}}</p>
            {{/if}}
        </div>
    </details>
    {{/if}}

    {{#if isStorageMode}}
    <div class="loot-mode-note">
        <i class="fas fa-boxes-stacked" aria-hidden="true"></i>
        <span>{{storageHint}}</span>
    </div>
    {{else if isShopMode}}
    <div class="loot-mode-note">
        <i class="fas fa-store" aria-hidden="true"></i>
        <span>{{localize "XJZL.Container.ShopDropHint"}}</span>
    </div>
    {{else}}
    {{#unless isLootMode}}
    <div class="loot-mode-note">
        <i class="fas fa-compass-drafting" aria-hidden="true"></i>
        <span>{{localize "XJZL.Container.ModeUnavailable"}}</span>
    </div>
    {{/unless}}
    {{/if}}

    <main class="loot-scroll">
        {{#if hasVisibleItems}}
        {{#each inventory as |section|}}
        <section class="loot-section">
            <div class="loot-section-heading">
                <span>{{localize section.label}}</span>
                <span class="loot-section-count">{{section.items.length}}</span>
            </div>
            <div class="loot-item-list">
                {{#each section.items as |item|}}
                <article class="loot-item-row" data-item-id="{{item.id}}">
                    <img src="{{item.img}}" class="loot-item-image" alt="{{item.name}}">
                    <div class="loot-item-copy">
                        <div class="loot-item-name">{{item.name}}</div>
                        <div class="loot-item-subline">
                            {{#if item.isStackable}}{{localize "XJZL.Container.Quantity"}}：{{item.quantity}}{{/if}}
                            {{#if item.hidden}}<span class="loot-hidden-badge"><i class="fas fa-eye-slash"></i>{{localize "XJZL.Container.Hidden"}}</span>{{/if}}
                        </div>
                    </div>
                    <div class="loot-item-actions">
                        {{#if ../../isGM}}
                        {{#if ../../isLootMode}}
                        <button type="button" class="icon-button" data-action="toggleHidden" data-item-id="{{item.id}}" title="{{#if item.hidden}}{{localize "XJZL.Container.Show"}}{{else}}{{localize "XJZL.Container.Hide"}}{{/if}}">
                            <i class="fas {{#if item.hidden}}fa-eye{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i>
                        </button>
                        {{/if}}
                        {{#if ../../isShopMode}}
                        <button type="button" class="icon-button" data-action="editShopItem" data-item-id="{{item.id}}" title="{{localize "XJZL.Container.EditShopItem"}}">
                            <i class="fas fa-tag" aria-hidden="true"></i>
                        </button>
                        {{/if}}
                        {{#if item.isStackable}}
                        <button type="button" class="icon-button" data-action="editQuantity" data-item-id="{{item.id}}" title="{{localize "XJZL.Container.EditQuantity"}}">
                            <i class="fas fa-hashtag" aria-hidden="true"></i>
                        </button>
                        {{/if}}
                        <button type="button" class="icon-button danger-button" data-action="deleteItem" data-item-id="{{item.id}}" title="{{localize "XJZL.Container.DeleteItem"}}">
                            <i class="fas fa-trash" aria-hidden="true"></i>
                        </button>
                        {{/if}}
                        {{#if item.canAction}}
                        <button type="button" class="text-button" data-action="{{item.action}}" data-item-id="{{item.id}}">{{#if ../../isStorageMode}}{{localize "XJZL.Container.WithdrawItem"}}{{else if ../../isShopMode}}{{localize "XJZL.Container.BuyItem"}}{{else}}{{localize "XJZL.Container.Take"}}{{/if}}</button>
                        {{/if}}
                        {{#if item.canNeed}}
                        <button type="button" class="text-button need-button" data-action="needStart" data-item-id="{{item.id}}">{{localize "XJZL.Container.Need"}}</button>
                        {{/if}}
                        {{#if ../../isShopMode}}
                        <span class="loot-item-price">{{item.shopPriceText}}</span>
                        {{/if}}
                    </div>
                </article>
                {{/each}}
            </div>
        </section>
        {{/each}}
        {{else}}
        <div class="loot-empty">
            <i class="fas fa-box-open" aria-hidden="true"></i>
            <p>{{localize "XJZL.Container.Empty"}}</p>
    </div>
    {{/if}}

        {{#if hasVisibleRewards}}
        <section class="loot-section loot-reward-section">
            <div class="loot-section-heading">
                <span>{{localize "XJZL.Container.XpRewards"}}</span>
                <span class="loot-section-count">{{visibleRewardCount}}</span>
                {{#if isGM}}
                <button type="button" class="text-button" data-action="addXpReward">{{localize "XJZL.Container.AddReward"}}</button>
                {{/if}}
            </div>
            <div class="loot-item-list">
                {{#each rewards as |reward|}}
                <article class="loot-item-row loot-reward-row" data-reward-id="{{reward.id}}">
                    <div class="loot-reward-mark"><i class="fas fa-yin-yang" aria-hidden="true"></i></div>
                    <div class="loot-item-copy">
                        <div class="loot-item-name">{{reward.name}}</div>
                        <div class="loot-item-subline">+{{reward.amount}} · {{reward.poolLabel}}
                            {{#if reward.hidden}}<span class="loot-hidden-badge"><i class="fas fa-eye-slash"></i>{{localize "XJZL.Container.Hidden"}}</span>{{/if}}
                        </div>
                    </div>
                    <div class="loot-item-actions">
                        {{#if ../isGM}}
                        <button type="button" class="icon-button" data-action="toggleRewardHidden" data-reward-id="{{reward.id}}" title="{{#if reward.hidden}}{{localize "XJZL.Container.Show"}}{{else}}{{localize "XJZL.Container.Hide"}}{{/if}}"><i class="fas {{#if reward.hidden}}fa-eye{{else}}fa-eye-slash{{/if}}" aria-hidden="true"></i></button>
                        <button type="button" class="icon-button" data-action="editXpReward" data-reward-id="{{reward.id}}" title="{{localize "XJZL.Container.EditReward"}}"><i class="fas fa-pen" aria-hidden="true"></i></button>
                        <button type="button" class="icon-button danger-button" data-action="deleteXpReward" data-reward-id="{{reward.id}}" title="{{localize "XJZL.Container.DeleteReward"}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
                        {{/if}}
                        {{#if reward.canClaim}}
                        <button type="button" class="text-button" data-action="claimXp" data-reward-id="{{reward.id}}">{{localize "XJZL.Container.ClaimReward"}}</button>
                        {{else if reward.claimed}}
                        <span class="loot-claimed-label">{{localize "XJZL.Container.Claimed"}}</span>
                        {{/if}}
                    </div>
                </article>
                {{/each}}
            </div>
        </section>
        {{else if (and isGM isLootMode)}}
        <section class="loot-section loot-reward-section">
            <div class="loot-section-heading">
                <span>{{localize "XJZL.Container.XpRewards"}}</span>
                <button type="button" class="text-button" data-action="addXpReward">{{localize "XJZL.Container.AddReward"}}</button>
            </div>
        </section>
        {{/if}}
    </main>

    <footer class="loot-footer">
        {{#if canDepositCurrency}}
        <button type="button" class="currency-button" data-action="currencyAction" data-type="deposit">
            <i class="fas fa-piggy-bank" aria-hidden="true"></i>{{localize "XJZL.Container.DepositCurrency"}}
        </button>
        {{/if}}
        {{#if canTakeCurrency}}
        <button type="button" class="currency-button" data-action="currencyAction" data-type="take">
            <i class="fas fa-coins" aria-hidden="true"></i>{{#if isStorageMode}}{{localize "XJZL.Container.WithdrawCurrency"}}{{else}}{{localize "XJZL.Container.TakeCurrency"}}{{/if}}
        </button>
        {{/if}}
        {{#if canLootAll}}
        <button type="button" class="primary-button" data-action="lootAll" {{#unless hasLootableContent}}disabled{{/unless}}>
            <i class="fas fa-hand-sparkles" aria-hidden="true"></i>{{localize "XJZL.Container.TakeAll"}}
        </button>
        {{/if}}
    </footer>
</div>
