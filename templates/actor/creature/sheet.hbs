{{!-- templates/actor/creature/sheet.hbs --}}
<div class="xjzl-creature-sheet">

    {{!-- 背景纹理 --}}
    <div class="bg-deco">{{localize "XJZL.Creature.BgDeco"}}</div>

    {{!-- 1. 头部：立绘与基础信息 --}}
    <header class="creature-header">

        <div class="portrait-wrapper" data-action="editImage" data-tooltip="{{localize 'XJZL.UI.EditImage'}}">
            <img src="{{document.img}}" />
            <div class="portrait-frame"></div>
        </div>

        {{!-- 核心信息 --}}
        <div class="header-content">
            {{!-- 名字 (书法大字) --}}
            <input type="text" name="name" value="{{document.name}}" class="creature-name"
                placeholder="{{localize 'XJZL.Creature.NamePlaceholder'}}" />

            {{!-- 标签行 (Type / Size / Diff / Price) --}}
            <div class="tags-row">
                {{!-- 类型印章 --}}
                <div class="tag-seal type-{{system.info.type}}">
                    <select name="system.info.type">
                        {{selectOptions creatureTypes selected=system.info.type}}
                    </select>
                </div>

                {{!-- 体型 --}}
                <div class="info-pill">
                    <i class="fas fa-expand"></i>
                    <select name="system.info.size" style="width:auto; min-width:60px;">
                        {{selectOptions choices.sizes selected=system.info.size localize=true}}
                    </select>
                </div>

                {{!-- 难度 --}}
                <div class="info-pill" data-tooltip="{{localize 'XJZL.Creature.Difficulty'}}">
                    <i class="fas fa-crosshairs"></i>
                    <input type="number" name="system.info.difficulty" value="{{system.info.difficulty}}"
                        placeholder="10" />
                </div>

                {{!-- 价格 --}}
                <div class="info-pill" data-tooltip="{{localize 'XJZL.Equipment.Price'}}">
                    <i class="fas fa-coins"></i>
                    <input type="text" name="system.info.price" value="{{system.info.price}}"
                        placeholder="{{localize 'XJZL.Equipment.Price'}}" />
                </div>
            </div>
        </div>
    </header>

    {{!-- 2. 核心资源条 (体力 & 怒气) --}}
    <section class="vitals-section">

        {{!-- 体力条 --}}
        <div class="vital-bar hp">
            <div class="label"><i class="fas fa-heartbeat"></i> {{localize "XJZL.Creature.Tili"}}</div>
            <div class="bar-track">
                <div class="bar-fill" style="width: {{tiliPercent}}%"></div>
                <div class="bar-text">
                    <input type="number" name="system.resources.tili.value" value="{{system.resources.tili.value}}">
                    <span>/</span>
                    <input type="number" name="system.resources.tili.max" value="{{system.resources.tili.max}}">
                </div>
            </div>
        </div>

        {{!-- 怒气条 --}}
        <div class="vital-bar rage">
            <div class="label"><i class="fas fa-fire"></i> {{localize "XJZL.Resources.Rage"}}</div>
            <div class="bar-track">
                {{!-- 注意：确保你注册了 calculatePercentage 这个 helper，或者在 JS _prepareContext 中计算好传进来 --}}
                <div class="bar-fill" style="width: {{calculatePercentage system.resources.rage.value 10}}%"></div>
                <div class="bar-text">
                    <input type="number" name="system.resources.rage.value" value="{{system.resources.rage.value}}">
                    <span style="opacity:0.6">/ 10</span>
                </div>
            </div>
        </div>
    </section>

    {{!-- 2.5 临时状态栏 (非被动 AE，与人物卡一致) --}}
    <div class="active-effects-row">
        {{#if temporaryEffects.length}}
        {{#each temporaryEffects as |effect|}}

        <div class="effect-chip {{#if effect.isActorEffect}}draggable{{/if}} interactive-effect {{#if effect.isSuppressed}}suppressed{{/if}}"
            data-effect-id="{{effect.id}}" data-tooltip="
                <div style='text-align:left;'>
                    <b>{{effect.name}}</b>
                    {{#if (gt effect.stacks 1)}} <span style='color:#f1c40f'>(x{{effect.stacks}})</span>{{/if}}

                    {{#if effect.durationLabel}}
                        <span style='color:#aaa; font-weight:normal; margin-left:5px;'>
                            <i class='far fa-clock'></i> {{effect.durationLabel}}
                        </span>
                    {{/if}}

                    <hr style='margin:4px 0; border-color:#555;'>
                    {{#if effect.description}}{{effect.description}}<br><br>{{/if}}

                    {{#if effect.isStackable}}
<span style='color:#2ecc71'><i class='fas fa-mouse-pointer'></i> {{localize "XJZL.UI.LeftClickAddStack"}}</span><br>
<span style='color:#e74c3c'><i class='fas fa-mouse-pointer'></i> {{localize "XJZL.UI.RightClickRemoveStack"}}</span>
                    {{else}}
<span style='color:#2ecc71'><i class='far fa-clock'></i> {{localize "XJZL.UI.LeftClickSetDuration"}}</span>
                    {{/if}}
                </div>
             ">

            <img src="{{effect.img}}" class="effect-icon">
            <span class="effect-label">{{effect.name}}</span>

            {{#if (gt effect.stacks 1)}}
            <span class="effect-rounds">x{{effect.stacks}}</span>
            {{/if}}

            <a class="effect-delete" data-action="deleteEffect" data-id="{{effect.id}}">
                <i class="fas fa-times"></i>
            </a>
        </div>
        {{/each}}
        {{else}}
        <div class="no-effects-hint">{{localize "XJZL.Combat.NoEffects"}}</div>
        {{/if}}
    </div>

    {{#if effectImmunities.length}}
    <div class="effect-immunity-summary">
        <span class="effect-immunity-label"><i class="fas fa-shield-alt"></i> {{localize "XJZL.UI.EffectImmunity"}}</span>
        {{#each effectImmunities as |immunity|}}
        <span class="effect-immunity-chip" data-tooltip="{{immunity.sourcesLabel}}">{{immunity.name}}</span>
        {{/each}}
    </div>
    {{/if}}

    {{!-- 3. 战斗属性网格 --}}
    <section class="combat-grid">
        {{!-- 速度 --}}
        <div class="stat-cell">
            <div class="stat-label">{{localize "XJZL.Combat.Speed"}}</div>
            <div class="stat-total">{{system.combat.speedTotal}}</div>
            <label class="stat-base">{{localize "XJZL.Stats.Base"}}
                <input type="number" class="stat-val" name="system.combat.speed.value" value="{{baseCombat.speed.value}}" />
            </label>
        </div>

        {{!-- 命中 --}}
        <div class="stat-cell">
            <div class="stat-label">{{localize "XJZL.Creature.Hit"}}</div>
            <div class="stat-total">{{system.combat.hitWaigongTotal}}</div>
            <label class="stat-base">{{localize "XJZL.Stats.Base"}}
                <input type="number" class="stat-val" name="system.combat.hit.value" value="{{baseCombat.hit.value}}" />
            </label>
        </div>

        {{!-- 闪避 --}}
        <div class="stat-cell">
            <div class="stat-label">{{localize "XJZL.Combat.Dodge"}}</div>
            <div class="stat-total">{{system.combat.dodgeTotal}}</div>
            <label class="stat-base">{{localize "XJZL.Stats.Base"}}
                <input type="number" class="stat-val" name="system.combat.dodge.value" value="{{baseCombat.dodge.value}}" />
            </label>
        </div>

        {{!-- 防护 --}}
        <div class="stat-cell protection">
            <div class="stat-label">{{localize "XJZL.Creature.Protection"}}</div>
            <div class="stat-total">{{system.combat.protectionTotal}}</div>
            <label class="stat-base">{{localize "XJZL.Stats.Base"}}
                <input type="number" class="stat-val" name="system.combat.protection.value" value="{{baseCombat.protection.value}}" />
            </label>
            <i class="fas fa-shield-alt icon-bg"></i>
        </div>
    </section>

    {{!-- 4. 描述与特性 --}}
    <div class="bottom-split">

        {{!-- 左侧：描述 --}}
        <div class="desc-col">
            <div class="section-title">{{localize "XJZL.Info.Description"}}</div>
            <textarea name="system.description" class="desc-input"
                placeholder="{{localize 'XJZL.Creature.DescriptionPlaceholder'}}">{{system.description}}</textarea>
        </div>

        {{!-- 右侧：特性列表 --}}
        <div class="abilities-col">
            <div class="section-title action-header">
                <span>{{localize "XJZL.Creature.Abilities"}}</span>
                <a data-action="addAbility" data-tooltip="{{localize 'XJZL.Creature.AddAbility'}}"><i
                        class="fas fa-plus-circle"></i></a>
            </div>

            <div class="ability-list">
                {{#each system.abilities as |ability i|}}
                <div class="ability-card" data-ability-index="{{i}}">
                    {{!-- 头部：名称 + 操作工具（可发起的特性显示收藏与掷骰） --}}
                    <div class="ability-header">
                        <input type="text" class="ability-name" name="system.abilities.{{i}}.name"
                            value="{{ability.name}}"
                            placeholder="{{localize 'XJZL.Creature.AbilityNamePlaceholder'}}" />
                        <div class="ability-tools">
                            {{#if ability.canUse}}
                            <a data-action="togglePinnedAbility" data-index="{{i}}"
                                class="ability-pin-btn {{#if ability.isPinned}}pinned{{/if}}"
                                data-tooltip="{{localize 'XJZL.UI.Cultivation.PinMove'}}"
                                style="color: {{#if ability.isPinned}}#f1c40f{{else}}#ccc{{/if}};">
                                <i class="fas fa-star"></i>
                            </a>
                            <a data-action="useAbility" data-index="{{i}}" class="ability-use-btn"
                                data-tooltip="{{localize 'XJZL.Creature.UseAbility'}}"><i
                                    class="fas fa-dice-d20"></i></a>
                            {{/if}}
                            <a data-action="postAbility" data-index="{{i}}"
                                data-tooltip="{{localize 'XJZL.Creature.PostAbility'}}"><i
                                    class="fas fa-comment-alt"></i></a>
                            <a data-action="deleteAbility" data-index="{{i}}" class="delete"><i
                                    class="fas fa-trash"></i></a>
                        </div>
                    </div>

                    {{!-- 能力卡只显示两个主入口；详细字段按需展开，避免常见的攻击配置被说明文本挤到下方。 --}}
                    <div class="ability-mode-tabs" role="tablist">
                        <button type="button" class="ability-mode-tab ability-attack-tab" data-action="toggleAbilityPanel"
                            data-index="{{i}}" data-panel="attack" aria-controls="ability-attack-{{i}}"
                            aria-expanded="false">
                            <i class="fas fa-gavel"></i>
                            <span class="ability-tab-title">{{localize "XJZL.Creature.AbilityIsAttack"}}</span>
                            <span class="ability-tab-state">
                                {{#if ability.isAttack}}{{ability.attackSummary}}{{else}}{{localize "XJZL.Creature.AbilityNotConfigured"}}{{/if}}
                            </span>
                            <i class="fas fa-chevron-down ability-tab-chevron"></i>
                        </button>
                        <button type="button" class="ability-mode-tab ability-state-tab" data-action="editAbilityState"
                            data-index="{{i}}" data-tooltip="{{localize 'XJZL.Creature.AbilityStateOpenHint'}}">
                            <i class="fas fa-sparkles"></i>
                            <span class="ability-tab-title">{{localize "XJZL.Creature.AbilityState"}}</span>
                            <span class="ability-tab-state">
                                {{#if ability.stateConfigured}}{{localize "XJZL.Creature.AbilityConfigured"}}{{else}}{{localize "XJZL.Creature.AbilityNotConfigured"}}{{/if}}
                            </span>
                            <i class="fas fa-arrow-up-right-from-square ability-tab-external"></i>
                        </button>
                    </div>

                    <div id="ability-attack-{{i}}" class="ability-config-panel" data-ability-panel="attack"
                        aria-hidden="true">
                        <div class="ability-panel-heading">
                            <span>{{localize "XJZL.Creature.AbilityAttackSettings"}}</span>
                            <small>{{localize "XJZL.Creature.AbilityAttackSettingsHint"}}</small>
                        </div>
                        <label class="ability-config-switch">
                            <input type="checkbox" name="system.abilities.{{i}}.isAttack" {{checked ability.isAttack}} />
                            <span>{{localize "XJZL.Creature.AbilityEnableAttack"}}</span>
                        </label>
                        {{#if ability.isAttack}}
                        <div class="ability-attack-fields">
                            <label class="ability-config-field">
                                <span>{{localize "XJZL.Equipment.Damage"}}</span>
                                <input type="number" class="ability-damage" name="system.abilities.{{i}}.damage"
                                    value="{{ability.damage}}" placeholder="0" />
                            </label>
                            <label class="ability-config-field">
                                <span>{{localize "XJZL.Wuxue.Moves.DamageType"}}</span>
                                <select name="system.abilities.{{i}}.damageType">
                                    {{selectOptions @root.choices.damageTypes selected=ability.damageType localize=true}}
                                </select>
                            </label>
                        </div>
                        {{else}}
                        <div class="ability-panel-empty">{{localize "XJZL.Creature.AbilityAttackDisabledHint"}}</div>
                        {{/if}}
                    </div>

                </div>
                {{else}}
                <div class="empty-hint">{{localize "XJZL.Creature.NoAbilities"}}</div>
                {{/each}}
            </div>
        </div>
    </div>
</div>
