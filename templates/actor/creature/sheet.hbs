{{!-- templates/actor/creature/sheet.hbs --}}
<div class="xjzl-creature-sheet">

    {{!-- 背景纹理 --}}
    <div class="bg-deco">{{localize "XJZL.Creature.BgDeco"}}</div>

    {{!-- 1. 头部：立绘与基础信息 --}}
    <header class="creature-header">

        <div class="portrait-wrapper" data-action="editImage" data-tooltip="{{localize 'XJZL.UI.EditImage'}}">
            <img src="{{document.img}}" />
            <div class="portrait-frame"></div>
        </div>

        {{!-- 核心信息 --}}
        <div class="header-content">
            {{!-- 名字 (书法大字) --}}
            <input type="text" name="name" value="{{document.name}}" class="creature-name"
                placeholder="{{localize 'XJZL.Creature.NamePlaceholder'}}" />

            {{!-- 标签行 (Type / Size / Diff / Price) --}}
            <div class="tags-row">
                {{!-- 类型印章 --}}
                <div class="tag-seal type-{{system.info.type}}">
                    <select name="system.info.type">
                        {{selectOptions creatureTypes selected=system.info.type}}
                    </select>
                </div>

                {{!-- 体型 --}}
                <div class="info-pill">
                    <i class="fas fa-expand"></i>
                    <select name="system.info.size" style="width:auto; min-width:60px;">
                        {{selectOptions choices.sizes selected=system.info.size localize=true}}
                    </select>
                </div>

                {{!-- 难度 --}}
                <div class="info-pill" data-tooltip="{{localize 'XJZL.Creature.Difficulty'}}">
                    <i class="fas fa-crosshairs"></i>
                    <input type="number" name="system.info.difficulty" value="{{system.info.difficulty}}"
                        placeholder="10" />
                </div>

                {{!-- 价格 --}}
                <div class="info-pill" data-tooltip="{{localize 'XJZL.Equipment.Price'}}">
                    <i class="fas fa-coins"></i>
                    <input type="text" name="system.info.price" value="{{system.info.price}}"
                        placeholder="{{localize 'XJZL.Equipment.Price'}}" />
                </div>
            </div>
        </div>
    </header>

    {{!-- 2. 核心资源条 (体力 & 怒气) --}}
    <section class="vitals-section">

        {{!-- 体力条 --}}
        <div class="vital-bar hp">
            <div class="label"><i class="fas fa-heartbeat"></i> {{localize "XJZL.Creature.Tili"}}</div>
            <div class="bar-track">
                <div class="bar-fill" style="width: {{tiliPercent}}%"></div>
                <div class="bar-text">
                    <input type="number" name="system.resources.tili.value" value="{{system.resources.tili.value}}">
                    <span>/</span>
                    <input type="number" name="system.resources.tili.max" value="{{system.resources.tili.max}}">
                </div>
            </div>
        </div>

        {{!-- 怒气条 --}}
        <div class="vital-bar rage">
            <div class="label"><i class="fas fa-fire"></i> {{localize "XJZL.Resources.Rage"}}</div>
            <div class="bar-track">
                {{!-- 注意：确保你注册了 calculatePercentage 这个 helper，或者在 JS _prepareContext 中计算好传进来 --}}
                <div class="bar-fill" style="width: {{calculatePercentage system.resources.rage.value 10}}%"></div>
                <div class="bar-text">
                    <input type="number" name="system.resources.rage.value" value="{{system.resources.rage.value}}">
                    <span style="opacity:0.6">/ 10</span>
                </div>
            </div>
        </div>
    </section>

    {{!-- 2.5 临时状态栏 (非被动 AE，与人物卡一致) --}}
    <div class="active-effects-row">
        {{#if temporaryEffects.length}}
        {{#each temporaryEffects as |effect|}}

        <div class="effect-chip interactive-effect {{#if effect.isSuppressed}}suppressed{{/if}}"
            data-effect-id="{{effect.id}}" data-tooltip="
                <div style='text-align:left;'>
                    <b>{{effect.name}}</b>
                    {{#if (gt effect.stacks 1)}} <span style='color:#f1c40f'>(x{{effect.stacks}})</span>{{/if}}

                    {{#if effect.durationLabel}}
                        <span style='color:#aaa; font-weight:normal; margin-left:5px;'>
                            <i class='far fa-clock'></i> {{effect.durationLabel}}
                        </span>
                    {{/if}}

                    <hr style='margin:4px 0; border-color:#555;'>
                    {{#if effect.description}}{{effect.description}}<br><br>{{/if}}

                    {{#if effect.isStackable}}
                        <span style='color:#2ecc71'><i class='fas fa-mouse-pointer'></i> 左键: 增加层数</span><br>
                        <span style='color:#e74c3c'><i class='fas fa-mouse-pointer'></i> 右键: 减少层数</span>
                    {{else}}
                        <span style='color:#7f8c8d; font-style:italic;'>不可叠加</span>
                    {{/if}}
                </div>
             ">

            <img src="{{effect.img}}" class="effect-icon">
            <span class="effect-label">{{effect.name}}</span>

            {{#if (gt effect.stacks 1)}}
            <span class="effect-rounds">x{{effect.stacks}}</span>
            {{/if}}

            <a class="effect-delete" data-action="deleteEffect" data-id="{{effect.id}}">
                <i class="fas fa-times"></i>
            </a>
        </div>
        {{/each}}
        {{else}}
        <div class="no-effects-hint">{{localize "XJZL.Combat.NoEffects"}}</div>
        {{/if}}
    </div>

    {{!-- 3. 战斗属性网格 --}}
    <section class="combat-grid">
        {{!-- 速度 --}}
        <div class="stat-cell">
            <div class="stat-label">{{localize "XJZL.Combat.Speed"}}</div>
            <input type="number" class="stat-val" name="system.combat.speed" value="{{system.combat.speed}}" />
        </div>

        {{!-- 命中 --}}
        <div class="stat-cell">
            <div class="stat-label">{{localize "XJZL.Creature.Hit"}}</div>
            <input type="number" class="stat-val" name="system.combat.hit" value="{{system.combat.hit}}" />
        </div>

        {{!-- 闪避 --}}
        <div class="stat-cell">
            <div class="stat-label">{{localize "XJZL.Combat.Dodge"}}</div>
            <input type="number" class="stat-val" name="system.combat.dodge" value="{{system.combat.dodge}}" />
        </div>

        {{!-- 防护 --}}
        <div class="stat-cell protection">
            <div class="stat-label">{{localize "XJZL.Creature.Protection"}}</div>
            <input type="number" class="stat-val" name="system.combat.protection"
                value="{{system.combat.protection}}" />
            <i class="fas fa-shield-alt icon-bg"></i>
        </div>
    </section>

    {{!-- 基础伤害 (独立一行) --}}
    <div class="damage-row">
        <label>{{localize "XJZL.Creature.DamageBase"}}</label>
        <div class="damage-input-wrapper">
            <i class="fas fa-claw-marks"></i>
            <input type="number" name="system.combat.damage" value="{{system.combat.damage}}" />
        </div>
    </div>

    {{!-- 4. 描述与特性 --}}
    <div class="bottom-split">

        {{!-- 左侧：描述 --}}
        <div class="desc-col">
            <div class="section-title">{{localize "XJZL.Info.Description"}}</div>
            <textarea name="system.description" class="desc-input"
                placeholder="{{localize 'XJZL.Creature.DescriptionPlaceholder'}}">{{system.description}}</textarea>
        </div>

        {{!-- 右侧：特性列表 --}}
        <div class="abilities-col">
            <div class="section-title action-header">
                <span>{{localize "XJZL.Creature.Abilities"}}</span>
                <a data-action="addAbility" data-tooltip="{{localize 'XJZL.Creature.AddAbility'}}"><i
                        class="fas fa-plus-circle"></i></a>
            </div>

            <div class="ability-list">
                {{#each system.abilities as |ability i|}}
                <div class="ability-card">
                    <div class="ability-header">
                        <input type="text" class="ability-name" name="system.abilities.{{i}}.name"
                            value="{{ability.name}}"
                            placeholder="{{localize 'XJZL.Creature.AbilityNamePlaceholder'}}" />
                        <div class="ability-tools">
                            <a data-action="postAbility" data-index="{{i}}"><i class="fas fa-comment-alt"></i></a>
                            <a data-action="deleteAbility" data-index="{{i}}" class="delete"><i
                                    class="fas fa-trash"></i></a>
                        </div>
                    </div>

                    {{!-- 攻击型特性配置 --}}
                    <div class="ability-attack-row">
                        <label class="ability-attack-toggle">
                            <input type="checkbox" name="system.abilities.{{i}}.isAttack" {{checked
                                ability.isAttack}} />
                            <i class="fas fa-gavel"></i>
                            <span>{{localize "XJZL.Creature.AbilityIsAttack"}}</span>
                        </label>

                        {{#if ability.isAttack}}
                        <div class="ability-damage-strip" data-tooltip="{{localize 'XJZL.Equipment.Damage'}}">
                            <input type="number" class="ability-damage" name="system.abilities.{{i}}.damage"
                                value="{{ability.damage}}" placeholder="0" />
                            <select class="ability-damage-type" name="system.abilities.{{i}}.damageType">
                                {{selectOptions @root.choices.damageTypes selected=ability.damageType localize=true}}
                            </select>
                        </div>

                        <a data-action="togglePinnedAbility" data-index="{{i}}"
                            class="ability-pin-btn {{#if ability.isPinned}}pinned{{/if}}" data-tooltip="设为常用招式"
                            style="margin-left: 8px; color: {{#if ability.isPinned}}#f1c40f{{else}}#ccc{{/if}};">
                            <i class="fas fa-star"></i>
                        </a>

                        <a data-action="rollAbilityAttack" data-index="{{i}}" class="ability-attack-btn"
                            data-tooltip="{{localize 'XJZL.Creature.RollAbilityAttack'}}"><i
                                class="fas fa-dice-d20"></i></a>
                        {{/if}}
                    </div>

                    <textarea class="ability-desc" name="system.abilities.{{i}}.description" rows="2"
                        placeholder="{{localize 'XJZL.Creature.AbilityDescPlaceholder'}}">{{ability.description}}</textarea>
                </div>
                {{else}}
                <div class="empty-hint">{{localize "XJZL.Creature.NoAbilities"}}</div>
                {{/each}}
            </div>
        </div>
    </div>
</div>