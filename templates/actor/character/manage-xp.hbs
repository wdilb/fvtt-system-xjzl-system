<div class="xp-manager-wrapper">
    <!-- 提示信息 -->
    <p class="hint-text">
        <i class="fas fa-edit"></i>
        {{localize "XJZL.UI.ManageXP.Hint"}}
    </p>

    <!-- 第一行：目标池 + 数值 -->
    <div class="form-row split-2-1">
        <div class="form-group">
            <label>{{localize "XJZL.UI.ManageXP.Pool"}}</label>
            <select name="poolKey" autofocus>
                {{selectOptions poolChoices selected="general"}}
            </select>
        </div>
        <div class="form-group">
            <label>{{localize "XJZL.UI.ManageXP.Amount"}}</label>
            <input type="number" name="amount" placeholder="{{localize 'XJZL.UI.ManageXP.AmountPlaceholder'}}" required />
        </div>
    </div>

    <!-- 第二行：标题 + 时间 -->
    <div class="form-row split-1-1">
        <div class="form-group">
            <label>{{localize "XJZL.UI.ManageXP.EventTitle"}}</label>
            <input type="text" name="title" value="{{defaultTitle}}" />
        </div>
        <div class="form-group">
            <label>{{localize "XJZL.UI.ManageXP.GameDate"}}</label>
            <input type="text" name="gameDate" placeholder="{{localize 'XJZL.UI.ManageXP.GameDatePlaceholder'}}" />
        </div>
    </div>

    <!-- 第三行：备注 -->
    <div class="form-group full-width">
        <label>{{localize "XJZL.UI.ManageXP.Reason"}}</label>
        <input type="text" name="reason" placeholder="{{localize 'XJZL.UI.ManageXP.ReasonPlaceholder'}}" />
    </div>

    <!-- 底部按钮 -->
    <footer class="sheet-footer">
        <button type="submit" class="execute-btn">
            <i class="fas fa-check"></i> {{localize "XJZL.UI.ManageXP.Execute"}}
        </button>
    </footer>
</div>
