<!-- ================================================== -->
<!-- Tab: 修行 · 墨卷修行台                              -->
<!-- ================================================== -->
<section class="xjzl-body tab scroll-area {{#if (eq tabs.primary 'cultivation')}}active{{/if}}" data-tab="cultivation"
    data-group="primary">

    <div class="cultivation-workbench">
        <div class="cultivation-bg" aria-hidden="true"></div>

        <header class="cultivation-overview">
            <div class="dantian-plate cultivation-resource-strip">
                <div class="dantian-core xp-pool general"
                    data-tooltip='{{localize "XJZL.Cultivation.General"}}&#10;{{localize "XJZL.Cultivation.Remaining"}}：{{system.cultivation.general}}&#10;{{localize "XJZL.Cultivation.TotalEarned"}}：{{system.cultivation.generalTotal}}'
                    data-tooltip-class="xjzl-pool-tooltip general">
                    <span class="dantian-glyph">丹</span>
                    <span class="dantian-label">通用修为</span>
                    <strong class="dantian-value">{{system.cultivation.general}}</strong>
                </div>
                <div class="dantian-branches" aria-label="专属修为">
                    <div class="dantian-branch neigong xp-pool"
                        data-tooltip='{{localize "XJZL.Cultivation.Neigong"}}&#10;{{localize "XJZL.Cultivation.Remaining"}}：{{system.cultivation.neigong}}&#10;{{localize "XJZL.Cultivation.TotalEarned"}}：{{system.cultivation.neigongTotal}}'
                        data-tooltip-class="xjzl-pool-tooltip neigong">
                        <i class="fas fa-yin-yang" aria-hidden="true"></i><small>内功</small><b>{{system.cultivation.neigong}}</b>
                    </div>
                    <div class="dantian-branch wuxue xp-pool"
                        data-tooltip='{{localize "XJZL.Cultivation.Wuxue"}}&#10;{{localize "XJZL.Cultivation.Remaining"}}：{{system.cultivation.wuxue}}&#10;{{localize "XJZL.Cultivation.TotalEarned"}}：{{system.cultivation.wuxueTotal}}'
                        data-tooltip-class="xjzl-pool-tooltip wuxue">
                        <i class="fas fa-khanda" aria-hidden="true"></i><small>武学</small><b>{{system.cultivation.wuxue}}</b>
                    </div>
                    <div class="dantian-branch arts xp-pool"
                        data-tooltip='{{localize "XJZL.Cultivation.Arts"}}&#10;{{localize "XJZL.Cultivation.Remaining"}}：{{system.cultivation.arts}}&#10;{{localize "XJZL.Cultivation.TotalEarned"}}：{{system.cultivation.artsTotal}}'
                        data-tooltip-class="xjzl-pool-tooltip arts">
                        <i class="fas fa-book-open" aria-hidden="true"></i><small>技艺</small><b>{{system.cultivation.arts}}</b>
                    </div>
                </div>
            </div>

            <div class="cultivation-top-actions cultivation-command-strip">
                <label class="cultivation-search" aria-label="搜索修炼内容">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input type="search" class="cultivation-search-input" value="{{cultivationSearchTerm}}" placeholder="{{localize 'XJZL.Cultivation.Workbench.SearchPlaceholder'}}" />
                    {{#if cultivationSearchTerm}}<button type="button" class="search-clear" data-action="clearCultivationSearch" aria-label="清除搜索"><i class="fas fa-times" aria-hidden="true"></i></button>{{/if}}
                </label>
                <button type="button" class="cultivation-tool {{#if isSorting}}is-active{{/if}}" data-action="toggleSort" data-tooltip="{{#if isSorting}}{{localize 'XJZL.Cultivation.SortDone'}}{{else}}{{localize 'XJZL.Cultivation.SortEdit'}}{{/if}}"><i class="fas fa-sort" aria-hidden="true"></i><span>{{#if isSorting}}{{localize 'XJZL.Cultivation.SortDone'}}{{else}}{{localize 'XJZL.Cultivation.SortEdit'}}{{/if}}</span></button>
                <button type="button" class="cultivation-tool" data-action="viewHistory" data-tooltip="{{localize 'XJZL.Cultivation.AuditLog'}}"><i class="fas fa-history" aria-hidden="true"></i><span>{{localize 'XJZL.Cultivation.Workbench.ViewRecords'}}</span></button>
                <button type="button" class="cultivation-tool cultivation-tool-primary" data-action="manageXP" data-tooltip="{{localize 'XJZL.Cultivation.ManageXP'}}"><i class="fas fa-plus-minus" aria-hidden="true"></i><span>{{localize 'XJZL.Cultivation.Workbench.ModifyXP'}}</span></button>
            </div>
        </header>

        <nav class="cultivation-tabs" aria-label="修行分类">
            {{#each cultivationCategories as |category|}}
            <button type="button" class="cultivation-tab {{#if (eq @root.cultivationSubTab category.key)}}is-active{{/if}}" data-action="toggleSubTab" data-target="{{category.key}}">
                <i class="fas {{category.icon}}" aria-hidden="true"></i><span>{{localize category.label}}</span><b>{{category.count}}</b>
            </button>
            {{/each}}
        </nav>

        <main class="cultivation-workspace">
            {{#if (eq cultivationSubTab "neigong")}}
            <section class="cultivation-panel" data-cultivation-panel="neigong">
                <aside class="cultivation-directory">
                    <div class="directory-heading"><span class="directory-kicker">{{localize 'XJZL.Cultivation.Workbench.DirectoryNeigong'}}</span><strong>{{neigongs.length}} 部</strong></div>
                    <div class="directory-list">
                        {{#each neigongs as |item|}}
                        <div class="directory-entry neigong-card {{#if (gte item.system.stage 3)}}is-complete{{/if}} {{#if item.isRunning}}is-running{{/if}} {{#if (eq item.id @root.selectedNeigong.id)}}is-selected{{/if}}" data-action="selectCultivationEntry" data-category="neigong" data-item-id="{{item.id}}" data-element="{{item.system.element}}" data-tier="{{item.system.tier}}" data-name="{{item.name}}" data-tooltip="{{item.xpTooltip}}" draggable="true">
                            <button type="button" class="entry-icon" data-action="editItem" data-item-id="{{item.id}}" aria-label="编辑 {{item.name}}"><img src="{{item.img}}" alt="" />{{#if item.isRunning}}<span class="running-mark" role="img" aria-label="正在运功" data-tooltip="正在运功">运</span>{{/if}}</button>
                            <div class="entry-copy"><strong class="ng-name">{{item.name}}</strong><span>{{item.stageLabel}}</span></div>
                        </div>
                        {{else}}<div class="directory-empty">{{localize 'XJZL.Cultivation.Workbench.NoNeigong'}}</div>{{/each}}
                    </div>
                </aside>

                <article class="cultivation-inspector">
                    {{#if selectedNeigong}}
                    <div class="inspector-hero neigong-hero" data-element="{{selectedNeigong.system.element}}">
                        <div class="hero-icon-wrap {{#if selectedNeigong.isRunning}}is-running{{/if}}"><img src="{{selectedNeigong.img}}" alt="{{selectedNeigong.name}}" data-action="editItem" data-item-id="{{selectedNeigong.id}}" /></div>
                        <div class="hero-heading"><span class="inspector-eyebrow">{{#if selectedNeigong.isRunning}}{{localize 'XJZL.Cultivation.Workbench.CurrentRunning'}}{{else}}{{localize 'XJZL.Cultivation.SectionNeigong'}}{{/if}}</span><h2 data-action="editItem" data-item-id="{{selectedNeigong.id}}">{{selectedNeigong.name}}</h2><div class="hero-meta"><span>{{selectedNeigong.stageLabel}}</span><span>内功属性：{{selectedNeigong.elementLabel}}</span><span>内功品阶：{{selectedNeigong.tierLabel}}</span></div></div>
                        {{#if selectedNeigong.isRunning}}<span class="hero-seal">运</span>{{/if}}
                    </div>
                    <div class="cultivation-progress-block"><div class="progress-caption"><span>{{localize 'XJZL.Cultivation.Workbench.Progress'}}</span><b>{{selectedNeigong.system.xpInvested}} / {{selectedNeigong.system.progressData.absoluteMax}}</b></div><div class="cultivation-progress-track"><span style="width:{{selectedNeigong.system.progressData.pct}}%"></span></div><div class="stage-track"><span class="is-complete">领悟</span><i></i><span class="{{#if (gte selectedNeigong.system.stage 2)}}is-complete{{/if}}">小成</span><i></i><span class="{{#if (gte selectedNeigong.system.stage 3)}}is-complete{{/if}}">圆满</span></div></div>
                    <div class="inspector-actions"><button type="button" class="action-primary" data-action="investXP" data-item-id="{{selectedNeigong.id}}"><i class="fas fa-arrow-up"></i> 投入修为</button><button type="button" class="action-secondary" data-action="toggleNeigong" data-item-id="{{selectedNeigong.id}}"><i class="fas {{#if selectedNeigong.isRunning}}fa-pause{{else}}fa-fire{{/if}}"></i> {{#if selectedNeigong.isRunning}}停功{{else}}运行{{/if}}</button><button type="button" class="action-secondary" data-action="refundXP" data-item-id="{{selectedNeigong.id}}"><i class="fas fa-undo"></i> 散功</button><button type="button" class="action-secondary" data-action="editItem" data-item-id="{{selectedNeigong.id}}"><i class="fas fa-pen"></i> 编辑</button><button type="button" class="action-secondary" data-action="postItem" data-item-id="{{selectedNeigong.id}}"><i class="fas fa-comment"></i> 发送</button><button type="button" class="action-danger" data-action="deleteCultivationItem" data-item-id="{{selectedNeigong.id}}"><i class="fas fa-trash"></i> 删除</button></div>
                    <div class="inspector-columns neigong-detail-columns">
                        <div class="inspector-section neigong-effect-section">
                            <span class="section-kicker">{{localize 'XJZL.Cultivation.Workbench.CurrentStageEffect'}}</span>
                            {{#if selectedNeigong.system.current.description}}<div class="inspector-richtext">{{{selectedNeigong.system.current.description}}}</div>{{else}}<div class="inspector-empty-note">{{localize 'XJZL.Cultivation.Workbench.NoCurrentStageEffect'}}</div>{{/if}}
                        </div>
                        <div class="inspector-section"><span class="section-kicker">{{localize 'XJZL.Cultivation.Workbench.AutomationDescription'}}</span>{{#if selectedNeigong.system.automationNote}}<div class="inspector-richtext">{{selectedNeigong.system.automationNote}}</div>{{else}}<div class="inspector-empty-note">{{localize 'XJZL.Cultivation.Workbench.NoAutomationDescription'}}</div>{{/if}}</div>
                    </div>
                    {{#if selectedNeigong.system.current.masteryEffect}}
                    <section class="neigong-mastery-panel" aria-label="{{localize 'XJZL.Neigong.MasteryEffect'}}">
                        <div class="neigong-mastery-mark" aria-hidden="true"><i class="fas fa-crown"></i></div>
                        <div class="neigong-mastery-copy">
                            <div class="neigong-mastery-heading"><span class="section-kicker">{{localize 'XJZL.Neigong.MasteryEffect'}}</span><em>{{localize 'XJZL.Neigong.MasteryPassive'}}</em></div>
                            <div class="inspector-richtext">{{{selectedNeigong.system.current.masteryEffect}}}</div>
                        </div>
                    </section>
                    {{/if}}
                    {{else}}<div class="inspector-empty"><i class="fas fa-yin-yang"></i><h2>尚未修习内功</h2><p>将内功拖入角色卡，或从物品目录中开始修行。</p></div>{{/if}}
                </article>
            </section>

            {{else if (eq cultivationSubTab "wuxue")}}
            <section class="cultivation-panel" data-cultivation-panel="wuxue">
                <aside class="cultivation-directory wuxue-directory">
                    <div class="directory-heading">
                        <span class="directory-kicker">{{localize 'XJZL.Cultivation.Workbench.DirectoryWuxue'}}</span>
                        <strong>{{wuxues.length}} 门</strong>
                    </div>
                    <div class="directory-list wuxue-list">
                        {{#each wuxues as |wuxue|}}
                        <div class="directory-entry wuxue-group {{#if (eq wuxue.id @root.selectedWuxue.id)}}is-selected{{/if}} {{#if @root.isSorting}}sorting-active{{/if}}"
                            data-action="selectCultivationEntry" data-category="wuxue" data-item-id="{{wuxue.id}}"
                            data-name="{{wuxue.name}}" draggable="{{@root.isSorting}}">
                            {{#if @root.isSorting}}
                            <i class="fas fa-grip-vertical entry-drag-handle" aria-hidden="true"></i>
                            {{else}}
                            <img class="entry-icon wuxue-icon" src="{{wuxue.img}}" alt="" data-action="editItem" data-item-id="{{wuxue.id}}" />
                            {{/if}}
                            <div class="entry-copy">
                                <strong>{{wuxue.name}}</strong>
                                <span>{{wuxue.system.tierLabel}} · {{wuxue.system.moves.length}} 式</span>
                            </div>
                            <span class="entry-chevron"><i class="fas fa-chevron-right" aria-hidden="true"></i></span>
                        </div>
                        {{else}}
                        <div class="directory-empty">{{localize 'XJZL.Cultivation.Workbench.NoWuxue'}}</div>
                        {{/each}}
                    </div>
                </aside>
                <article class="cultivation-inspector wuxue-inspector">
                    {{#if selectedWuxue}}
                    <header class="inspector-book-heading" data-tooltip="{{selectedWuxue.tooltip}}">
                        <img src="{{selectedWuxue.img}}" alt="" data-action="editItem" data-item-id="{{selectedWuxue.id}}" />
                        <div>
                            <span class="inspector-eyebrow">武学秘籍</span>
                            <h2 data-action="editItem" data-item-id="{{selectedWuxue.id}}">{{selectedWuxue.name}}</h2>
                            <span class="book-tier">{{selectedWuxue.system.tierLabel}} · {{selectedWuxue.system.moves.length}} 式</span>
                        </div>
                        <div class="heading-actions">
                            <button type="button" data-action="postItem" data-item-id="{{selectedWuxue.id}}" data-tooltip="{{localize 'XJZL.Cultivation.PostItem'}}"><i class="fas fa-comment"></i></button>
                            <button type="button" class="action-danger-icon" data-action="deleteCultivationItem" data-item-id="{{selectedWuxue.id}}" data-tooltip="{{localize 'XJZL.UI.Delete'}}"><i class="fas fa-trash"></i></button>
                        </div>
                    </header>
                    <div class="moves-grid workbench-moves-grid">
                        {{#each selectedWuxue.system.moves as |move|}}
                        <div class="move-card move-record" data-name="{{move.name}}" data-type="{{move.type}}"
                            data-is-ultimate="{{move.isUltimate}}" data-tooltip="{{move.tooltip}}" draggable="true"
                            data-item-id="{{@root.selectedWuxue.id}}" data-move-id="{{move.id}}">
                            <div class="move-identity">
                                <span class="move-type-signet" aria-hidden="true"><i></i></span>
                                <div class="move-title-stack">
                                    <div class="move-name clickable-link" data-action="editItem" data-item-id="{{@root.selectedWuxue.id}}"
                                        data-tooltip="{{localize 'XJZL.Cultivation.EditWuxue'}}">{{move.name}}</div>
                                    <span class="wuxue-level-label" data-tooltip="Level {{move.computedLevel}}">{{localize (concat "XJZL.Wuxue.Moves.Levels." move.computedLevel)}}</span>
                                    <div class="move-cost-row move-identity-costs">
                                        {{#if move.currentCost.mp}}<span class="move-cost-chip cost-mp" data-tooltip="{{localize 'XJZL.Wuxue.Cost.MP'}}"><i class="fas fa-tint"></i> {{move.currentCost.mp}}</span>{{/if}}
                                        {{#if move.currentCost.rage}}<span class="move-cost-chip cost-rage" data-tooltip="{{localize 'XJZL.Wuxue.Cost.Rage'}}"><i class="fas fa-fire"></i> {{move.currentCost.rage}}</span>{{/if}}
                                        {{#if move.currentCost.hp}}<span class="move-cost-chip cost-hp" data-tooltip="{{localize 'XJZL.Wuxue.Cost.HP'}}"><i class="fas fa-heart"></i> {{move.currentCost.hp}}</span>{{/if}}
                                    </div>
                                </div>
                                <a class="move-pin {{#if move.isPinned}}active{{/if}}" data-action="togglePin"
                                    data-item-id="{{@root.selectedWuxue.id}}" data-move-id="{{move.id}}"
                                    data-tooltip="{{#if move.isPinned}}{{localize 'XJZL.UI.Cultivation.UnpinMove'}}{{else}}{{localize 'XJZL.UI.Cultivation.PinMove'}}{{/if}}">
                                    <i class="{{#if move.isPinned}}fas{{else}}far{{/if}} fa-star"></i>
                                </a>
                            </div>
                            <div class="move-data-band">
                                <div class="move-preview-band">
                                    {{#if move.derived.feint}}<span class="move-dmg-preview" data-tooltip="{{move.derived.feintBreakdownTooltip}}">{{localize "XJZL.Combat.FeintPreview"}}: {{move.derived.feint}}</span>{{/if}}
                                    {{#if move.derived.damage}}<span class="move-dmg-preview" data-tooltip="{{move.derived.breakdownTooltip}}">{{localize "XJZL.Combat.DmgPreview"}}: {{move.derived.damage}}</span>{{/if}}
                                </div>
                                <div class="move-action-row">
                                    {{#if move.actionCost}}{{#unless (eq move.actionCost "无")}}<span class="move-cost-chip cost-badge type-action" data-tooltip="{{move.actionCost}}"><i class="fas fa-clock"></i><span class="{{#if move.formulaFields.actionCost}}xjzl-level-formula-result{{/if}}">{{move.actionCost}}</span></span>{{/unless}}{{/if}}
                                    {{#if move.range}}<span class="move-cost-chip move-range" data-tooltip="{{localize 'XJZL.Wuxue.Moves.Range'}}"><i class="fas fa-ruler-horizontal"></i><span class="{{#if move.formulaFields.range}}xjzl-level-formula-result{{/if}}">{{move.range}}</span></span>{{/if}}
                                </div>
                            </div>
                            <div class="move-action-rail">
                                <div class="move-xp-pill" data-tooltip="{{localize 'XJZL.Cultivation.ProgressHint'}}"><small>修为</small><b>{{move.xpInvested}} / {{move.progress.currentMax}}</b><div class="move-xp-meter" aria-hidden="true"><span style="width:{{move.progress.percent}}%"></span></div></div>
                                <div class="move-toolbar">
                                    <a class="btn-icon-action roll" data-action="rollMove" data-item-id="{{@root.selectedWuxue.id}}" data-move-id="{{move.id}}" data-tooltip="{{localize 'XJZL.Cultivation.RollMove'}}"><i class="fas fa-dice-d20"></i></a>
                                    <a class="btn-icon-action" data-action="postMove" data-item-id="{{@root.selectedWuxue.id}}" data-move-id="{{move.id}}" data-tooltip="{{localize 'XJZL.Cultivation.PostItem'}}"><i class="fas fa-comment-alt"></i></a>
                                    <a class="btn-icon-action" data-action="investMoveXP" data-item-id="{{@root.selectedWuxue.id}}" data-move-id="{{move.id}}" data-tooltip="{{localize 'XJZL.Cultivation.InvestMove'}}"><i class="fas fa-arrow-up"></i></a>
                                    <a class="btn-icon-action" data-action="refundMoveXP" data-item-id="{{@root.selectedWuxue.id}}" data-move-id="{{move.id}}" data-tooltip="{{localize 'XJZL.Cultivation.RefundMove'}}"><i class="fas fa-undo"></i></a>
                                </div>
                            </div>
                        </div>
                        {{else}}
                        <div class="directory-empty">这门武学尚未记载招式。</div>
                        {{/each}}
                    </div>
                    {{else}}
                    <div class="inspector-empty"><i class="fas fa-khanda"></i><h2>尚未修习武学</h2><p>从左侧谱录选择一门武学。</p></div>
                    {{/if}}
                </article>
            </section>

            {{else if (eq cultivationSubTab "arts")}}
            <section class="cultivation-panel" data-cultivation-panel="arts">
                <aside class="cultivation-directory"><div class="directory-heading"><span class="directory-kicker">{{localize 'XJZL.Cultivation.Workbench.DirectoryArts'}}</span><strong>{{artBooks.length}} 卷</strong></div><div class="directory-list">
                    {{#each artBooks as |book|}}<div class="directory-entry art-book-card {{#if book.derived.isCompleted}}is-complete{{/if}} {{#if (eq book.id @root.selectedArtBook.id)}}is-selected{{/if}}" data-action="selectCultivationEntry" data-category="arts" data-item-id="{{book.id}}" data-tooltip="{{book.derived.tooltip}}" draggable="true"><img class="entry-icon book-icon" src="{{book.img}}" alt="" data-action="editItem" data-item-id="{{book.id}}" /><div class="entry-copy"><strong class="book-title">{{book.name}}</strong><span>{{book.system.xpInvested}} / {{book.derived.maxXP}}</span></div><span class="entry-status">{{book.system.chapters.length}} 章</span></div>{{else}}<div class="directory-empty">{{localize 'XJZL.Cultivation.Workbench.NoArtBook'}}</div>{{/each}}
                </div></aside>
                <article class="cultivation-inspector">
                    {{#if selectedArtBook}}<div class="inspector-book-heading"><img src="{{selectedArtBook.img}}" alt="" data-action="editItem" data-item-id="{{selectedArtBook.id}}" /><div><span class="inspector-eyebrow">技艺典籍</span><h2 data-action="editItem" data-item-id="{{selectedArtBook.id}}">{{selectedArtBook.name}}</h2><span class="book-tier">{{selectedArtBook.system.chapters.length}} 章 · {{#if selectedArtBook.derived.isCompleted}}已通读{{else}}研读中{{/if}}</span></div></div><div class="cultivation-progress-block"><div class="progress-caption"><span>研读进度</span><b>{{selectedArtBook.system.xpInvested}} / {{selectedArtBook.derived.maxXP}}</b></div><div class="cultivation-progress-track"><span style="width:{{selectedArtBook.derived.percent}}%"></span></div></div><div class="chapter-list">{{#each selectedArtBook.system.chapters as |chapter index|}}<div class="chapter-row {{#if chapter.progress.isCompleted}}is-complete{{/if}}"><span class="chapter-index">{{index}}</span><div class="chapter-copy"><strong>{{chapter.name}}</strong><div class="chapter-description">{{{chapter.description}}}</div></div><span>{{#if chapter.progress.isCompleted}}已读{{else}}{{chapter.cost}} 修为{{/if}}</span></div>{{/each}}</div><div class="inspector-actions"><button type="button" class="action-primary" data-action="investArtXP" data-item-id="{{selectedArtBook.id}}"><i class="fas fa-book-reader"></i> 研读</button><button type="button" class="action-secondary" data-action="refundArtXP" data-item-id="{{selectedArtBook.id}}"><i class="fas fa-undo"></i> 返还</button><button type="button" class="action-secondary" data-action="editItem" data-item-id="{{selectedArtBook.id}}"><i class="fas fa-pen"></i> 编辑</button><button type="button" class="action-secondary" data-action="postItem" data-item-id="{{selectedArtBook.id}}"><i class="fas fa-comment"></i> 发送</button><button type="button" class="action-danger" data-action="deleteCultivationItem" data-item-id="{{selectedArtBook.id}}"><i class="fas fa-trash"></i> 删除</button></div>{{else}}<div class="inspector-empty"><i class="fas fa-book-open"></i><h2>尚未研读典籍</h2><p>从左侧书目选择一本技艺书。</p></div>{{/if}}
                </article>
            </section>

            {{else}}
            <section class="cultivation-panel" data-cultivation-panel="traits">
                <aside class="cultivation-directory"><div class="directory-heading"><span class="directory-kicker">{{localize 'XJZL.Cultivation.Workbench.DirectoryTraits'}}</span><strong>{{traits.length}} 枚</strong></div><div class="directory-list">
                    {{#each traits as |trait|}}<div class="directory-entry trait-card {{#if (eq trait.id @root.selectedTrait.id)}}is-selected{{/if}}" data-action="selectCultivationEntry" data-category="traits" data-item-id="{{trait.id}}" data-tooltip="{{trait.derived.tooltip}}" draggable="true"><img class="entry-icon trait-icon" src="{{trait.img}}" alt="" data-action="editItem" data-item-id="{{trait.id}}" /><div class="entry-copy"><strong class="trait-title">{{trait.name}}</strong><span>{{trait.system.type}}</span></div></div>{{else}}<div class="directory-empty">{{localize 'XJZL.Cultivation.Workbench.NoTrait'}}</div>{{/each}}
                </div></aside>
                <article class="cultivation-inspector">{{#if selectedTrait}}<div class="inspector-book-heading"><img src="{{selectedTrait.img}}" alt="" data-action="editItem" data-item-id="{{selectedTrait.id}}" /><div><span class="inspector-eyebrow">身上特性</span><h2 data-action="editItem" data-item-id="{{selectedTrait.id}}">{{selectedTrait.name}}</h2><span class="book-tier">{{selectedTrait.system.type}}</span></div></div><div class="inspector-section"><span class="section-kicker">特性说明</span><div class="inspector-richtext">{{{selectedTrait.system.description}}}</div></div><div class="inspector-section"><span class="section-kicker">自动化说明</span><div class="inspector-richtext">{{selectedTrait.system.automationNote}}</div></div><div class="inspector-actions"><button type="button" class="action-secondary" data-action="editItem" data-item-id="{{selectedTrait.id}}"><i class="fas fa-pen"></i> 编辑</button><button type="button" class="action-secondary" data-action="postItem" data-item-id="{{selectedTrait.id}}"><i class="fas fa-comment"></i> 发送</button><button type="button" class="action-danger" data-action="deleteItem" data-item-id="{{selectedTrait.id}}"><i class="fas fa-trash"></i> 删除</button></div>{{else}}<div class="inspector-empty"><i class="fas fa-seal"></i><h2>暂无身上特性</h2><p>获得特性后会在这里显示。</p></div>{{/if}}</article>
            </section>
            {{/if}}
        </main>
    </div>
</section>
