<div class="xjzl-chat-card request-card">
    {{!-- 头部：根据状态动态计算边框颜色 --}}
    <header class="card-header"
        style="border-left: 4px solid {{#if flags.state.isCompleted}}{{#if (eq flags.state.winner 'attacker')}}#27ae60{{else}}#c0392b{{/if}}{{else}}#78909c{{/if}}; display: block;">

        {{!-- 标题独占一行：招式名可能很长，不与头像、名字竞争同一行宽度 --}}
        <h3 title="{{label}}"
            style="color: {{#if flags.state.isCompleted}}{{#if (eq flags.state.winner 'attacker')}}#27ae60{{else}}#c0392b{{/if}}{{else}}#78909c{{/if}}; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            {{label}}</h3>

        {{!-- 参与者一行：发起者 VS 对抗者。AOE 会对每个目标各开一张对抗卡，右侧必须能看出对抗对象是谁 --}}
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 5px; margin-top: 4px;">
            {{!-- 左：发起者 --}}
            <div style="display: flex; align-items: center; gap: 5px; min-width: 0;">
                <img src="{{attackerImg}}" title="{{attackerName}}" />
                <div title="{{attackerName}}"
                    style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.85em; color: #555;">
                    {{attackerName}}</div>
            </div>

            {{!-- 中：VS 或 结果 --}}
            <div style="font-weight: bold; font-size: 1.2em; color: #999; flex-shrink: 0;">
                {{#if flags.state.isCompleted}}
                {{#if (eq flags.state.winner "attacker")}}
                <span style="color: #27ae60;">{{localize "XJZL.UI.Win"}}</span>
                {{else}}
                <span style="color: #c0392b;">{{localize "XJZL.UI.Lose"}}</span>
                {{/if}}
                {{else}}
                VS
                {{/if}}
            </div>

            {{!-- 右：对抗者（镜像布局，头像靠最右） --}}
            <div style="display: flex; align-items: center; gap: 5px; min-width: 0;">
                <div title="{{defenderName}}"
                    style="min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.85em; color: #555; text-align: right;">
                    {{defenderName}}</div>
                <img src="{{defenderImg}}" title="{{defenderName}}" />
            </div>
        </div>
    </header>

    <div class="card-content-wrapper">
        {{!-- 结果描述文本：只在结束后显示 --}}
        {{#if flags.state.isCompleted}}
        <div class="card-description"
            style="margin-bottom: 5px; padding: 5px; background: rgba(0,0,0,0.03); border-radius: 4px;">
            {{#if (eq flags.state.winner "attacker")}}
            <i class="fas fa-check-circle" style="color: #27ae60;"></i> {{flags.config.outcome.win.text}}
            {{else}}
            <i class="fas fa-times-circle" style="color: #c0392b;"></i> {{flags.config.outcome.lose.text}}
            {{/if}}
        </div>
        {{else}}
        {{!-- 进行中提示 --}}
        <div class="card-description" style="text-align: center; color: #666; font-style: italic;">
            {{localize "XJZL.UI.OngoingContest"}}
        </div>
        {{/if}}

        {{!-- 核心区域：骰子与按钮 --}}
        <div class="card-stats" style="display: flex; justify-content: space-around; gap: 5px;">

            {{!-- 左侧 Block：发起者 --}}
            <div class="stat-block" style="flex: 1; text-align: center;">
                <div class="stat-label">
                    {{attLabel}}
                    {{#if flags.config.attBonus}}
                    <span style="font-size: 0.85em; color: #d35400;">
                        ({{#if (gt flags.config.attBonus 0)}}+{{/if}}{{flags.config.attBonus}})
                    </span>
                    {{/if}}
                </div>

                {{#if flags.state.attRoll}}
                {{!-- 已投掷 --}}
                <div class="stat-value" style="color: #27ae60;">{{flags.state.attRoll.total}}</div>
                <div style="font-size: 0.7em; color: #888;">{{flags.state.attRoll.formula}}</div>
                {{else}}
                {{!-- 未投掷按钮 --}}
                <div style="padding: 5px 0;">
                    <button data-action="rollContest" data-role="attacker" class="btn-heal"
                        style="width: 100%; font-size: 0.8em;">
                        <i class="fas fa-dice"></i> {{localize "XJZL.UI.Roll"}}
                    </button>
                </div>
                {{/if}}
            </div>

            {{!-- 分割线 --}}
            <div style="width: 1px; background: #eee;"></div>

            {{!-- 右侧 Block：对抗者 --}}
            <div class="stat-block" style="flex: 1; text-align: center;">
                <div class="stat-label">
                    {{defLabel}}
                    {{#if flags.config.defBonus}}
                    <span style="font-size: 0.85em; color: #d35400;">
                        ({{#if (gt flags.config.defBonus 0)}}+{{/if}}{{flags.config.defBonus}})
                    </span>
                    {{/if}}
                </div>

                {{#if flags.state.defRoll}}
                {{!-- 已投掷 --}}
                <div class="stat-value" style="color: #c0392b;">{{flags.state.defRoll.total}}</div>
                <div style="font-size: 0.7em; color: #888;">{{flags.state.defRoll.formula}}</div>
                {{else}}
                {{!-- 未投掷按钮 --}}
                <div style="padding: 5px 0;">
                    <button data-action="rollContest" data-role="defender" class="btn-heal"
                        style="width: 100%; font-size: 0.8em;">
                        <i class="fas fa-shield-alt"></i> {{localize "XJZL.UI.Resist"}}
                    </button>
                </div>
                {{/if}}
            </div>
        </div>

        {{!-- 只有当有执行日志，且状态已完成时才显示 --}}
        {{#if (and flags.state.isCompleted flags.state.executedLog.length)}}
        <div class="card-automation-log" style="margin-top: 8px; border-top: 1px dashed #ddd; padding-top: 5px;">
            <div style="font-size: 0.85em; font-weight: bold; color: #666; margin-bottom: 3px;">
                <i class="fas fa-cogs"></i> {{localize "XJZL.UI.AutoResolve"}}
            </div>
            <ul style="margin: 0; padding-left: 20px; font-size: 0.85em; color: #444;">
                {{#each flags.state.executedLog}}
                <li style="margin-bottom: 2px;">{{this}}</li>
                {{/each}}
            </ul>
        </div>
        {{/if}}

        <!-- 功能提示 -->
        <div style="margin-top: 6px; font-size: 0.75em; color: #888; text-align: center; opacity: 0.85;">
            {{{localize "XJZL.UI.Chat.Tips.ShiftFail"}}}
        </div>

    </div>
</div>
