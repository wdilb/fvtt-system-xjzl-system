<div class="xjzl-chat-card" data-item-id="{{item.id}}">
    <header class="card-header" style="border-left: 4px solid var(--c-cinnabar);">
        <img src="{{item.img}}" title="{{item.name}}" />
        <h3 style="color: var(--c-cinnabar);">{{item.name}}</h3>
    </header>

    <div class="card-content-wrapper">
        {{#if detailsLocked}}
        <details class="card-details xjzl-protected-details is-locked">
            <summary title="{{localize 'XJZL.UI.Chat.ProtectedDetails.LockedHint'}}">
                <i class="fas fa-lock" data-protected-details-icon></i>
                <span data-protected-details-label>{{localize "XJZL.UI.Chat.ProtectedDetails.Locked"}}</span>
            </summary>
            <div class="xjzl-protected-details-body">
                <div class="card-description">{{{item.system.description}}}</div>

                {{!--自动化说明 --}}
                {{#if automationNote}}
                <div style="
                    background: rgba(0, 0, 0, 0.03);
                    padding: 6px 8px;
                    border: 1px dashed #bbb;
                    border-radius: 4px;
                    font-size: 0.9em;
                    color: #444;
                    margin-top: 5px;">
                    <strong>{{localize "XJZL.AutomationNote"}}：</strong> {{automationNote}}
                </div>
                {{/if}}
            </div>
        </details>
        {{else}}
        <div class="card-description">{{{item.system.description}}}</div>
        {{/if}}

        {{#if tags.length}}
        <div class="card-tags">
            {{#each tags as |tag|}}<span>{{tag}}</span>{{/each}}
        </div>
        {{/if}}

        {{#if resultText}}
        <div
            style="background: rgba(0,0,0,0.05); padding: 8px; border-radius: 4px; border-left: 3px solid var(--xjzl-accent);">
            <b>{{localize "XJZL.UI.Chat.ItemCard.Effect"}}：</b> {{resultText}}
        </div>
        {{/if}}

        {{!-- 未锁定卡片保持原有自动化说明位置；锁定卡片已将其收入详情区。 --}}
        {{#unless detailsLocked}}
        {{#if automationNote}}
        <div style="
            background: rgba(0, 0, 0, 0.03); 
            padding: 6px 8px; 
            border: 1px dashed #bbb; 
            border-radius: 4px; 
            font-size: 0.9em; 
            color: #444; 
            margin-top: 5px;">
            <strong>{{localize "XJZL.AutomationNote"}}：</strong> {{automationNote}}
        </div>
        {{/if}}
        {{/unless}}

        {{#if scriptOutput}}
        <div style="margin-top: 5px; font-style: italic; color: #555;">{{scriptOutput}}</div>
        {{/if}}
    </div>
</div>
