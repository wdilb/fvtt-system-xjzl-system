<article class="xjzl-encounter-chat {{#if isDescription}}is-description{{/if}} {{#if isDamage}}is-damage{{/if}}">
  <header class="encounter-chat-header">
    <div class="encounter-chat-sigil" aria-hidden="true">遇</div>
    <div class="encounter-chat-heading">
      <small>{{sourceName}}</small>
      <h3>{{title}}</h3>
    </div>
    {{#if manual}}<span class="encounter-chat-manual"><i class="fas fa-hand"></i>{{localize "XJZL.Encounter.ManualExecution"}}</span>{{/if}}
  </header>

  <div class="encounter-chat-protocol">
    <span><i class="fas fa-clock"></i>{{triggerLabel}}</span>
    <span class="automation-badge"><i class="fas fa-bolt"></i>{{automationLabel}}</span>
    {{#if isDamage}}<span class="damage-type-badge"><i class="fas fa-burst"></i>{{damageTypeLabel}}</span>{{/if}}
    {{#if hasAmount}}<strong>{{#if isDamage}}−{{/if}}{{amount}}</strong>{{/if}}
  </div>

  <div class="encounter-chat-rule">{{{description}}}</div>

  {{#unless noTargets}}
  <div class="encounter-chat-targets">
    <span>{{localize "XJZL.Encounter.Targets"}}</span>
    <div>{{#each targets as |target|}}<b><i class="fas fa-crosshairs"></i>{{target.name}}</b>{{/each}}</div>
  </div>
  {{/unless}}

  {{#if hasResults}}
  <footer class="encounter-chat-results">
    <span>{{localize "XJZL.Encounter.SettlementResult"}}</span>
    {{#each results as |result|}}<b>{{result.text}}</b>{{/each}}
  </footer>
  {{/if}}
</article>
