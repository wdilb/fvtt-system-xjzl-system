<div class="xjzl-chat-card heal-card">
    <header class="card-header" style="border-left: 4px solid {{color}};">
        <img src="{{img}}" title="{{name}}" />
        <div style="flex:1;">
            <h3 style="color: #2c3e50;">{{name}}</h3>
            <div style="font-size:0.85em; color:#7f8c8d;">
                <i class="fas fa-hand-holding-medical"></i>
                {{localize "XJZL.UI.Chat.HealCard.ResourceRecovery" type=typeLabel}}
            </div>
        </div>
    </header>

    <div class="card-content-wrapper">
        {{#if noEffect}}
        <div style="text-align:center; color:#7f8c8d; font-weight:bold; padding:12px 8px;">
            <i class="fas {{#if isBlocked}}fa-ban{{else}}fa-circle-check{{/if}}"></i>
            {{#if isBlocked}}
            {{localize "XJZL.UI.Chat.HealCard.Blocked"}}
            {{else}}
            {{localize "XJZL.UI.Chat.HealCard.NoEffect"}}
            {{/if}}
        </div>
        {{else}}
        <div style="text-align:center; padding:10px 0;">
            <div style="font-size:2.2em; font-weight:bold; color:{{color}}; font-family:serif; line-height:1.2;">
                +{{amount}}
                <span style="font-size:0.5em; vertical-align:middle; color:#555;">{{typeLabel}}</span>
            </div>
            <div style="font-size:0.9em; color:#555; margin-top:8px; border-top:1px dashed #ccc; padding-top:5px;">
                {{localize "XJZL.UI.Chat.HealCard.Current"}}: <b>{{newVal}}</b>
                {{#if maxVal}}<span style="color:#999;"> / {{maxVal}}</span>{{/if}}
            </div>
            {{#if (gt overflow 0)}}
            <div style="font-size:0.78em; color:#999; margin-top:4px;">
                {{localize "XJZL.UI.Chat.HealCard.Overflow" amount=overflow}}
            </div>
            {{/if}}
        </div>
        {{/if}}

        <div class="card-buttons">
            {{#if canUndo}}
            {{#unless isUndone}}
            <button data-action="undoHealing" class="btn-grey">
                <i class="fas fa-undo"></i> {{localize "XJZL.UI.Chat.HealCard.Undo"}}
            </button>
            {{else}}
            <div style="text-align:center; color:#999; font-size:0.85em; padding:5px;">
                <i class="fas fa-history"></i> {{localize "XJZL.UI.Chat.HealCard.Undone"}}
            </div>
            {{/unless}}
            {{/if}}
        </div>
    </div>
</div>
